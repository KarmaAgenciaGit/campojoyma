+def idempotency_payload_hash(
+    payload: FacturaRecibidaCreateRequest,
+    *,
+    cabecera: dict[str, Any] | None = None,
+    ctb_rows: list[dict[str, Any]] | None = None,
+) -> str:
+    canonical_header = (
+        canonicalize_v3_header(payload.cabecera)
+        if cabecera is None
+        else dict(cabecera)
+    )
+    canonical_ctb = (
+        canonicalize_v3_ctb(payload.ctb)
+        if ctb_rows is None
+        else [dict(row) for row in ctb_rows]
+    )
+    canonical_payload = {
+        "cabecera": canonical_header,
+        "ctb": canonical_ctb,
+        "punteos": canonicalize_v3_punteos(payload.punteos),
+        "accounting_mode": payload.accounting_mode,
+    }
+    serialized = json.dumps(
+        {
+            "operation": "POST /facturasrecibidas",
+            "contract_version": WRITE_CONTRACT_VERSION,
+            "payload": canonical_payload,
+        },
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+

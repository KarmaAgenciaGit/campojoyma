+def _strict_integer_error(
+    *,
+    field: str,
+    value: Any,
+    minimum: int,
+    maximum: int,
+) -> dict[str, str] | None:
+    valid, parsed = _finite_decimal_readback(value)
+    if (
+        not valid
+        or parsed is None
+        or parsed != parsed.to_integral_value()
+        or parsed < minimum
+        or parsed > maximum
+    ):
+        return {
+            "field": field,
+            "error": f"must be an integer between {minimum} and {maximum}",
+        }
+    return None
+
+
+def _strict_decimal_error(
+    *,
+    field: str,
+    value: Any,
+    maximum: Decimal,
+    minimum: Decimal | None = None,
+) -> dict[str, str] | None:
+    valid, parsed = _finite_decimal_readback(value)
+    if not valid or parsed is None:
+        return {"field": field, "error": "must be a finite decimal"}
+    lower_bound = -maximum if minimum is None else minimum
+    if parsed < lower_bound or parsed > maximum:
+        return {
+            "field": field,
+            "error": f"must be between {lower_bound} and {maximum}",
+        }
+    exponent = parsed.as_tuple().exponent
+    if exponent < -2:
+        return {"field": field, "error": "must have at most two decimal places"}
+    return None
+
+
+def _strict_iso_date_error(field: str, value: Any) -> dict[str, str] | None:
+    if not isinstance(value, str) or not value:
+        return {"field": field, "error": "must be an ISO date (YYYY-MM-DD)"}
+    try:
+        parsed = date.fromisoformat(value)
+    except ValueError:
+        return {"field": field, "error": "must be an ISO date (YYYY-MM-DD)"}
+    if parsed.isoformat() != value:
+        return {"field": field, "error": "must be an ISO date (YYYY-MM-DD)"}
+    return None

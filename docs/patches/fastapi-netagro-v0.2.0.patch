+@app.get(
+    "/facturasrecibidas/{factura_id}/asiento",
+    response_model=FacturaRecibidaAsientoResponse,
+)
+def get_factura_recibida_asiento(
+    factura_id: int,
+    schema: Annotated[str | None, schema_query()] = None,
+    target_id: TargetIdQuery = None,
+    dataset_epoch: DatasetEpochQuery = None,
+    x_netagro_api_key: Annotated[
+        str | None,
+        Header(alias=NETAGRO_API_KEY_HEADER),
+    ] = None,
+) -> dict[str, Any]:
+    selected_name, selected, fetch_one_fn, fetch_all_fn = (
+        resolve_invoice_read_source(
+            schema=schema,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+            api_key=x_netagro_api_key,
+        )
+    )
+    row = fetch_one_fn(
+        f"""
+        SELECT
+            FRR_id,
+            FRR_numero,
+            FRR_Idempresa,
+            FRR_Contabilizar,
+            FRR_IdAsientoNet,
+            FRR_fechactb,
+            FRR_Concepto,
+            FRR_base1,
+            FRR_iva1,
+            FRR_cuota1,
+            FRR_base2,
+            FRR_iva2,
+            FRR_cuota2,
+            FRR_base3,
+            FRR_iva3,
+            FRR_cuota3,
+            FRR_base4,
+            FRR_iva4,
+            FRR_cuota4,
+            FRR_base5,
+            FRR_iva5,
+            FRR_cuota5,
+            FRR_baseret,
+            FRR_ret,
+            FRR_cuotaret,
+            FRR_ClaveIRPF,
+            FRR_totalfac,
+            FRR_CuotaNoDeducible
+        FROM {selected}.facturasrecibidas
+        WHERE FRR_id = %(factura_id)s
+        """,
+        {"factura_id": factura_id},
+    )
+    header = ensure_found(row, "factura recibida")
+    accounting, warnings = accounting_state_from_header(header)
+    account_schema_name = accounting_schema_for_company(header.get("FRR_Idempresa"))
+    runtime = runtime_identity()
+    source: dict[str, Any] = {
+        "schema": selected_name,
+        "account_schema": account_schema_name,
+        "mechanism": "ledger_readback",
+        "creation_mechanism": ACCOUNTING_MECHANISM,
+        "ledger_available": account_schema_name is not None,
+        "available_accounting_tables": list(ACCOUNTING_LEDGER_TABLES),
+        "missing_capability": (
+            None
+            if runtime["accounting_ready_for_commit"]
+            else "Escritura contable de TEST desactivada"
+        ),
+    }
+    technical_id = positive_int(header.get("FRR_IdAsientoNet"))
+    if technical_id is None:
+        return {
+            "factura_id": factura_id,
+            "accounting": accounting,
+            "entries": [],
+            "source": source,
+            "warnings": warnings,
+        }
+    if account_schema_name is None:
+        warnings.append(
+            "No hay un esquema contable allowlistado para la empresa de la factura."
+        )
+        source["ledger_available"] = False
+        return {
+            "factura_id": factura_id,
+            "accounting": accounting,
+            "entries": [],
+            "source": source,
+            "warnings": warnings,
+        }
+
+    account_schema = quote_any_identifier(
+        account_schema_name,
+        DB_ALLOWED_ACCOUNT_SCHEMAS,
+        "account schema",
+    )
+    journal = fetch_one_fn(
+        f"""
+        SELECT
+            IdAsiento,
+            Ejercicio,
+            Tipo,
+            Asiento,
+            Fecha,
+            Diario,
+            Generado,
+            Observaciones,
+            IdCentro,
+            cdorigen,
+            idorigen,
+            Nuorigen,
+            FechaOperacion,
+            IdAplicacion
+        FROM {account_schema}.asientos
+        WHERE IdAsiento = %(technical_id)s
+        """,
+        {"technical_id": technical_id},
+    )
+    if journal is None:
+        warnings.append(
+            f"El diario {account_schema_name} no contiene el asiento tecnico "
+            f"{technical_id}."
+        )
+        return {
+            "factura_id": factura_id,
+            "accounting": accounting,
+            "entries": [],
+            "source": source,
+            "warnings": warnings,
+        }
+
+    journal_technical_id = _strict_positive_integer(journal.get("IdAsiento"))
+    journal_origin_id = _strict_positive_integer(journal.get("idorigen"))
+    journal_origin_code = str(journal.get("cdorigen") or "").strip().upper()
+    if (
+        journal_technical_id != technical_id
+        or journal_origin_code != "FR"
+        or journal_origin_id != factura_id
+    ):
+        accounting.update(
+            {
+                "created": False,
+                "status": "error",
+                "visible_number": (
+                    str(journal["Asiento"]) if journal.get("Asiento") is not None else None
+                ),
+                "date": journal.get("Fecha") or accounting.get("date"),
+            }
+        )
+        warnings.append(
+            "El asiento tecnico existe, pero su origen no coincide exactamente "
+            "con la factura recibida solicitada."
+        )
+        source["journal"] = journal
+        return {
+            "factura_id": factura_id,
+            "accounting": accounting,
+            "entries": [],
+            "source": source,
+            "warnings": warnings,
+        }
+
+    entries = fetch_all_fn(
+        f"""
+        SELECT
+            l.IdApunte AS id,
+            l.NumeroCuenta AS account,
+            c.Nombre AS account_name,
+            l.Concepto AS description,
+            l.Debe AS debit,
+            l.Haber AS credit,
+            l.IdActividad AS activity_id,
+            l.IdSeccion AS section_id,
+            l.IdDepartamento AS department_id,
+            l.IdSubdepartamento AS subdepartment_id,
+            l.Documento AS document,
+            l.Fecha AS date,
+            l.FechaOperacion AS operation_date,
+            l.SRPC AS srpc,
+            l.Punteo AS reconciliation_code,
+            v.IdRegistro AS tax_record_id,
+            v.NIF AS tax_nif,
+            v.Nombre AS tax_name,
+            v.Base1 AS tax_base_1,
+            v.Iva1 AS tax_rate_1,
+            v.Cuota1 AS tax_amount_1,
+            v.Base2 AS tax_base_2,
+            v.Iva2 AS tax_rate_2,
+            v.Cuota2 AS tax_amount_2,
+            v.Base3 AS tax_base_3,
+            v.Iva3 AS tax_rate_3,
+            v.Cuota3 AS tax_amount_3,
+            v.Base4 AS tax_base_4,
+            v.Iva4 AS tax_rate_4,
+            v.Cuota4 AS tax_amount_4,
+            v.Base5 AS tax_base_5,
+            v.Iva5 AS tax_rate_5,
+            v.Cuota5 AS tax_amount_5,
+            v.BaseRetencion AS tax_retention_base,
+            v.TipoRetencion AS tax_retention_rate,
+            v.CuotaRetencion AS tax_retention_amount,
+            v.ClaveRetencion AS tax_retention_key,
+            v.TotalFactura AS tax_total,
+            v.CuotaNoDeducible AS tax_non_deductible,
+            v.idTipoIvaSoportado AS supported_vat_type_id
+        FROM {account_schema}.asientolineas l
+        LEFT JOIN {account_schema}.cuentas c
+          ON c.NumeroCuenta = l.NumeroCuenta
+        LEFT JOIN {account_schema}.ivasoportado v
+          ON v.IdRegistro = l.IdApunte
+        WHERE l.IdAsiento = %(technical_id)s
+        ORDER BY l.IdApunte
+        """,
+        {"technical_id": technical_id},
+    )
+    raw_entries = entries
+    tax_rows = [
+        entry
+        for entry in raw_entries
+        if _strict_positive_integer(entry.get("tax_record_id")) is not None
+    ]
+    # A LEFT JOIN can repeat an accounting line when the fiscal table contains
+    # duplicate records. Preserve a single ledger line for totals/response, but
+    # retain the raw fiscal multiplicity so duplicates fail the readback.
+    entries_by_id: dict[Any, dict[str, Any]] = {}
+    for entry in raw_entries:
+        entries_by_id.setdefault(entry.get("id"), entry)
+    entries = list(entries_by_id.values())
+    for position, entry in enumerate(entries, start=1):
+        entry["position"] = position
+
+    valid_entry_amounts = True
+    debit_values: list[Decimal] = []
+    credit_values: list[Decimal] = []
+    for entry in entries:
+        debit_valid, debit = _finite_decimal_readback(entry.get("debit"))
+        credit_valid, credit = _finite_decimal_readback(entry.get("credit"))
+        if not debit_valid or not credit_valid:
+            valid_entry_amounts = False
+        debit_values.append(debit or Decimal("0"))
+        credit_values.append(credit or Decimal("0"))
+    total_debit = sum(debit_values, Decimal("0"))
+    total_credit = sum(credit_values, Decimal("0"))
+    balanced = (
+        bool(entries)
+        and valid_entry_amounts
+        and total_debit == total_credit
+    )
+    visible_number = _strict_positive_integer(journal.get("Asiento"))
+    fiscal_coherent, fiscal_readback = _verify_fiscal_readback(header, tax_rows)
+    created = (
+        visible_number is not None
+        and bool(entries)
+        and balanced
+        and fiscal_coherent
+    )
+    accounting.update(
+        {
+            "created": created,
+            "status": "created" if created else "error",
+            "technical_id": technical_id,
+            "visible_number": str(visible_number) if visible_number is not None else None,
+            "date": journal.get("Fecha") or accounting.get("date"),
+            "balanced": balanced,
+            "total_debit": total_debit,
+            "total_credit": total_credit,
+        }
+    )
+    warnings = []
+    if visible_number is None:
+        warnings.append(
+            "El asiento tecnico no tiene un numero visible positivo en Netagro."
+        )
+    if not entries:
+        warnings.append("El asiento existe, pero no contiene apuntes.")
+    elif not balanced:
+        warnings.append(
+            "El asiento existe, pero sus apuntes no cuadran entre Debe y Haber."
+        )
+    if not fiscal_coherent:
+        warnings.append(
+            "El detalle fiscal del asiento no coincide exactamente con la factura recibida."
+        )
+    source["journal"] = journal
+    source["fiscal_readback"] = fiscal_readback
+    return {
+        "factura_id": factura_id,
+        "accounting": accounting,
+        "entries": entries,
+        "source": source,
+        "warnings": warnings,
+    }
+

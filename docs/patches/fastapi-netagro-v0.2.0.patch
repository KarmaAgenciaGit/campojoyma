+def get_regimen_iva_profiles(
+    regimen_id: Annotated[int, Path(gt=0)],
+    schema: Annotated[str | None, schema_query()] = None,
+    proveedor_id: Annotated[int | None, Query(gt=0)] = None,
+    tipo_factura: Annotated[str | None, Query(min_length=1, max_length=16)] = None,
+) -> RegimenIvaProfilesResponse:
+    selected = quote_identifier(resolve_schema(schema))
+    normalized_type = tipo_factura.strip() if tipo_factura is not None else None
+    if not normalized_type:
+        normalized_type = None
+    if proveedor_id is not None and normalized_type is None:
+        raise HTTPException(
+            status_code=422,
+            detail=(
+                "tipo_factura is required with proveedor_id because Netagro "
+                "reuses provider ids across agricultores and acreedores"
+            ),
+        )
+
+    clauses = [
+        "f.FRR_idregimen = %(regimen_id)s",
+        "f.FRR_idregimen > 0",
+    ]
+    params: dict[str, Any] = {"regimen_id": regimen_id}
+    if proveedor_id is not None:
+        clauses.append("f.FRR_idproveedor = %(proveedor_id)s")
+        params["proveedor_id"] = proveedor_id
+    if normalized_type is not None:
+        clauses.append("f.FRR_tipofactura = %(tipo_factura)s")
+        params["tipo_factura"] = normalized_type
+
+    rows = fetch_all(
+        f"""
+        SELECT
+            f.FRR_iva1 AS iva1,
+            f.FRR_iva2 AS iva2,
+            f.FRR_iva3 AS iva3,
+            f.FRR_iva4 AS iva4,
+            f.FRR_iva5 AS iva5,
+            COUNT(*) AS usos,
+            SUM(
+                CASE
+                    WHEN COALESCE(f.FRR_base1, 0) <> 0
+                      OR COALESCE(f.FRR_cuota1, 0) <> 0
+                    THEN 1 ELSE 0
+                END
+            ) AS usos_activos1,
+            SUM(
+                CASE
+                    WHEN COALESCE(f.FRR_base2, 0) <> 0
+                      OR COALESCE(f.FRR_cuota2, 0) <> 0
+                    THEN 1 ELSE 0
+                END
+            ) AS usos_activos2,
+            SUM(
+                CASE
+                    WHEN COALESCE(f.FRR_base3, 0) <> 0
+                      OR COALESCE(f.FRR_cuota3, 0) <> 0
+                    THEN 1 ELSE 0
+                END
+            ) AS usos_activos3,
+            SUM(
+                CASE
+                    WHEN COALESCE(f.FRR_base4, 0) <> 0
+                      OR COALESCE(f.FRR_cuota4, 0) <> 0
+                    THEN 1 ELSE 0
+                END
+            ) AS usos_activos4,
+            SUM(
+                CASE
+                    WHEN COALESCE(f.FRR_base5, 0) <> 0
+                      OR COALESCE(f.FRR_cuota5, 0) <> 0
+                    THEN 1 ELSE 0
+                END
+            ) AS usos_activos5
+        FROM {selected}.facturasrecibidas f
+        WHERE {" AND ".join(clauses)}
+        GROUP BY
+            f.FRR_iva1,
+            f.FRR_iva2,
+            f.FRR_iva3,
+            f.FRR_iva4,
+            f.FRR_iva5
+        ORDER BY
+            usos DESC,
+            f.FRR_iva1,
+            f.FRR_iva2,
+            f.FRR_iva3,
+            f.FRR_iva4,
+            f.FRR_iva5
+        """,
+        params,
+    )
+    return build_regimen_iva_profiles(
+        regimen_id,
+        rows,
+        proveedor_id=proveedor_id,
+        tipo_factura=normalized_type,
+    )

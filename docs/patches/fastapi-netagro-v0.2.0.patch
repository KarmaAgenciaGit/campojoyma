+@app.get(
+    "/facturasrecibidas/cuentas-iva-historicas",
+    response_model=CuentasIvaHistoricasResponse,
+)
+def get_factura_recibida_cuentas_iva_historicas(
+    empresa_id: Annotated[int, Query(gt=0)],
+    ejercicio: Annotated[int, Query(gt=0)],
+    regimen_id: Annotated[int, Query(gt=0)],
+    tipo_factura: Annotated[str, Query(min_length=1, max_length=2)],
+    porcentaje: Annotated[Decimal, Query(ge=0, le=100)],
+    proveedor_id: Annotated[int | None, Query(gt=0)] = None,
+    schema: Annotated[str | None, schema_query()] = None,
+) -> CuentasIvaHistoricasResponse:
+    """Resolve a VAT account from exact, real and read-only journal history.
+
+    Each historical invoice must link to its real ``FR`` journal, contain one
+    active VAT slot and have exactly one ``472`` line whose net amount matches
+    that slot's quota. No account number is inferred from the tax rate alone.
+    """
+
+    normalized_type = normalize_factura_recibida_type(tipo_factura)
+    if normalized_type is None:
+        raise erp_http_error(
+            422,
+            code="invalid_invoice_type",
+            category="validation",
+            user_message="El tipo de factura no puede estar vacio.",
+        )
+
+    selected = quote_identifier(resolve_schema(schema))
+    account_schema_name = accounting_schema_for_company(empresa_id)
+    if account_schema_name is None:
+        raise erp_http_error(
+            422,
+            code="invalid_account_schema",
+            category="validation",
+            user_message="La empresa no tiene un esquema contable autorizado.",
+            technical_details={"empresa_id": empresa_id},
+        )
+    account_schema = quote_any_identifier(
+        account_schema_name,
+        DB_ALLOWED_ACCOUNT_SCHEMAS,
+        "account schema",
+    )
+    params: dict[str, Any] = {
+        "empresa_id": empresa_id,
+        "ejercicio": ejercicio,
+        "regimen_id": regimen_id,
+        "tipo_factura": normalized_type,
+        "porcentaje": porcentaje,
+        "cuota_activa_minima": VAT_ACCOUNT_HISTORY_ACTIVE_QUOTA_THRESHOLD,
+    }
+    if proveedor_id is not None:
+        params["proveedor_id"] = proveedor_id
+    rows = fetch_all(
+        vat_account_history_sql(
+            selected,
+            account_schema,
+            include_proveedor=proveedor_id is not None,
+        ),
+        params,
+    )
+    return build_cuentas_iva_historicas_response(
+        empresa_id=empresa_id,
+        ejercicio=ejercicio,
+        regimen_id=regimen_id,
+        tipo_factura=normalized_type,
+        porcentaje=porcentaje,
+        proveedor_id=proveedor_id,
+        aggregate_rows=rows,
+    )
+
+
+@app.get(
+    "/facturasrecibidas/cuentas-gasto-historicas",
+    response_model=CuentasGastoHistoricasResponse,
+)
+def get_factura_recibida_cuentas_gasto_historicas(
+    empresa_id: Annotated[int, Query(gt=0)],
+    proveedor_id: Annotated[int, Query(gt=0)],
+    proveedor_tipo: Literal["acreedor", "agricultor"],
+    fecha_desde: date | None = None,
+    fecha_hasta: date | None = None,
+    limit: ExpenseHistoryLimit = 10,
+    schema: Annotated[str | None, schema_query()] = None,
+) -> CuentasGastoHistoricasResponse:
+    """Rank real expense accounts previously stored for a provider.
+
+    This read-only endpoint uses the four FRR expense account/amount pairs. It
+    does not mix analytical CTB rows, journal lines or the provider's current
+    default account with historical invoice usage.
+    """
+
+    if (
+        fecha_desde is not None
+        and fecha_hasta is not None
+        and fecha_desde > fecha_hasta
+    ):
+        raise erp_http_error(
+            422,
+            code="invalid_date_range",
+            category="validation",
+            user_message="La fecha inicial no puede ser posterior a la fecha final.",
+            technical_details={
+                "fecha_desde": fecha_desde.isoformat(),
+                "fecha_hasta": fecha_hasta.isoformat(),
+            },
+        )
+
+    selected = quote_identifier(resolve_schema(schema))
+    account_schema_name = accounting_schema_for_company(empresa_id)
+    if account_schema_name is None:
+        raise erp_http_error(
+            422,
+            code="invalid_account_schema",
+            category="validation",
+            user_message="La empresa no tiene un esquema contable autorizado.",
+            technical_details={"empresa_id": empresa_id},
+        )
+    account_schema = quote_any_identifier(
+        account_schema_name,
+        DB_ALLOWED_ACCOUNT_SCHEMAS,
+        "account schema",
+    )
+    history_sql = expense_account_history_union_sql(
+        selected,
+        proveedor_tipo=proveedor_tipo,
+        include_fecha_desde=fecha_desde is not None,
+        include_fecha_hasta=fecha_hasta is not None,
+    )
+    params: dict[str, Any] = {
+        "empresa_id": empresa_id,
+        "proveedor_id": proveedor_id,
+        "importe_activo_minimo": EXPENSE_HISTORY_ACTIVE_AMOUNT_THRESHOLD,
+    }
+    if fecha_desde is not None:
+        params["fecha_desde"] = fecha_desde
+    if fecha_hasta is not None:
+        params["fecha_hasta"] = fecha_hasta
+
+    aggregate_params = {**params, "limit": limit}
+    rows = fetch_all(
+        f"""
+        WITH history AS (
+            {history_sql}
+        ),
+        ranked_accounts AS (
+            SELECT
+                history.cuenta AS cuenta,
+                NULLIF(TRIM(account_catalog.Nombre), '') AS descripcion,
+                COUNT(DISTINCT history.factura_id) AS usos_facturas,
+                COUNT(*) AS usos_lineas,
+                SUM(history.importe) AS importe_neto_total,
+                SUM(ABS(history.importe)) AS importe_absoluto_total,
+                MIN(history.fecha_factura) AS primera_fecha_uso,
+                MAX(history.fecha_factura) AS ultima_fecha_uso,
+                CASE
+                    WHEN account_catalog.NumeroCuenta IS NULL THEN 0
+                    ELSE 1
+                END AS existe_en_catalogo,
+                NULLIF(TRIM(account_catalog.BloqueoFacturas), '') AS bloqueo_facturas
+            FROM history
+            LEFT JOIN {account_schema}.cuentas account_catalog
+              ON account_catalog.NumeroCuenta = history.cuenta
+            GROUP BY
+                history.cuenta,
+                account_catalog.NumeroCuenta,
+                account_catalog.Nombre,
+                account_catalog.BloqueoFacturas
+        ),
+        history_total AS (
+            SELECT COUNT(DISTINCT factura_id) AS total_facturas_con_gasto
+            FROM history
+        )
+        SELECT
+            ranked_accounts.*,
+            history_total.total_facturas_con_gasto
+        FROM ranked_accounts
+        CROSS JOIN history_total
+        ORDER BY
+            usos_facturas DESC,
+            ultima_fecha_uso DESC,
+            cuenta ASC
+        LIMIT %(limit)s
+        """,
+        aggregate_params,
+    )
+    total = int(rows[0].get("total_facturas_con_gasto") or 0) if rows else 0
+    return build_cuentas_gasto_historicas_response(
+        empresa_id=empresa_id,
+        proveedor_id=proveedor_id,
+        proveedor_tipo=proveedor_tipo,
+        fecha_desde=fecha_desde,
+        fecha_hasta=fecha_hasta,
+        total_facturas_con_gasto=total,
+        aggregate_rows=rows,
+    )
+
+
+@app.get(
+    "/facturasrecibidas/regimen-sugerido",
+    response_model=RegimenSuggestionResponse,
+)
+def get_factura_recibida_regimen_sugerido(
+    proveedor_id: Annotated[int, Query(gt=0)],
+    proveedor_tipo: Literal["acreedor", "agricultor"],
+    empresa_id: Annotated[int, Query(gt=0)] = 1,
+    iva1: Annotated[Decimal | None, Query(ge=0, le=100)] = None,
+    iva2: Annotated[Decimal | None, Query(ge=0, le=100)] = None,
+    iva3: Annotated[Decimal | None, Query(ge=0, le=100)] = None,
+    iva4: Annotated[Decimal | None, Query(ge=0, le=100)] = None,
+    iva5: Annotated[Decimal | None, Query(ge=0, le=100)] = None,
+    base1: Decimal | None = None,
+    base2: Decimal | None = None,
+    base3: Decimal | None = None,
+    base4: Decimal | None = None,
+    base5: Decimal | None = None,
+    cuota1: Decimal | None = None,
+    cuota2: Decimal | None = None,
+    cuota3: Decimal | None = None,
+    cuota4: Decimal | None = None,
+    cuota5: Decimal | None = None,
+    schema: Annotated[str | None, schema_query()] = None,
+) -> RegimenSuggestionResponse:
+    """Suggest a regime only from strongly consistent, circuit-safe history.
+
+    The endpoint is read-only. It never maps an IVA percentage directly to a
+    regime and never mixes equal numeric provider ids from the two ERP masters.
+    """
+
+    selected = quote_identifier(resolve_schema(schema))
+    requested_row: dict[str, Decimal | None] = {}
+    percentages = (iva1, iva2, iva3, iva4, iva5)
+    bases = (base1, base2, base3, base4, base5)
+    quotas = (cuota1, cuota2, cuota3, cuota4, cuota5)
+    for index in range(5):
+        position = index + 1
+        requested_row[f"iva{position}"] = percentages[index]
+        requested_row[f"base{position}"] = bases[index]
+        requested_row[f"cuota{position}"] = quotas[index]
+    requested_signature = active_iva_signature(requested_row)
+    if requested_signature is None:
+        return build_regimen_suggestion(
+            empresa_id=empresa_id,
+            proveedor_id=proveedor_id,
+            proveedor_tipo=proveedor_tipo,
+            requested_signature=None,
+            historical_rows=[],
+        )
+    if not requested_signature:
+        return build_regimen_suggestion(
+            empresa_id=empresa_id,
+            proveedor_id=proveedor_id,
+            proveedor_tipo=proveedor_tipo,
+            requested_signature=(),
+            historical_rows=[],
+        )
+
+    circuit_clause = (
+        "f.FRR_tipofactura = 'GE'"
+        if proveedor_tipo == "agricultor"
+        else "COALESCE(TRIM(f.FRR_tipofactura), '') <> 'GE'"
+    )
+    rows = fetch_all(
+        f"""
+        SELECT
+            f.FRR_idregimen AS regimen_id,
+            f.FRR_iva1 AS iva1,
+            f.FRR_iva2 AS iva2,
+            f.FRR_iva3 AS iva3,
+            f.FRR_iva4 AS iva4,
+            f.FRR_iva5 AS iva5,
+            f.FRR_base1 AS base1,
+            f.FRR_base2 AS base2,
+            f.FRR_base3 AS base3,
+            f.FRR_base4 AS base4,
+            f.FRR_base5 AS base5,
+            f.FRR_cuota1 AS cuota1,
+            f.FRR_cuota2 AS cuota2,
+            f.FRR_cuota3 AS cuota3,
+            f.FRR_cuota4 AS cuota4,
+            f.FRR_cuota5 AS cuota5
+        FROM {selected}.facturasrecibidas f
+        WHERE f.FRR_Idempresa = %(empresa_id)s
+          AND f.FRR_idproveedor = %(proveedor_id)s
+          AND f.FRR_idregimen > 0
+          AND {circuit_clause}
+        """,
+        {
+            "empresa_id": empresa_id,
+            "proveedor_id": proveedor_id,
+        },
+    )
+    return build_regimen_suggestion(
+        empresa_id=empresa_id,
+        proveedor_id=proveedor_id,
+        proveedor_tipo=proveedor_tipo,
+        requested_signature=requested_signature,
+        historical_rows=rows,
+    )
 
 

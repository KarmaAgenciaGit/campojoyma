+def _finite_decimal_readback(value: Any) -> tuple[bool, Decimal | None]:
+    if value is None or (isinstance(value, str) and not value.strip()):
+        return True, None
+    try:
+        parsed = Decimal(str(value))
+    except (ArithmeticError, TypeError, ValueError):
+        return False, None
+    if not parsed.is_finite():
+        return False, None
+    return True, parsed
+
+
+def _strict_positive_integer(value: Any) -> int | None:
+    valid, parsed = _finite_decimal_readback(value)
+    if not valid or parsed is None or parsed <= 0 or parsed != parsed.to_integral_value():
+        return None
+    return int(parsed)
+
+
+def _header_has_fiscal_data(header: dict[str, Any]) -> bool:
+    if str(header.get("FRR_ClaveIRPF") or "").strip():
+        return True
+    for header_field, _, _ in FISCAL_READBACK_FIELDS:
+        valid, value = _finite_decimal_readback(header.get(header_field))
+        if not valid or (value is not None and value != 0):
+            return True
+    return False
+
+
+def _verify_fiscal_readback(
+    header: dict[str, Any],
+    tax_rows: list[dict[str, Any]],
+) -> tuple[bool, dict[str, Any]]:
+    required = _header_has_fiscal_data(header)
+    issues: list[str] = []
+    if required and not tax_rows:
+        issues.append("missing_tax_record")
+    if len(tax_rows) > 1:
+        issues.append("duplicate_tax_records")
+
+    if len(tax_rows) == 1:
+        tax_row = tax_rows[0]
+        inactive_rate_fields: set[tuple[str, str]] = set()
+        for (
+            header_base_field,
+            header_rate_field,
+            header_amount_field,
+            tax_base_field,
+            tax_rate_field,
+            tax_amount_field,
+        ) in VAT_READBACK_SLOTS:
+            amount_values: list[Decimal | None] = []
+            amounts_are_valid = True
+            for source, field in (
+                (header, header_base_field),
+                (header, header_amount_field),
+                (tax_row, tax_base_field),
+                (tax_row, tax_amount_field),
+            ):
+                valid, value = _finite_decimal_readback(source.get(field))
+                amounts_are_valid = amounts_are_valid and valid
+                amount_values.append(value)
+            if amounts_are_valid and all(
+                (value or Decimal("0")) == 0 for value in amount_values
+            ):
+                inactive_rate_fields.add((header_rate_field, tax_rate_field))
+
+        for header_field, tax_field, tolerance in FISCAL_READBACK_FIELDS:
+            header_valid, header_value = _finite_decimal_readback(
+                header.get(header_field)
+            )
+            tax_valid, tax_value = _finite_decimal_readback(tax_row.get(tax_field))
+            if not header_valid:
+                issues.append(f"invalid_header_value:{header_field}")
+                continue
+            if not tax_valid:
+                issues.append(f"invalid_tax_value:{tax_field}")
+                continue
+            # Netagro can retain the regime's configured rate in an inactive
+            # header slot while its fiscal readback stores zero. Only ignore
+            # that rate difference when base and amount are zero on both sides.
+            # Active amounts, rates and every non-slot field remain strict.
+            if (header_field, tax_field) in inactive_rate_fields:
+                continue
+            expected = header_value or Decimal("0")
+            actual = tax_value or Decimal("0")
+            if abs(expected - actual) > tolerance:
+                issues.append(f"fiscal_mismatch:{header_field}:{tax_field}")
+
+        header_key = str(header.get("FRR_ClaveIRPF") or "").strip()
+        tax_key = str(tax_row.get("tax_retention_key") or "").strip()
+        if header_key != tax_key:
+            issues.append("fiscal_mismatch:FRR_ClaveIRPF:tax_retention_key")
+
+    coherent = not issues and (not required or len(tax_rows) == 1)
+    return coherent, {
+        "required": required,
+        "coherent": coherent,
+        "record_count": len(tax_rows),
+        "record_ids": [
+            _strict_positive_integer(row.get("tax_record_id")) for row in tax_rows
+        ],
+        "issues": issues,
+    }
+

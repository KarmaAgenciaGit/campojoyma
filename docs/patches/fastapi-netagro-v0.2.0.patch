+def resolve_write_endpoint(
+    environment: Mapping[str, str],
+    read_host: str,
+    read_port: int,
+) -> tuple[str, int]:
+    """Resolve writer host/port; v3 gates require a separate explicit host."""
+
+    write_host = environment.get("DB_WRITE_HOST", "").strip() or read_host
+    raw_write_port = environment.get("DB_WRITE_PORT", "").strip()
+    if not raw_write_port:
+        return write_host, read_port
+    try:
+        write_port = int(raw_write_port)
+    except ValueError as error:
+        raise RuntimeError("DB_WRITE_PORT must be an integer") from error
+    if not 1 <= write_port <= 65535:

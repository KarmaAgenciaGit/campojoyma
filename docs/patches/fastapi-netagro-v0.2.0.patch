+def _verify_expected_write_datadir(
+    connection: Connection,
+    expected_datadir: str | None,
+    *,
+    missing_error: str,
+    mismatch_error: str,
+    missing_message: str,
+    mismatch_message: str,
+) -> str:
+    """Prove through a read-only server variable that this is the expected clone."""
+
+    expected = (
+        expected_datadir
+        if expected_datadir is not None
+        else os.getenv(DB_WRITE_EXPECTED_DATADIR_ENV, "")
+    )
+    normalized_expected = _normalized_datadir(expected)
+    if not normalized_expected:
+        raise HTTPException(
+            status_code=503,
+            detail={
+                "error": missing_error,
+                "message": missing_message,
+            },
+        )
+    with connection.cursor() as cursor:
+        cursor.execute("SELECT @@datadir AS datadir")
+        row = cursor.fetchone()
+    actual = row.get("datadir") if isinstance(row, Mapping) else None
+    normalized_actual = _normalized_datadir(actual)
+    if not normalized_actual or normalized_actual != normalized_expected:
+        raise HTTPException(
+            status_code=503,
+            detail={
+                "error": mismatch_error,
+                "message": mismatch_message,
+            },
+        )
+    return str(actual)
+

+def vat_account_history_sql(
+    selected: str,
+    account_schema: str,
+    *,
+    include_proveedor: bool,
+) -> str:
+    """Build the static query for unambiguous VAT journal evidence."""
+
+    active_conditions = [
+        (
+            f"ABS(COALESCE(f.FRR_cuota{position}, 0)) "
+            "> %(cuota_activa_minima)s"
+        )
+        for position in range(1, 6)
+    ]
+    active_count = " +\n                    ".join(
+        f"CASE WHEN {condition} THEN 1 ELSE 0 END"
+        for condition in active_conditions
+    )
+    active_rate = "\n                    ".join(
+        f"WHEN {condition} THEN f.FRR_iva{position}"
+        for position, condition in enumerate(active_conditions, start=1)
+    )
+    active_quota = "\n                    ".join(
+        f"WHEN {condition} THEN f.FRR_cuota{position}"
+        for position, condition in enumerate(active_conditions, start=1)
+    )
+    provider_clause = (
+        "AND f.FRR_idproveedor = %(proveedor_id)s"
+        if include_proveedor
+        else ""
+    )
+    return f"""
+        WITH vat_lines AS (
+            SELECT
+                vat_line.IdAsiento AS asiento_id,
+                COUNT(*) AS vat_line_count,
+                MIN(TRIM(vat_line.NumeroCuenta)) AS cuenta,
+                SUM(COALESCE(vat_line.Debe, 0)) AS debe,
+                SUM(COALESCE(vat_line.Haber, 0)) AS haber
+            FROM {account_schema}.asientolineas vat_line
+            WHERE TRIM(vat_line.NumeroCuenta) LIKE '472%%'
+            GROUP BY vat_line.IdAsiento
+        ),
+        unequivocal_history AS (
+            SELECT
+                f.FRR_id AS factura_id,
+                vat_lines.cuenta AS cuenta
+            FROM {selected}.facturasrecibidas f
+            JOIN {account_schema}.asientos journal
+              ON journal.IdAsiento = f.FRR_IdAsientoNet
+             AND journal.cdorigen = 'FR'
+             AND journal.idorigen = f.FRR_id
+            JOIN vat_lines
+              ON vat_lines.asiento_id = journal.IdAsiento
+             AND vat_lines.vat_line_count = 1
+            WHERE f.FRR_Idempresa = %(empresa_id)s
+              AND f.FRR_ejercicio = %(ejercicio)s
+              AND f.FRR_idregimen = %(regimen_id)s
+              AND TRIM(f.FRR_tipofactura) = %(tipo_factura)s
+              {provider_clause}
+              AND (
+                    {active_count}
+              ) = 1
+              AND CASE
+                    {active_rate}
+                  END = %(porcentaje)s
+              AND ROUND(vat_lines.debe - vat_lines.haber, 2) = ROUND(
+                  CASE
+                    {active_quota}
+                  END,
+                  2
+              )
+        )
+        SELECT
+            history.cuenta AS cuenta,
+            MAX(NULLIF(TRIM(account_catalog.Nombre), '')) AS descripcion,
+            COUNT(DISTINCT history.factura_id) AS usos_facturas
+        FROM unequivocal_history history
+        LEFT JOIN {account_schema}.cuentas account_catalog
+          ON account_catalog.NumeroCuenta = history.cuenta
+        GROUP BY history.cuenta
+        ORDER BY usos_facturas DESC, history.cuenta ASC
+    """
+

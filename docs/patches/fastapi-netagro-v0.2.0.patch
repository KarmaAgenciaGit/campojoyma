+def positive_int(value: Any) -> int | None:
+    try:
+        parsed = int(value)
+    except (TypeError, ValueError):
+        return None
+    return parsed if parsed > 0 else None
+
+
+def accounting_state_from_header(
+    header: dict[str, Any],
+) -> tuple[dict[str, Any], list[str]]:
+    requested = str(header.get("FRR_Contabilizar") or "").strip().upper() == "S"
+    technical_id = positive_int(header.get("FRR_IdAsientoNet"))
+    warnings: list[str] = []
+    if not requested:
+        status = "not_requested"
+        created = False
+    elif technical_id is not None:
+        status = "reference_only"
+        created = False
+        warnings.append(
+            "La copia solo conserva FRR_IdAsientoNet. No contiene el diario oficial "
+            "para resolver el numero visible ni verificar Debe/Haber."
+        )
+    else:
+        status = "unavailable"
+        created = False
+        warnings.append(
+            "No hay un servicio, procedimiento o diario oficial de Netagro accesible "
+            "en la copia de pruebas; la API no fabricara el asiento por SQL."
+        )
+    return (
+        {
+            "requested": requested,
+            "created": created,
+            "status": status,
+            "technical_id": technical_id,
+            "visible_number": None,
+            "date": str(header.get("FRR_fechactb")) if header.get("FRR_fechactb") else None,
+            "concept": header.get("FRR_Concepto"),
+            "balanced": None,
+            "total_debit": None,
+            "total_credit": None,
+        },
+        warnings,
+    )
+
+
+def build_write_response(
+    *,
+    contract_version: int,
+    request_id: str | None,
+    dry_run: bool,
+    factura: dict[str, Any] | None,
+    ctb: list[dict[str, Any]],
+    punteos: list[dict[str, Any]],
+    validation_errors: list[dict[str, Any]],
+    validation_warnings: list[str],
+    duplicate: dict[str, Any] | None = None,
+    readback_confirmed: bool = False,
+    punteos_requested: list[dict[str, Any]] | None = None,
+) -> dict[str, Any]:
+    header = factura or {}
+    accounting, accounting_warnings = accounting_state_from_header(header)
+    warnings = list(dict.fromkeys([*validation_warnings, *accounting_warnings]))
+    frr_id = positive_int(header.get("FRR_id"))
+    frr_numero = positive_int(header.get("FRR_numero"))
+    technical_id = positive_int(header.get("FRR_IdAsientoNet"))
+    legacy_technical_id = technical_id or 0
+    ok = not validation_errors and (dry_run or readback_confirmed)
+    return {
+        "ok": ok,
+        "contract_version": contract_version,
+        "request_id": request_id,
+        "dry_run": dry_run,
+        "would_create": not validation_errors,
+        "factura": factura,
+        "ctb": ctb,
+        "punteos": punteos,
+        "validations": {"errors": validation_errors, "warnings": warnings},
+        "accounting": accounting,
+        "duplicate": duplicate,
+        "readback_confirmed": readback_confirmed,
+        # Compatibilidad temporal con el contrato historico.
+        "FRR_id": frr_id,
+        "FRR_numero": frr_numero,
+        "FRR_IdAsientoNet": legacy_technical_id,
+        "ids_punteos_enlazados": punteos,

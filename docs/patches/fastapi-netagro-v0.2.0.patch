+def get_idempotency_connection() -> sqlite3.Connection:
+    try:
+        return open_idempotency_store()
+    except IdempotencyStoreUnavailable as error:
+        LOGGER.error("idempotency store unavailable: %s", error)
+        raise HTTPException(
+            status_code=503,
+            detail={
+                "error": "idempotency_store_unavailable",
+                "message": str(error),
+            },
+        ) from error
+
+
+def _idempotency_row_response(
+    row: sqlite3.Row,
+    request_id: str,
+    payload_hash: str,
+) -> dict[str, Any]:
+    if row["payload_hash"] != payload_hash:
+        raise HTTPException(
+            status_code=409,
+            detail="request_id already exists with a different payload",
+        )
+    if row["status"] == "completed" and row["response_json"]:
+        return json.loads(row["response_json"])
+    state = str(row["status"])
+    error_code = (
+        "idempotency_in_progress"
+        if state == "in_progress"
+        else "idempotency_reconciliation_required"
+    )
+    message = (
+        "request is already in progress; automatic retry is blocked"
+        if state == "in_progress"
+        else "request requires manual reconciliation before any retry"
+    )
+    raise HTTPException(
+        status_code=409,
+        detail={
+            "error": error_code,
+            "message": message,
+            "request_id": request_id,
+            "status": state,
+            "retry_safe": False,
+        },
+    )
+
+
+def _idempotency_lookup(
+    request_id: str,
+    payload_hash: str,
+) -> dict[str, Any] | None:
+    with closing(get_idempotency_connection()) as connection:
+        row = connection.execute(
+            "SELECT * FROM factura_requests WHERE request_id = ?",
+            (request_id,),
+        ).fetchone()
+        if row is None:
+            return None
+        return _idempotency_row_response(row, request_id, payload_hash)
+
+
+def idempotency_lookup(
+    request_id: str,
+    payload_hash: str,
+) -> dict[str, Any] | None:
+    try:
+        return _idempotency_lookup(request_id, payload_hash)
+    except HTTPException:
+        raise
+    except (sqlite3.Error, json.JSONDecodeError) as error:
+        LOGGER.error("idempotency lookup failed", exc_info=True)
+        raise HTTPException(
+            status_code=503,
+            detail={
+                "error": "idempotency_store_unavailable",
+                "message": "the idempotency request could not be inspected safely",
+            },
+        ) from error
+
+
+def _idempotency_claim(request_id: str, payload_hash: str) -> dict[str, Any] | None:
+    now = datetime.now(timezone.utc).isoformat()
+    with closing(get_idempotency_connection()) as connection:
+        connection.execute("BEGIN IMMEDIATE")
+        row = connection.execute(
+            "SELECT * FROM factura_requests WHERE request_id = ?",
+            (request_id,),
+        ).fetchone()
+        if row:
+            return _idempotency_row_response(row, request_id, payload_hash)
+        connection.execute(
+            """
+            INSERT INTO factura_requests
+                (request_id, payload_hash, status, created_at, updated_at)
+            VALUES (?, ?, 'in_progress', ?, ?)
+            """,
+            (request_id, payload_hash, now, now),
+        )
+        connection.commit()
+    return None
+
+
+def idempotency_claim(request_id: str, payload_hash: str) -> dict[str, Any] | None:
+    try:
+        return _idempotency_claim(request_id, payload_hash)
+    except HTTPException:
+        raise
+    except (sqlite3.Error, json.JSONDecodeError) as error:
+        LOGGER.error("idempotency claim failed", exc_info=True)
+        raise HTTPException(
+            status_code=503,
+            detail={
+                "error": "idempotency_store_unavailable",
+                "message": "the idempotency request could not be reserved safely",
+            },
+        ) from error
+
+
+def _idempotency_complete(request_id: str, response: dict[str, Any]) -> None:
+    now = datetime.now(timezone.utc).isoformat()
+    with closing(get_idempotency_connection()) as connection:
+        cursor = connection.execute(
+            """
+            UPDATE factura_requests
+            SET status = 'completed', response_json = ?, error_text = NULL, updated_at = ?
+            WHERE request_id = ? AND status = 'in_progress'
+            """,
+            (json.dumps(response, ensure_ascii=False, default=str), now, request_id),
+        )
+        if cursor.rowcount != 1:
+            raise sqlite3.IntegrityError(
+                "idempotency completion did not update exactly one in-progress request"
+            )
+        connection.commit()
+
+
+def idempotency_complete(request_id: str, response: dict[str, Any]) -> None:
+    try:
+        _idempotency_complete(request_id, response)
+    except HTTPException:
+        raise
+    except sqlite3.Error as error:
+        LOGGER.error("idempotency completion failed", exc_info=True)
+        raise HTTPException(
+            status_code=503,
+            detail={
+                "error": "idempotency_store_unavailable",
+                "message": "the completed request could not be persisted safely",
+            },
+        ) from error
+
+
+def _idempotency_reconcile_complete(
+    request_id: str,
+    payload_hash: str,
+    response: dict[str, Any],
+) -> dict[str, Any]:
+    now = datetime.now(timezone.utc).isoformat()
+    with closing(get_idempotency_connection()) as connection:
+        connection.execute("BEGIN IMMEDIATE")
+        row = connection.execute(
+            "SELECT * FROM factura_requests WHERE request_id = ?",
+            (request_id,),
+        ).fetchone()
+        if row is None:
+            raise HTTPException(
+                status_code=404,
+                detail="request_id does not exist in the idempotency store",
+            )
+        if row["payload_hash"] != payload_hash:
+            raise HTTPException(
+                status_code=409,
+                detail="request_id already exists with a different payload",
+            )
+        if row["status"] == "completed" and row["response_json"]:
+            return json.loads(row["response_json"])
+        if row["status"] != "needs_reconciliation":
+            raise HTTPException(
+                status_code=409,
+                detail={
+                    "error": "idempotency_reconciliation_not_allowed",
+                    "request_id": request_id,
+                    "status": row["status"],
+                },
+            )
+        cursor = connection.execute(
+            """
+            UPDATE factura_requests
+            SET status = 'completed', response_json = ?, error_text = NULL, updated_at = ?
+            WHERE request_id = ? AND payload_hash = ? AND status = 'needs_reconciliation'
+            """,
+            (
+                json.dumps(response, ensure_ascii=False, default=str),
+                now,
+                request_id,
+                payload_hash,
+            ),
+        )
+        if cursor.rowcount != 1:
+            raise sqlite3.IntegrityError(
+                "idempotency reconciliation did not update exactly one request"
+            )
+        connection.commit()
+    return response
+
+
+def idempotency_reconcile_complete(
+    request_id: str,
+    payload_hash: str,
+    response: dict[str, Any],
+) -> dict[str, Any]:
+    try:
+        return _idempotency_reconcile_complete(request_id, payload_hash, response)
+    except HTTPException:
+        raise
+    except (sqlite3.Error, json.JSONDecodeError) as error:
+        LOGGER.error("idempotency reconciliation completion failed", exc_info=True)
+        raise HTTPException(
+            status_code=503,
+            detail={
+                "error": "idempotency_store_unavailable",
+                "message": "the reconciled request could not be persisted safely",
+            },
+        ) from error
+
+
+def _idempotency_fail(request_id: str, error: Exception) -> None:
+    now = datetime.now(timezone.utc).isoformat()
+    with closing(get_idempotency_connection()) as connection:
+        cursor = connection.execute(
+            """
+            UPDATE factura_requests
+            SET status = 'needs_reconciliation', error_text = ?, updated_at = ?
+            WHERE request_id = ? AND status = 'in_progress'
+            """,
+            (str(error)[:1000], now, request_id),
+        )
+        if cursor.rowcount != 1:
+            raise sqlite3.IntegrityError(
+                "idempotency failure did not update exactly one in-progress request"
+            )
+        connection.commit()
+
+
+def idempotency_fail(request_id: str, error: Exception) -> None:
+    try:
+        _idempotency_fail(request_id, error)
+    except HTTPException:
+        raise
+    except sqlite3.Error as store_error:
+        LOGGER.error("idempotency reconciliation marker failed", exc_info=True)
+        raise HTTPException(
+            status_code=503,
+            detail={
+                "error": "idempotency_store_unavailable",
+                "message": "the request could not be marked for reconciliation safely",
+            },
+        ) from store_error
+

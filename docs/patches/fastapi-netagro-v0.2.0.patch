+def erp_infrastructure_error(
+    error: Exception,
+    *,
+    request_id: str | None,
+    target_id: str | None,
+    dataset_epoch: str | None,
+) -> HTTPException:
+    status_code = 503
+    LOGGER.error("ERP infrastructure operation failed", exc_info=True)
+    return erp_http_error(
+        status_code,
+        code="upstream_unavailable",
+        category="environment",
+        user_message="No se puede acceder de forma segura al entorno ERP.",
+        request_id=request_id,

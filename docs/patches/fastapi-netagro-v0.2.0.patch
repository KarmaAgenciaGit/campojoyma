+def _canonical_decimal_string(value: Any) -> str | Any:
+    if value in (None, ""):
+        return value
+    try:
+        parsed = Decimal(str(value))
+    except (ArithmeticError, TypeError, ValueError):
+        return value
+    if not parsed.is_finite():
+        return value
+    if parsed == 0:
+        return "0"
+    return format(parsed.normalize(), "f")
+
+
+def _has_effective_amount(value: Any) -> bool:
+    """Treat decimal zero as an empty optional account/amount slot.
+
+    Invalid or non-finite values remain effective so the existing fail-closed
+    numeric validation can report them instead of silently treating them as
+    absent.
+    """
+
+    if value in (None, ""):
+        return False
+    try:
+        parsed = Decimal(str(value).strip())
+    except (ArithmeticError, TypeError, ValueError):
+        return True
+    return not parsed.is_finite() or parsed != 0
+

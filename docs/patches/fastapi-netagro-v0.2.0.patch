+    request_id: str,
+    payload_hash: str,
+    target_id: str,
+    dataset_epoch: str,
+    circuit: str,
+) -> dict[str, Any] | None:
+    now = datetime.now(timezone.utc).isoformat()
+    with closing(
+        get_idempotency_connection(
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+    ) as connection:
+        connection.execute("BEGIN IMMEDIATE")
+        row = connection.execute(
+            "SELECT * FROM factura_requests WHERE request_id = ?",
+            (request_id,),
+        ).fetchone()
+        if row is None:
+            raise erp_http_error(
+                409,
+                code="validation_required",

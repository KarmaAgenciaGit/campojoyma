+def validate_material_master_references_in_transaction(
+    cursor: Any,
+    selected: str,
+    canonical: Mapping[str, Any],
+) -> tuple[list[dict[str, Any]], dict[str, Any]]:
+    def fetch_one(sql: str, params: dict[str, Any] | None) -> dict[str, Any] | None:
+        cursor.execute(sql, params or {})
+        return cursor.fetchone()
+
+    def fetch_all(sql: str, params: dict[str, Any] | None) -> list[dict[str, Any]]:
+        cursor.execute(sql, params or {})
+        return list(cursor.fetchall())
+
+    return validate_material_master_references(
+        selected,
+        canonical,
+        fetch_one_fn=fetch_one,
+        fetch_all_fn=fetch_all,
+        lock_clause="LOCK IN SHARE MODE",
+    )
+
+
+def material_duplicate_sql(selected: str, *, for_update: bool = False) -> str:
+    lock_clause = "FOR UPDATE" if for_update else ""
+    return f"""
+        SELECT
+            AMA_idalb AS albaran_id,
+            AMA_serie AS serie,
+            AMA_numero AS numero,
+            AMA_fecha AS fecha,
+            AMA_referencia AS referencia,
+            AMA_importe AS importe
+        FROM {selected}.albmaterial
+        WHERE AMA_IdEmpresa = %(company_id)s
+          AND AMA_idacreedor = %(provider_id)s
+          AND AMA_fecha = %(date)s
+          AND TRIM(AMA_referencia) = %(reference)s
+          AND AMA_importe = %(amount)s
+        ORDER BY AMA_idalb
+        LIMIT 201
+        {lock_clause}
+    """
+
+
+def material_duplicate_params(canonical: Mapping[str, Any]) -> dict[str, Any]:
+    header = canonical["cabecera"]
+    return {
+        "company_id": header["empresa_id"],
+        "provider_id": header["acreedor_id"],
+        "date": header["fecha"],
+        "reference": header["referencia"],
+        "amount": header["importe_calculado"],
+    }
+
+
+def material_duplicate_ids(rows: Sequence[Mapping[str, Any]]) -> list[int]:
+    if len(rows) > MAX_MATERIAL_DUPLICATE_MATCHES:
+        raise MaterialDeliveryError(
+            "duplicate_scope_too_large",
+            "Hay demasiados albaranes coincidentes para una confirmacion segura.",
+            details={"maximum": MAX_MATERIAL_DUPLICATE_MATCHES},
+        )
+    identifiers: list[int] = []
+    for row in rows:
+        try:
+            identifier = int(row.get("albaran_id"))
+        except (TypeError, ValueError) as error:
+            raise MaterialDeliveryError(
+                "invalid_master_reference",
+                "La consulta de duplicados devolvio un identificador no valido.",
+            ) from error
+        if identifier <= 0:
+            raise MaterialDeliveryError(
+                "invalid_master_reference",
+                "La consulta de duplicados devolvio un identificador no positivo.",
+            )
+        identifiers.append(identifier)
+    if len(identifiers) != len(set(identifiers)):
+        raise MaterialDeliveryError(
+            "invalid_master_reference",
+            "La consulta de duplicados devolvio identificadores repetidos.",
+        )
+    return sorted(identifiers)
+
+
+def validate_material_duplicate_confirmation(
+    canonical: Mapping[str, Any],
+    rows: Sequence[Mapping[str, Any]],
+) -> list[dict[str, Any]]:
+    observed_ids = material_duplicate_ids(rows)
+    header = canonical["cabecera"]
+    reviewed_ids = list(header["duplicados_revisados_ids"])
+    confirmed = bool(header["duplicado_confirmado_distinto"])
+    if not observed_ids:
+        if confirmed or reviewed_ids:
+            return [
+                {
+                    "field": "cabecera.duplicado_confirmado_distinto",
+                    "error": "duplicate confirmation supplied without current matches",
+                    "expected_ids": [],
+                    "received_ids": reviewed_ids,
+                }
+            ]
+        return []
+    if not confirmed:
+        return [
+            {
+                "field": "cabecera.duplicado_confirmado_distinto",
+                "error": "possible duplicate; explicit confirmation is required",
+                "expected_ids": observed_ids,
+                "received_ids": reviewed_ids,
+            }
+        ]
+    if reviewed_ids != observed_ids:
+        return [
+            {
+                "field": "cabecera.duplicados_revisados_ids",
+                "error": "reviewed duplicate set does not match current ERP rows",
+                "expected_ids": observed_ids,
+                "received_ids": reviewed_ids,
+            }
+        ]
+    return []
+
+
+def material_reconciliation_sql(selected: str) -> str:
+    return f"""
+        SELECT AMA.AMA_idalb AS albaran_id
+        FROM {selected}.albmaterial AMA
+        INNER JOIN {selected}.valeenvases VEV
+          ON VEV.VEV_idvale = AMA.AMA_idvaleenvase
+        WHERE VEV.VEV_Observaciones2 = %(request_marker)s
+        ORDER BY AMA.AMA_idalb
+        LIMIT 2
+    """
+
+
+def material_reconciliation_params(request_id: str) -> dict[str, str]:
+    return {"request_marker": material_delivery_request_marker(request_id)}

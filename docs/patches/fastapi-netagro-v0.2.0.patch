+def contabilizar_factura_recibida(
+    factura_id: Annotated[int, Path(gt=0)],
+    payload: FacturaRecibidaAccountingRequest,
+    x_netagro_api_key: Annotated[
+        str | None,
+        Header(alias=NETAGRO_API_KEY_HEADER),
+    ] = None,
+) -> dict[str, Any]:
+    verify_api_shared_secret(x_netagro_api_key)
+    request_id = str(payload.request_id)
+    target_id = payload.target_id
+    dataset_epoch = str(payload.dataset_epoch)
+    runtime = runtime_identity()
+    if runtime["target_id"] != target_id or runtime["dataset_epoch"] != dataset_epoch:
+        raise erp_http_error(
+            409,
+            code="stale_environment",
+            category="environment",
+            user_message="La factura pertenece a otra copia o generacion del ERP.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+            technical_details={
+                "current_target_id": runtime["target_id"],
+                "current_dataset_epoch": runtime["dataset_epoch"],
+            },
+        )
+    selected_name = resolve_write_schema(None)
+    selected = quote_write_identifier(selected_name)
+    account_schema_name = accounting_schema_for_company(1)
+    if account_schema_name is None:
+        raise erp_http_error(
+            503,
+            code="accounting_schema_unavailable",
+            category="environment",
+            user_message="La contabilidad de la empresa TEST no esta configurada.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+    account_schema = quote_any_identifier(
+        account_schema_name,
+        DB_ALLOWED_ACCOUNT_SCHEMAS,
+        "account schema",
+    )
+    payload_hash = accounting_payload_hash(factura_id, payload)
+    circuit = "accounting:acreedores"
+
+    if payload.operation == "validate":
+        cached = idempotency_lookup(
+            request_id,
+            payload_hash,
+            target_id,
+            dataset_epoch,
+            circuit,
+        )
+        if cached is not None:
+            return cached
+        try:
+            with get_write_target_read_connection() as connection:
+                with connection.cursor() as cursor:
+                    context = load_accounting_context(
+                        cursor,
+                        factura_id=factura_id,
+                        management_schema=selected,
+                        accounting_schema=account_schema,
+                        lock_source=False,
+                    )
+        except AccountingWriteError as error:
+            _raise_accounting_write_error(
+                error,
+                request_id=request_id,
+                target_id=target_id,
+                dataset_epoch=dataset_epoch,
+            )
+        response = accounting_validation_response(
+            factura_id=factura_id,
+            payload=payload,
+            payload_hash=payload_hash,
+            context=context,
+        )
+        return idempotency_record_validation(
+            request_id,
+            payload_hash,
+            target_id,
+            dataset_epoch,
+            circuit,
+            response,
+        )
+
+    cached_or_validation = accounting_idempotency_validation_response(
+        request_id,
+        payload_hash,
+        target_id,
+        dataset_epoch,
+        circuit,
+    )
+    if cached_or_validation.get("operation") == "commit":
+        return cached_or_validation
+    if not cached_or_validation.get("eligible"):
+        raise erp_http_error(
+            422,
+            code="accounting_profile_unsupported",
+            category="accounting",
+            user_message="La factura no pertenece al perfil contable habilitado.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+            technical_details={
+                "errors": cached_or_validation.get("validations", {}).get(
+                    "errors", []
+                )
+            },
+        )
+    if not ACCOUNTING_WRITES_ENABLED or ACCOUNTING_MECHANISM != "sql_test":
+        raise erp_http_error(
+            403,
+            code="writer_disabled",
+            category="environment",
+            user_message="La contabilizacion en TEST esta desactivada.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+    if not accounting_writer_credentials_configured():
+        raise erp_http_error(
+            503,
+            code="accounting_writer_not_ready",
+            category="environment",
+            user_message="El escritor contable de TEST no esta preparado.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+
+    cached = idempotency_claim(
+        request_id,
+        payload_hash,
+        target_id,
+        dataset_epoch,
+        circuit,
+    )
+    if cached is not None:
+        return cached
+    commit_started = False
+    transaction_committed = False
+    context: dict[str, Any] | None = None
+    identifiers: dict[str, Any] | None = None
+    try:
+        with get_accounting_write_connection() as connection:
+            lock_name: str | None = None
+            try:
+                with connection.cursor() as cursor:
+                    lock_name = acquire_accounting_lock(
+                        cursor,
+                        target_id=target_id,
+                        dataset_epoch=dataset_epoch,
+                    )
+                    context = load_accounting_context(
+                        cursor,
+                        factura_id=factura_id,
+                        management_schema=selected,
+                        accounting_schema=account_schema,
+                        lock_source=True,
+                    )
+                    plan = context["plan"]
+                    if not plan.get("eligible"):
+                        raise AccountingWriteError(
+                            "accounting_profile_changed",
+                            "La factura ya no cumple el perfil contable validado.",
+                            details={"errors": plan.get("errors", [])},
+                        )
+                    if context["fingerprint"] != cached_or_validation.get(
+                        "invoice_fingerprint"
+                    ):
+                        raise AccountingWriteError(
+                            "accounting_validation_stale",
+                            "La factura ha cambiado desde la validacion contable.",
+                        )
+                    identifiers = reserve_accounting_identifiers(
+                        cursor,
+                        accounting_schema=account_schema,
+                        exercise=int(context["header"]["FRR_ejercicio"]),
+                        center_id=1,
+                        entry_count=len(plan["lines"]),
+                    )
+                    identifiers.update(
+                        insert_accounting_rows(
+                            cursor,
+                            management_schema=selected,
+                            accounting_schema=account_schema,
+                            header=context["header"],
+                            provider_name=context["provider_name"],
+                            provider_nif=context["provider_nif"],
+                            plan=plan,
+                            identifiers=identifiers,
+                        )
+                    )
+                    verify_accounting_transaction(
+                        cursor,
+                        management_schema=selected,
+                        accounting_schema=account_schema,
+                        factura_id=factura_id,
+                        header=context["header"],
+                        plan=plan,
+                        identifiers=identifiers,
+                    )
+                    observed_support = dict(
+                        context.get("supporting_evidence") or {}
+                    )
+                    if observed_support.get("ctb") or observed_support.get(
+                        "punteos"
+                    ):
+                        latest_ctb, latest_punteos = (
+                            load_accounting_supporting_rows(
+                                cursor,
+                                factura_id=factura_id,
+                                management_schema=selected,
+                                lock_source=True,
+                            )
+                        )
+                        latest_support, latest_support_errors = (
+                            validate_accounting_supporting_rows(
+                                context["header"],
+                                latest_ctb,
+                                latest_punteos,
+                            )
+                        )
+                        if (
+                            latest_support_errors
+                            or latest_support != observed_support
+                        ):
+                            raise AccountingWriteError(
+                                "accounting_supporting_data_changed",
+                                (
+                                    "El CTB o los albaranes cambiaron durante la "
+                                    "contabilizacion."
+                                ),
+                                details={"errors": latest_support_errors},
+                            )
+                commit_started = True
+                connection.commit()
+                transaction_committed = True
+            except Exception:
+                if not commit_started:
+                    connection.rollback()
+                raise
+            finally:
+                if lock_name is not None:
+                    try:
+                        with connection.cursor() as cursor:
+                            release_accounting_lock(cursor, lock_name)
+                    except Exception:
+                        LOGGER.critical(
+                            "could not release accounting lock %s",
+                            lock_name,
+                            exc_info=True,
+                        )
+
+        readback = get_factura_recibida_asiento(
+            factura_id,
+            schema=None,
+            target_id=target_id,
+            dataset_epoch=UUID(dataset_epoch),
+            x_netagro_api_key=x_netagro_api_key,
+        )
+        accounting = dict(readback.get("accounting") or {})
+        if (
+            not accounting.get("created")
+            or not accounting.get("balanced")
+            or int(accounting.get("technical_id") or 0)
+            != int((identifiers or {}).get("journal_id") or 0)
+        ):
+            raise AccountingWriteError(
+                "accounting_readback_mismatch",
+                "El asiento se creo, pero su comprobacion externa no coincide.",
+                details={"accounting": accounting},
+            )
+        response = {
+            "ok": True,
+            "contract_version": 3,
+            "operation": "commit",
+            "request_id": request_id,
+            "target_id": target_id,
+            "dataset_epoch": dataset_epoch,
+            "factura_id": factura_id,
+            "payload_hash": payload_hash,
+            "invoice_fingerprint": str(context["fingerprint"]),
+            "profile": str(context["plan"]["profile"]),
+            "eligible": True,
+            "validations": {"errors": [], "warnings": []},
+            "entries": list(readback.get("entries") or []),
+            "accounting": accounting,
+            "vat_evidence": dict(context.get("vat_evidence") or {}),
+            "supporting_evidence": dict(
+                context.get("supporting_evidence") or {}
+            ),
+            "readback_confirmed": True,
+        }
+        idempotency_complete(
+            request_id,
+            response,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+        return response
+    except Exception as error:
+        try:
+            if commit_started or transaction_committed:
+                idempotency_fail(
+                    request_id,
+                    error,
+                    target_id=target_id,
+                    dataset_epoch=dataset_epoch,
+                )
+            else:
+                idempotency_release_precommit(
+                    request_id,
+                    error,
+                    target_id=target_id,
+                    dataset_epoch=dataset_epoch,
+                )
+        except Exception:
+            LOGGER.critical(

@@ -0,0 +1,7 @@
+from __future__ import annotations
+
+
+def real_write_contract_error(contract_version: int, dry_run: bool) -> str | None:
+    if not dry_run and contract_version != 2:
+        return "real writes require contract_version 2 and an idempotency request_id"
+    return None

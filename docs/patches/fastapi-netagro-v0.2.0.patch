+    identifiers: Mapping[str, Any],
+) -> dict[str, Any]:
+    journal_id = int(identifiers["journal_id"])
+    cursor.execute(
+        f"""
+        SELECT FRR_IdAsientoNet, FRR_Contabilizar
+        FROM {management_schema}.facturasrecibidas
+        WHERE FRR_id = %s
+        """,
+        (factura_id,),
+    )
+    updated_header = cursor.fetchone()
+    cursor.execute(
+        f"""
+        SELECT *
+        FROM {accounting_schema}.asientos
+        WHERE IdAsiento = %s
+        """,
+        (journal_id,),
+    )
+    journal = cursor.fetchone()
+    cursor.execute(
+        f"""
+        SELECT *
+        FROM {accounting_schema}.asientolineas
+        WHERE IdAsiento = %s
+        ORDER BY IdApunte
+        """,
+        (journal_id,),
+    )
+    entries = list(cursor.fetchall())
+    cursor.execute(
+        f"""
+        SELECT *
+        FROM {accounting_schema}.ivasoportado
+        WHERE IdRegistro = %s
+        """,
+        (int(identifiers["tax_record_id"]),),
+    )
+    tax = cursor.fetchone()
+
+    issues: list[str] = []
+    if not updated_header:
+        issues.append("missing_updated_header")
+    else:
+        if int(updated_header.get("FRR_IdAsientoNet") or 0) != journal_id:
+            issues.append("header_journal_id")
+        if str(updated_header.get("FRR_Contabilizar") or "").upper() != "S":
+            issues.append("header_accounting_flag")
+    if not journal:
+        issues.append("missing_journal")
+    else:
+        expected_journal = {
+            "IdAsiento": journal_id,
+            "Ejercicio": int(header["FRR_ejercicio"]),
+            "Tipo": "0",
+            "Asiento": int(identifiers["visible_number"]),
+            "Fecha": header["FRR_fechactb"],
+            "Diario": "",
+            "Generado": "",
+            "Observaciones": "",
+            "IdCentro": 1,
+            "cdorigen": "FR",
+            "idorigen": factura_id,
+            "Nuorigen": str(header["FRR_numero"]),
+            "FechaOperacion": header["FRR_fechafactura"],
+            "IdAplicacion": 216,
+        }
+        for field, expected in expected_journal.items():
+            if str(journal.get(field)) != str(expected):
+                issues.append(f"journal.{field}")
+    expected_lines: Sequence[Mapping[str, Any]] = list(plan.get("lines") or [])
+    if len(entries) != len(expected_lines):
+        issues.append("entry_count")
+    else:
+        debit = ZERO
+        credit = ZERO
+        activity_id = int(header.get("FRR_IdActividad") or 1)
+        section_id = int(header.get("FRR_IdSeccion") or 1)
+        if activity_id <= 0:
+            activity_id = 1
+        if section_id <= 0:
+            section_id = 1
+        raw_entry_ids = identifiers.get("entry_ids")
+        if isinstance(raw_entry_ids, Sequence) and not isinstance(
+            raw_entry_ids,
+            (str, bytes),
+        ):
+            expected_entry_ids = [int(value) for value in raw_entry_ids]
+        else:
+            first_entry_id = int(identifiers["tax_record_id"])
+            expected_entry_ids = [
+                first_entry_id + offset for offset in range(len(expected_lines))
+            ]
+        for position, (actual, expected) in enumerate(
+            zip(entries, expected_lines, strict=True),
+            start=1,
+        ):
+            supplier_line = str(expected.get("role")) == "supplier"
+            expected_entry = {
+                "IdApunte": expected_entry_ids[position - 1],
+                "IdAsiento": journal_id,
+                "NumeroCuenta": str(expected["account"]),
+                "IdActividad": activity_id,
+                "IdSeccion": section_id,
+                "IdDepartamento": 0,

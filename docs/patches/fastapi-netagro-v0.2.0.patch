+
+        grant_head, separator, grant_tail = normalized.partition(" ON ")
+        if not separator:
+            issues.add("ROLE_OR_UNSCOPED_GRANT")
+            continue
+        scope, to_separator, _ = grant_tail.partition(" TO ")
+        if not to_separator:
+            issues.add("UNRECOGNIZED_GRANT_SCOPE")
+            continue
+        normalized_scope = scope.replace("`", "").strip()
+        if "." not in normalized_scope:
+            issues.add(f"UNRECOGNIZED_GRANT_SCOPE:{normalized_scope}")
+            continue
+        schema, table = normalized_scope.split(".", 1)
+
+        for privilege_spec in _split_privilege_specs(
+            grant_head.removeprefix("GRANT ")
+        ):
+            privilege = _base_privilege(privilege_spec)
+            if privilege == "USAGE":
+                continue
+            if schema == "*":
+                issues.add(f"GLOBAL_DATA_SCOPE:{normalized_scope}")
+                continue
+            if table == "*":
+                issues.add(f"SCHEMA_WILDCARD_SCOPE:{normalized_scope}")
+                continue
+
+            if schema in normalized_accounting_schemas:
+                if privilege == "SELECT":
+                    if table not in ACCOUNTING_WRITER_LEDGER_SELECT_TABLES:
+                        issues.add(
+                            f"SELECT@ACCOUNT_SCOPE:{normalized_scope}"
+                        )
+                    continue
+                if privilege == "INSERT":
+                    if table not in ACCOUNTING_WRITER_LEDGER_INSERT_TABLES:
+                        issues.add(
+                            f"INSERT@ACCOUNT_SCOPE:{normalized_scope}"
+                        )
+                    continue
+                issues.add(f"{privilege_spec}@ACCOUNT_SCOPE:{normalized_scope}")
+                continue
+
+            if schema not in normalized_management_schemas:
+                issues.add(f"{privilege_spec}@SCHEMA_SCOPE:{normalized_scope}")
+                continue
+
+            if privilege == "SELECT":
+                if table not in ACCOUNTING_WRITER_MANAGEMENT_SELECT_TABLES:
+                    issues.add(f"SELECT@TABLE_SCOPE:{normalized_scope}")
+                continue
+
+            if privilege == "UPDATE":
+                allowed_columns = (
+                    ACCOUNTING_WRITER_MANAGEMENT_UPDATE_COLUMNS.get(table)
+                )
+                requested_columns = _privilege_columns(privilege_spec)
+                if allowed_columns is None:
+                    issues.add(f"UPDATE@TABLE_SCOPE:{normalized_scope}")
+                elif requested_columns is None:
+                    issues.add(f"UPDATE@TABLE_LEVEL:{normalized_scope}")
+                elif (
+                    not requested_columns
+                    or not requested_columns <= allowed_columns
+                ):
+                    unexpected = ",".join(
+                        sorted(requested_columns - allowed_columns)
+                    )
+                    issues.add(
+                        f"UPDATE({unexpected or 'EMPTY'})"
+                        f"@COLUMN_SCOPE:{normalized_scope}"
+                    )
+                continue
+
+            issues.add(privilege_spec or "EMPTY_GRANT")
+
+    return tuple(sorted(issues))

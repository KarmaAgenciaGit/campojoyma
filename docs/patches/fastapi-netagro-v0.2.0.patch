+def mariadb_endpoints_are_separate(
+    read_host: str,
+    read_port: int,
+    write_host: str,
+    write_port: int,
+    *,
+    resolver: Callable[[str], frozenset[str]] | None = None,
+) -> bool:
+    """Prove two endpoints differ, resolving host aliases on equal ports."""
+
+    if read_port != write_port:
+        return True
+    selected_resolver = resolver or resolve_host_addresses
+    read_addresses = selected_resolver(read_host)
+    write_addresses = selected_resolver(write_host)
+    return bool(
+        read_addresses
+        and write_addresses
+        and read_addresses.isdisjoint(write_addresses)
+    )
+

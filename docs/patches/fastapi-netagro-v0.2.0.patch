+def _split_privilege_specs(value: str) -> tuple[str, ...]:
+    """Split grant privileges without splitting column-level privilege lists."""
+
+    parts: list[str] = []
+    start = 0
+    depth = 0
+    for index, character in enumerate(value):
+        if character == "(":
+            depth += 1
+        elif character == ")":
+            depth -= 1
+            if depth < 0:
+                return (value.strip(),)
+        elif character == "," and depth == 0:
+            parts.append(value[start:index].strip())
+            start = index + 1
+    if depth != 0:
+        return (value.strip(),)
+    parts.append(value[start:].strip())
+    return tuple(parts)
+
+
+def _base_privilege(privilege_spec: str) -> str:
+    match = re.fullmatch(r"(?P<name>[A-Z ]+?)(?:\s*\([^()]+\))?", privilege_spec)
+    if not match:
+        return privilege_spec
+    return match.group("name").strip()
+
+
+def _privilege_columns(privilege_spec: str) -> frozenset[str] | None:
+    match = re.fullmatch(
+        r"(?P<name>[A-Z ]+?)(?:\s*\((?P<columns>[^()]+)\))?",
+        privilege_spec,
+    )
+    if not match or match.group("columns") is None:
+        return None
+    columns = {
+        column.replace("`", "").strip().upper()
+        for column in match.group("columns").split(",")
+    }
+    return frozenset(column for column in columns if column)
+
+
+def unsafe_mariadb_grants(
+    grant_statements: Iterable[str],
+    allowed_privileges: frozenset[str],
+    schema_scopes: frozenset[str],
+    table_scopes: frozenset[tuple[str, str]] = frozenset(),
+) -> tuple[str, ...]:
+    """Return privileges or scopes that fall outside the runtime allowlist."""
+
+    issues: set[str] = set()
+    normalized_schema_scopes = {schema.upper() for schema in schema_scopes}
+    normalized_table_scopes = {
+        (schema.upper(), table.upper())
+        for schema, table in table_scopes
+    }
+    for statement in grant_statements:
+        normalized = " ".join(str(statement).upper().split())
+        if not normalized.startswith("GRANT "):
+            issues.add("UNRECOGNIZED_GRANT")
+            continue
+        if " WITH GRANT OPTION" in normalized:
+            issues.add("GRANT OPTION")
+
+        grant_head, separator, grant_tail = normalized.partition(" ON ")
+        if not separator:
+            issues.add("ROLE_OR_UNSCOPED_GRANT")
+            continue
+
+        scope, to_separator, _ = grant_tail.partition(" TO ")
+        if not to_separator:
+            issues.add("UNRECOGNIZED_GRANT_SCOPE")
+            continue
+        normalized_scope = scope.replace("`", "").strip()
+
+        privilege_specs = _split_privilege_specs(
+            grant_head.removeprefix("GRANT ")
+        )
+        parsed_privileges = tuple(
+            (_base_privilege(spec), spec) for spec in privilege_specs
+        )
+        privileges = {selected for selected, _ in parsed_privileges}
+        for selected, original in parsed_privileges:
+            if selected not in allowed_privileges:
+                issues.add(original or "EMPTY_GRANT")
+
+        data_privileges = privileges - {"USAGE"}
+        if data_privileges:
+            if normalized_scope == "*.*":
+                issues.add("GLOBAL_DATA_SCOPE:*.*")
+            else:
+                if "." not in normalized_scope:
+                    issues.add(f"UNRECOGNIZED_GRANT_SCOPE:{normalized_scope}")
+                    continue
+                schema, table = normalized_scope.split(".", 1)
+                if (
+                    schema not in normalized_schema_scopes
+                    and (schema, table) not in normalized_table_scopes
+                ):
+                    issues.add(f"SCHEMA_SCOPE:{normalized_scope}")
+    return tuple(sorted(issues))
+
+

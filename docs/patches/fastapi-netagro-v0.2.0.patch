+
+def accounting_state_from_header(
+    header: dict[str, Any],
+) -> tuple[dict[str, Any], list[str]]:
+    requested = str(header.get("FRR_Contabilizar") or "").strip().upper() == "S"
+    technical_id = positive_int(header.get("FRR_IdAsientoNet"))
+    warnings: list[str] = []
+    if not requested:
+        status = "not_requested"
+        created = False
+    elif technical_id is not None:
+        status = "reference_only"
+        created = False
+        warnings.append(
+            "La copia solo conserva FRR_IdAsientoNet. No contiene el diario oficial "

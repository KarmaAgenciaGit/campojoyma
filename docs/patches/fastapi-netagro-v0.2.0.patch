+def accounting_read_table_scopes(
+    catalog_schemas: frozenset[str],
+    ledger_schemas: frozenset[str],
+) -> frozenset[tuple[str, str]]:
+    """Build the exact table-level SELECT surface used by accounting reads."""
+
+    normalized_catalog_schemas = {
+        schema.upper() for schema in catalog_schemas
+    }
+    normalized_ledger_schemas = {
+        schema.upper() for schema in ledger_schemas
+    }
+    if not normalized_ledger_schemas <= normalized_catalog_schemas:
+        missing = ", ".join(
+            sorted(normalized_ledger_schemas - normalized_catalog_schemas)
+        )
+        raise ValueError(
+            "ledger schemas must also be accounting catalog schemas: "
+            + missing
+        )
+    return frozenset(
+        {
+            (schema, table)
+            for schema in normalized_catalog_schemas
+            for table in READER_ACCOUNT_CATALOG_SELECT_TABLES
+        }
+        | {
+            (schema, table)
+            for schema in normalized_ledger_schemas
+            for table in READER_ACCOUNT_LEDGER_SELECT_TABLES
+        }
+    )
+

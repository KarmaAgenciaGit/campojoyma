+def accounting_payload_hash(
+    factura_id: int,
+    payload: FacturaRecibidaAccountingRequest,
+) -> str:
+    serialized = json.dumps(
+        {
+            "operation": "POST /facturasrecibidas/{id}/contabilizar",
+            "contract_version": 3,
+            "algorithm": ACCOUNTING_ALGORITHM_VERSION,
+            "factura_id": factura_id,
+        },
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(serialized.encode("utf-8")).hexdigest()

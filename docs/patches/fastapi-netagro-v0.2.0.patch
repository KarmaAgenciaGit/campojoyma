+                request_id,
+                exc_info=True,
+            )
+        if isinstance(error, AccountingWriteError):
+            _raise_accounting_write_error(
+                error,
+                request_id=request_id,
+                target_id=target_id,
+                dataset_epoch=dataset_epoch,
+            )
+        if is_erp_http_exception(error):
+            raise
+        raise erp_infrastructure_error(
+            error,
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        ) from error
 
 

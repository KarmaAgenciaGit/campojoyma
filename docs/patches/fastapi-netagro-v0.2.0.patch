+def _idempotency_record_validation(
+    request_id: str,
+    payload_hash: str,
+    target_id: str,
+    dataset_epoch: str,
+    circuit: str,
+    response: dict[str, Any],
+) -> dict[str, Any]:
+    now = datetime.now(timezone.utc).isoformat()
+    with closing(
+        get_idempotency_connection(
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+    ) as connection:
+        connection.execute("BEGIN IMMEDIATE")
+        row = connection.execute(
+            "SELECT * FROM factura_requests WHERE request_id = ?",
+            (request_id,),
+        ).fetchone()
+        if row:
+            _assert_idempotency_identity(
+                row,
+                request_id,
+                payload_hash,
+                target_id,
+                dataset_epoch,
+                circuit,
+            )
+            return _idempotency_state_response_or_error(
+                row,
+                request_id,
+                target_id,
+                dataset_epoch,
+            )
+        connection.execute(
+            """
+            INSERT INTO factura_requests
+                (
+                    request_id,
+                    payload_hash,
+                    target_id,
+                    dataset_epoch,
+                    circuit,
+                    phase,
+                    status,
+                    response_json,
+                    created_at,
+                    updated_at
+                )
+            VALUES (?, ?, ?, ?, ?, 'validate', 'validated', ?, ?, ?)
+            """,
+            (
+                request_id,
+                payload_hash,
+                target_id,
+                dataset_epoch,
+                circuit,
+                json.dumps(response, ensure_ascii=False, default=str),
+                now,
+                now,
+            ),
+        )

+    ("created_at", "TEXT", 1, None, 0),
+    ("updated_at", "TEXT", 1, None, 0),
+)
+IDEMPOTENCY_SCHEMA_FINGERPRINT = (
+    "582818149d3b86dd506e46f2623edbb2da2322e0be2c4fa14648483f32a44221"
+)
+IDEMPOTENCY_METADATA_COLUMN_SPEC = (
+    ("metadata_version", "INTEGER", 0, None, 1),
+    ("target_id", "TEXT", 1, None, 0),
+    ("dataset_epoch", "TEXT", 1, None, 0),
+    ("snapshot_at", "TEXT", 1, None, 0),

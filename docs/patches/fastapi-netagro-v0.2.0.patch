+def erp_http_error(
+    status_code: int,
+    *,
+    code: str,
+    category: Literal[
+        "validation",
+        "environment",
+        "conflict",
+        "transport",
+        "accounting",
+    ],
+    user_message: str,
+    request_id: str | None = None,
+    target_id: str | None = None,
+    dataset_epoch: str | None = None,
+    retryable: bool = False,
+    reconciliation_required: bool = False,
+    technical_details: dict[str, Any] | None = None,
+) -> HTTPException:
+    envelope = ERPErrorEnvelope(
+        code=code,
+        category=category,
+        user_message=user_message,
+        technical_details=technical_details or {},
+        retryable=retryable,
+        reconciliation_required=reconciliation_required,
+        request_id=request_id,
+        target_id=target_id,
+        dataset_epoch=dataset_epoch,
+    ).model_dump(mode="json")
+    return HTTPException(status_code=status_code, detail=envelope)
+
+
+def is_erp_http_exception(error: Exception) -> bool:
+    return (
+        isinstance(error, HTTPException)
+        and isinstance(error.detail, dict)
+        and ERP_ERROR_REQUIRED_KEYS.issubset(error.detail)
+    )

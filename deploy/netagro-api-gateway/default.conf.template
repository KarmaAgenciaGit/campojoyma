server {
    listen 8080;
    server_name _;
    server_tokens off;

    client_max_body_size 5m;

    location = /gateway-health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location @unauthorized {
        default_type application/json;
        return 401 '{"code":"upstream_unavailable","category":"transport","user_message":"No se ha podido autenticar la conexión con el ERP.","technical_details":{},"retryable":false,"reconciliation_required":false,"request_id":null,"target_id":null,"dataset_epoch":null}';
    }

    location / {
        if ($http_x_netagro_api_key != "${NETAGRO_API_SHARED_SECRET}") {
            return 401;
        }

        error_page 401 = @unauthorized;

        proxy_pass http://172.19.0.1:18001;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:18001;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Netagro-Api-Key $http_x_netagro_api_key;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}

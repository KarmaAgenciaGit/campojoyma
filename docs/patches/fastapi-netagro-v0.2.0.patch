+def _append_accounting_plan_error(
+    plan: dict[str, Any],
+    *,
+    code: str,
+    field: str,
+    message: str,
+    details: dict[str, Any] | None = None,
+) -> None:
+    error: dict[str, Any] = {"code": code, "field": field, "message": message}
+    if details:
+        error["details"] = details
+    plan.setdefault("errors", []).append(error)
+    plan.update(
+        {
+            "eligible": False,
+            "lines": [],
+            "total_debit": None,
+            "total_credit": None,
+            "balanced": False,
+        }
+    )
+
+
+ACCOUNTING_SUPPORT_MONEY_QUANTUM = Decimal("0.01")
+
+
+def _accounting_support_decimal(value: Any) -> Decimal | None:
+    if value is None or value == "" or isinstance(value, bool):
+        return None
+    try:
+        parsed = Decimal(str(value).strip())
+    except (ArithmeticError, TypeError, ValueError):
+        return None
+    if not parsed.is_finite():
+        return None
+    return parsed.quantize(ACCOUNTING_SUPPORT_MONEY_QUANTUM)
+
+
+def validate_accounting_supporting_rows(
+    header: Mapping[str, Any],
+    ctb_rows: list[Mapping[str, Any]],
+    linked_punteos: list[Mapping[str, Any]],
+) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    """Validate optional CTB and material links for the homologated TEST profile.
+
+    CTB is accepted only when its single row is an exact analytical mirror of
+    the sole expense written by the accounting profile.  Linked receipts are
+    accepted only from ``albmaterial`` and only when company, provider and the
+    cent-exact allocated total still match the invoice.  The canonical evidence
+    is included in the accounting fingerprint so validation cannot be replayed
+    in the accounting fingerprint so a later revalidation can detect changes
+    to the supporting dataset before commit.
+    """
+
+    errors: list[dict[str, Any]] = []
+    canonical_ctb: list[dict[str, Any]] = []
+    canonical_punteos: list[dict[str, Any]] = []
+
+    expected_account = str(header.get("FRR_ctagasto1") or "").strip()
+    expected_expense = _accounting_support_decimal(header.get("FRR_igasto1"))
+    expected_base = _accounting_support_decimal(header.get("FRR_base1"))
+    expected_company = positive_int(header.get("FRR_Idempresa"))
+    expected_provider = positive_int(header.get("FRR_idproveedor"))
+    expected_activity = positive_int(header.get("FRR_IdActividad")) or 1
+    expected_section = positive_int(header.get("FRR_IdSeccion")) or 1
+
+    for row in ctb_rows:
+        amount = _accounting_support_decimal(row.get("FRC_Importe"))
+        canonical_ctb.append(
+            {
+                "id": positive_int(row.get("FRC_id")),
+                "account": str(row.get("FRC_Cuenta") or "").strip(),
+                "amount": str(amount) if amount is not None else None,
+                "activity_id": positive_int(row.get("FRC_IdActividad")),
+                "section_id": positive_int(row.get("FRC_Idseccion")),
+                "department_id": positive_int(row.get("FRC_Iddepartamento")),
+                "subdepartment_id": positive_int(
+                    row.get("FRC_Idsubdepartamento")
+                ),
+            }
+        )
+    canonical_ctb.sort(key=lambda row: int(row.get("id") or 0))
+
+    if len(canonical_ctb) > 1:
+        errors.append(
+            {
+                "code": "unsupported_ctb_count",
+                "field": "ctb",
+                "message": "El perfil contable TEST admite como maximo una fila CTB.",
+                "details": {"count": len(canonical_ctb)},
+            }
+        )
+    elif canonical_ctb:
+        row = canonical_ctb[0]
+        if not expected_account or row["account"] != expected_account:
+            errors.append(
+                {
+                    "code": "ctb_account_mismatch",
+                    "field": "ctb.FRC_Cuenta",
+                    "message": "La cuenta CTB debe coincidir con el unico gasto de la factura.",
+                    "details": {
+                        "expected": expected_account or None,
+                        "actual": row["account"] or None,
+                    },
+                }
+            )
+        if expected_expense is None or row["amount"] != str(expected_expense):
+            errors.append(
+                {
+                    "code": "ctb_amount_mismatch",
+                    "field": "ctb.FRC_Importe",
+                    "message": "El importe CTB debe coincidir con el unico gasto de la factura.",
+                    "details": {
+                        "expected": (
+                            str(expected_expense)
+                            if expected_expense is not None
+                            else None
+                        ),
+                        "actual": row["amount"],
+                    },
+                }
+            )
+        if (
+            row["activity_id"] != expected_activity
+            or row["section_id"] != expected_section
+        ):
+            errors.append(
+                {
+                    "code": "ctb_dimensions_mismatch",
+                    "field": "ctb",
+                    "message": (
+                        "La actividad y seccion CTB deben coincidir con la cabecera "
+                        "que se trasladara al asiento."
+                    ),
+                    "details": {
+                        "expected_activity_id": expected_activity,
+                        "actual_activity_id": row["activity_id"],
+                        "expected_section_id": expected_section,
+                        "actual_section_id": row["section_id"],
+                    },
+                }
+            )
+        if row["department_id"] is not None or row["subdepartment_id"] is not None:
+            errors.append(
+                {
+                    "code": "unsupported_ctb_dimensions",
+                    "field": "ctb",
+                    "message": (
+                        "El perfil contable TEST aun no admite departamento ni "
+                        "subdepartamento CTB."
+                    ),
+                }
+            )
+
+    for row in linked_punteos:
+        amount = _accounting_support_decimal(row.get("importe"))
+        canonical_punteos.append(
+            {
+                "source_table": str(row.get("source_table") or "").strip(),
+                "source_id": positive_int(row.get("source_id")),
+                "company_id": positive_int(row.get("empresa_id")),
+                "provider_id": positive_int(row.get("proveedor_id")),
+                "amount": str(amount) if amount is not None else None,
+            }
+        )
+    canonical_punteos.sort(
+        key=lambda row: (str(row.get("source_table") or ""), int(row.get("source_id") or 0))
+    )
+
+    unsupported_sources = sorted(
+        {
+            str(row.get("source_table") or "")
+            for row in canonical_punteos
+            if row.get("source_table") != "albmaterial"
+        }
+    )
+    if unsupported_sources:
+        errors.append(
+            {
+                "code": "unsupported_punteos",
+                "field": "punteos",
+                "message": (
+                    "El perfil contable TEST solo admite albaranes de material "
+                    "ya vinculados por el alta de gestion."
+                ),
+                "details": {"sources": unsupported_sources},
+            }
+        )
+
+    material_rows = [
+        row for row in canonical_punteos if row.get("source_table") == "albmaterial"
+    ]
+    if material_rows and not ALBMATERIAL_WRITES_ENABLED:
+        errors.append(
+            {
+                "code": "albmaterial_write_disabled",
+                "field": "punteos",
+                "message": "La vinculacion de albaranes de material no esta habilitada.",
+            }
+        )
+
+    invalid_company = [
+        row["source_id"]
+        for row in material_rows
+        if expected_company is None or row.get("company_id") != expected_company
+    ]
+    if invalid_company:
+        errors.append(
+            {
+                "code": "punteo_company_mismatch",
+                "field": "punteos",
+                "message": "Los albaranes deben pertenecer a la empresa de la factura.",
+                "details": {"source_ids": invalid_company},
+            }
+        )
+
+    invalid_provider = [
+        row["source_id"]
+        for row in material_rows
+        if expected_provider is None or row.get("provider_id") != expected_provider
+    ]
+    if invalid_provider:
+        errors.append(
+            {
+                "code": "punteo_provider_mismatch",
+                "field": "punteos",
+                "message": "Los albaranes deben pertenecer al proveedor de la factura.",
+                "details": {"source_ids": invalid_provider},
+            }
+        )
+
+    invalid_amounts = [
+        row["source_id"] for row in material_rows if row.get("amount") is None
+    ]
+    if invalid_amounts:
+        errors.append(
+            {
+                "code": "punteo_amount_invalid",
+                "field": "punteos",
+                "message": "Los albaranes contienen importes no validos.",
+                "details": {"source_ids": invalid_amounts},
+            }
+        )
+    elif material_rows:
+        material_total = sum(
+            (Decimal(str(row["amount"])) for row in material_rows),
+            Decimal("0.00"),
+        ).quantize(ACCOUNTING_SUPPORT_MONEY_QUANTUM)
+        if expected_base is None or material_total != expected_base:
+            errors.append(
+                {
+                    "code": "punteo_total_mismatch",
+                    "field": "punteos",
+                    "message": (
+                        "La suma de los albaranes debe coincidir exactamente con "
+                        "la base contabilizada."
+                    ),
+                    "details": {
+                        "expected": (
+                            str(expected_base) if expected_base is not None else None
+                        ),
+                        "actual": str(material_total),
+                    },
+                }
+            )
+
+    evidence = {
+        "policy": "optional-aligned-ctb-albmaterial-v2",
+        "ctb": canonical_ctb,
+        "punteos": canonical_punteos,
+    }
+    return evidence, errors
+

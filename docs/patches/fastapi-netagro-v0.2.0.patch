index 0000000..4c06370 100644
--- /dev/null
+++ app/accounting_writer.py
@@ -0,0 +1,732 @@
+from __future__ import annotations
+
+import hashlib
+import json
+from decimal import Decimal, InvalidOperation
+from typing import Any, Mapping, Sequence
+
+
+ACCOUNTING_ALGORITHM_VERSION = "ot-2110-single-21-ctb-material-v2"
+HISTORICAL_VAT_MIN_USES = 100
+MONEY_QUANTUM = Decimal("0.01")
+ZERO = Decimal("0.00")
+
+
+class AccountingWriteError(RuntimeError):
+    def __init__(
+        self,
+        code: str,
+        message: str,
+        *,
+        details: Mapping[str, Any] | None = None,
+    ) -> None:
+        super().__init__(message)
+        self.code = code
+        self.details = dict(details or {})
+
+
+def _decimal(value: Any) -> Decimal:
+    try:
+        parsed = Decimal(str(value))
+    except (InvalidOperation, TypeError, ValueError) as error:
+        raise AccountingWriteError(
+            "invalid_accounting_amount",
+            "La factura contiene un importe contable no valido.",
+            details={"value": str(value)},
+        ) from error
+    if not parsed.is_finite():
+        raise AccountingWriteError(
+            "invalid_accounting_amount",
+            "La factura contiene un importe contable no finito.",
+        )
+    return parsed.quantize(MONEY_QUANTUM)
+
+
+def accounting_lock_name(target_id: str, dataset_epoch: str) -> str:
+    digest = hashlib.sha256(
+        f"{target_id}\x00{dataset_epoch}\x00accounting".encode("utf-8")
+    ).hexdigest()
+    return f"campojoyma_accounting_{digest[:32]}"
+
+
+def acquire_accounting_lock(
+    cursor: Any,
+    *,
+    target_id: str,
+    dataset_epoch: str,
+    timeout_seconds: int = 15,
+) -> str:
+    lock_name = accounting_lock_name(target_id, dataset_epoch)
+    cursor.execute(
+        "SELECT GET_LOCK(%s, %s) AS acquired",
+        (lock_name, timeout_seconds),
+    )
+    row = cursor.fetchone() or {}
+    if int(row.get("acquired") or 0) != 1:
+        raise AccountingWriteError(
+            "accounting_lock_timeout",
+            "No se ha podido reservar la numeracion contable de TEST.",
+            details={"lock_name": lock_name},
+        )
+    return lock_name
+
+
+def release_accounting_lock(cursor: Any, lock_name: str) -> None:
+    cursor.execute("SELECT RELEASE_LOCK(%s) AS released", (lock_name,))
+    row = cursor.fetchone() or {}
+    if int(row.get("released") or 0) != 1:
+        raise AccountingWriteError(
+            "accounting_lock_release_failed",
+            "No se ha podido liberar la reserva contable de TEST.",
+            details={"lock_name": lock_name},
+        )
+
+
+def resolve_historical_vat_account(
+    cursor: Any,
+    *,
+    management_schema: str,
+    accounting_schema: str,
+    company_id: int,
+    exercise: int,
+) -> dict[str, Any]:
+    """Resolve the 21 % supported-VAT account from exact historical peers."""
+
+    cursor.execute(
+        f"""
+        SELECT
+            vat_line.NumeroCuenta AS account,
+            COUNT(*) AS uses
+        FROM {management_schema}.facturasrecibidas f
+        JOIN {accounting_schema}.asientos a
+          ON a.IdAsiento = f.FRR_IdAsientoNet
+         AND a.cdorigen = 'FR'
+         AND a.idorigen = f.FRR_id
+        JOIN (
+            SELECT
+                IdAsiento,
+                MIN(IdApunte) AS first_entry_id,
+                COUNT(*) AS entry_count
+            FROM {accounting_schema}.asientolineas
+            GROUP BY IdAsiento
+        ) entry_stats
+          ON entry_stats.IdAsiento = a.IdAsiento
+         AND entry_stats.entry_count = 3
+        JOIN {accounting_schema}.ivasoportado tax
+          ON tax.IdRegistro = entry_stats.first_entry_id
+         AND tax.idTipoIvaSoportado = f.FRR_idregimen
+        JOIN {accounting_schema}.asientolineas vat_line
+          ON vat_line.IdAsiento = a.IdAsiento
+         AND vat_line.NumeroCuenta LIKE '472%%'
+         AND vat_line.Debe = f.FRR_cuota1
+         AND vat_line.Haber = 0
+        WHERE f.FRR_Idempresa = %s
+          AND f.FRR_ejercicio = %s
+          AND f.FRR_tipofactura = 'OT'
+          AND f.FRR_idregimen = 2110
+          AND f.FRR_base1 > 0
+          AND f.FRR_iva1 = 21
+          AND f.FRR_cuota1 > 0
+          AND COALESCE(f.FRR_base2, 0) = 0
+          AND COALESCE(f.FRR_cuota2, 0) = 0
+          AND COALESCE(f.FRR_base3, 0) = 0
+          AND COALESCE(f.FRR_cuota3, 0) = 0
+          AND COALESCE(f.FRR_base4, 0) = 0
+          AND COALESCE(f.FRR_cuota4, 0) = 0
+          AND COALESCE(f.FRR_base5, 0) = 0
+          AND COALESCE(f.FRR_cuota5, 0) = 0
+          AND COALESCE(f.FRR_baseret, 0) = 0
+          AND COALESCE(f.FRR_ret, 0) = 0
+          AND COALESCE(f.FRR_cuotaret, 0) = 0
+          AND COALESCE(f.FRR_CuotaNoDeducible, 0) = 0
+          AND COALESCE(f.FRR_ctagasto1, '') <> ''
+          AND f.FRR_igasto1 = f.FRR_base1
+          AND COALESCE(f.FRR_ctagasto2, '') = ''
+          AND COALESCE(f.FRR_igasto2, 0) = 0
+          AND COALESCE(f.FRR_ctagasto3, '') = ''
+          AND COALESCE(f.FRR_igasto3, 0) = 0
+          AND COALESCE(f.FRR_ctagasto4, '') = ''
+          AND COALESCE(f.FRR_igasto4, 0) = 0
+          AND tax.Base1 = f.FRR_base1
+          AND tax.Iva1 = f.FRR_iva1
+          AND tax.Cuota1 = f.FRR_cuota1
+          AND tax.TotalFactura = f.FRR_totalfac
+        GROUP BY vat_line.NumeroCuenta
+        ORDER BY uses DESC, vat_line.NumeroCuenta
+        """,
+        (company_id, exercise),
+    )
+    rows = list(cursor.fetchall())
+    candidates = [
+        {
+            "account": str(row.get("account") or "").strip(),
+            "uses": int(row.get("uses") or 0),
+        }
+        for row in rows
+    ]
+    eligible = [
+        row
+        for row in candidates
+        if row["account"].isdigit() and row["uses"] >= HISTORICAL_VAT_MIN_USES
+    ]
+    if len(eligible) != 1 or len(candidates) != 1:
+        raise AccountingWriteError(
+            "ambiguous_vat_account",
+            "El historico de TEST no determina una unica cuenta de IVA.",
+            details={
+                "company_id": company_id,
+                "exercise": exercise,
+                "minimum_uses": HISTORICAL_VAT_MIN_USES,
+                "candidates": candidates,
+            },
+        )
+    return {
+        **eligible[0],
+        "rate": "21",
+        "profile": ACCOUNTING_ALGORITHM_VERSION,
+    }
+

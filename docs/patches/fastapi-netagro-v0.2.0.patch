+def idempotency_fail(
+    request_id: str,
+    error: Exception,
+    *,
+    target_id: str | None = None,
+    dataset_epoch: str | None = None,
+) -> None:
+    try:
+        _idempotency_fail(
+            request_id,
+            error,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+    except HTTPException:
+        raise
+    except sqlite3.Error as store_error:
+        LOGGER.error("idempotency reconciliation marker failed", exc_info=True)
+        raise erp_http_error(
+            503,
+            code="idempotency_store_unavailable",
+            category="environment",
+            user_message="No se pudo marcar el resultado incierto para reconciliacion.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+            reconciliation_required=True,
+        ) from store_error

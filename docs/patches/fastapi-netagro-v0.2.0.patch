+                    )
+            actual_debit = _decimal(actual.get("Debe"))
+            actual_credit = _decimal(actual.get("Haber"))
+            debit += actual_debit
+            credit += actual_credit
+            if actual_debit != _decimal(expected["debit"]):
+                issues.append(f"entry_{position}.debit")
+            if actual_credit != _decimal(expected["credit"]):
+                issues.append(f"entry_{position}.credit")
+        if debit != credit:
+            issues.append("unbalanced_entries")
+    if not tax:
+        issues.append("missing_tax_record")
+    else:
+        concept = str(expected_lines[0]["concept"]) if expected_lines else ""
+        expected_tax = {
+            "IdRegistro": int(identifiers["tax_record_id"]),
+            "FechaFac": header["FRR_fechafactura"],
+            "Documento": str(header["FRR_numerofactura"]),
+            "idcuenta": str(header["FRR_idcuenta"]),
+            "Base1": _decimal(header["FRR_base1"]),
+            "Iva1": _decimal(header["FRR_iva1"]),
+            "Cuota1": _decimal(header["FRR_cuota1"]),
+            "Base2": ZERO,

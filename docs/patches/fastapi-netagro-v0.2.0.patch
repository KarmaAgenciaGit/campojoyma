diff --git app/mariadb_permissions.py app/mariadb_permissions.py
new file mode 100644
index 0000000..b61b7db
--- /dev/null
+++ app/mariadb_permissions.py
@@ -0,0 +1,54 @@
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+
+READ_ONLY_MARIADB_PRIVILEGES = frozenset({"USAGE", "SELECT"})
+WRITE_MARIADB_PRIVILEGES = frozenset({"USAGE", "SELECT", "INSERT", "UPDATE"})
+
+
+def unsafe_mariadb_grants(
+    grant_statements: Iterable[str],
+    allowed_privileges: frozenset[str],
+    allowed_schemas: frozenset[str],
+) -> tuple[str, ...]:
+    """Return privileges or scopes that fall outside the runtime allowlist."""
+
+    issues: set[str] = set()
+    normalized_schemas = {schema.upper() for schema in allowed_schemas}
+    for statement in grant_statements:
+        normalized = " ".join(str(statement).upper().split())
+        if not normalized.startswith("GRANT "):
+            issues.add("UNRECOGNIZED_GRANT")
+            continue
+        if " WITH GRANT OPTION" in normalized:
+            issues.add("GRANT OPTION")
+
+        grant_head, separator, grant_tail = normalized.partition(" ON ")
+        if not separator:
+            issues.add("ROLE_OR_UNSCOPED_GRANT")
+            continue
+
+        scope, to_separator, _ = grant_tail.partition(" TO ")
+        if not to_separator:
+            issues.add("UNRECOGNIZED_GRANT_SCOPE")
+            continue
+        normalized_scope = scope.replace("`", "").strip()
+
+        privileges = {
+            privilege.strip()
+            for privilege in grant_head.removeprefix("GRANT ").split(",")
+        }
+        for selected in privileges:
+            if selected not in allowed_privileges:
+                issues.add(selected or "EMPTY_GRANT")
+
+        data_privileges = privileges - {"USAGE"}
+        if data_privileges:
+            if normalized_scope == "*.*":
+                issues.add("GLOBAL_DATA_SCOPE:*.*")
+            else:
+                schema = normalized_scope.split(".", 1)[0]
+                if schema not in normalized_schemas:
+                    issues.add(f"SCHEMA_SCOPE:{normalized_scope}")
+    return tuple(sorted(issues))

+def get_idempotency_connection(
+    *,
+    request_id: str | None = None,
+    target_id: str | None = None,
+    dataset_epoch: str | None = None,
+) -> sqlite3.Connection:
+    try:
+        return open_idempotency_store()
+    except IdempotencyStoreUnavailable as error:
+        LOGGER.error("idempotency store unavailable: %s", error)
+        runtime = runtime_identity()
+        raise erp_http_error(
+            503,
+            code="idempotency_store_unavailable",
+            category="environment",
+            user_message="El control de idempotencia del ERP no esta disponible.",
+            request_id=request_id,
+            target_id=target_id or runtime["target_id"],
+            dataset_epoch=dataset_epoch or runtime["dataset_epoch"],
+        ) from error

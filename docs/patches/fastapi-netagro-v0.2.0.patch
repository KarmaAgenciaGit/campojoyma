+def material_delivery_http_error(
+    error: MaterialDeliveryError,
+    *,
+    request_id: str,
+    target_id: str,
+    dataset_epoch: str,
+    reconciliation_required: bool = False,
+) -> HTTPException:
+    validation_codes = {
+        "invalid_material_payload",
+        "invalid_master_reference",
+        "derived_value_overflow",
+    }
+    conflict_codes = {
+        "counter_drift",
+        "counter_exhausted",
+        "duplicate_scope_too_large",
+    }
+    if reconciliation_required:
+        status_code = 503
+        category = "transport"
+    elif error.code in validation_codes:
+        status_code = 422
+        category = "validation"
+    elif error.code in conflict_codes:
+        status_code = 409
+        category = "environment"
+    else:
+        status_code = 503
+        category = "transport"
+    return erp_http_error(
+        status_code,
+        code=error.code,
+        category=category,
+        user_message=str(error),
+        request_id=request_id,
+        target_id=target_id,
+        dataset_epoch=dataset_epoch,
+        technical_details=error.details,
+        reconciliation_required=reconciliation_required,
+        retryable=False,
+    )

+class IdempotencyStoreUnavailable(RuntimeError):
+    """The preprovisioned idempotency store is missing or incompatible."""
+
+
+def configured_idempotency_path() -> Path:
+    raw_path = os.getenv(IDEMPOTENCY_ENV_VAR, "").strip()
+    if not raw_path:
+        raise IdempotencyStoreUnavailable(
+            f"{IDEMPOTENCY_ENV_VAR} is required when ERP writes are enabled"
+        )
+    path = Path(raw_path).expanduser()
+    if not path.is_absolute():
+        raise IdempotencyStoreUnavailable(
+            f"{IDEMPOTENCY_ENV_VAR} must contain an absolute path"
+        )
+    return path
+
+
+def normalize_idempotency_identity(
+    target_id: str,
+    dataset_epoch: str | UUID,
+    snapshot_at: str,
+) -> tuple[str, str, str]:
+    normalized_target = str(target_id).strip()
+    if not normalized_target:
+        raise IdempotencyStoreUnavailable("NETAGRO_TARGET_ID is required")
+    try:
+        parsed_epoch = (
+            dataset_epoch
+            if isinstance(dataset_epoch, UUID)
+            else UUID(str(dataset_epoch).strip())
+        )
+    except (ValueError, AttributeError) as error:
+        raise IdempotencyStoreUnavailable(
+            "NETAGRO_DATASET_EPOCH must be a non-zero UUID"
+        ) from error
+    if parsed_epoch.int == 0:
+        raise IdempotencyStoreUnavailable(
+            "NETAGRO_DATASET_EPOCH must be a non-zero UUID"
+        )
+    normalized_snapshot_input = str(snapshot_at).strip()
+    try:
+        parsed_snapshot = datetime.fromisoformat(normalized_snapshot_input)
+    except ValueError as error:
+        raise IdempotencyStoreUnavailable(
+            "NETAGRO_SNAPSHOT_AT must be an ISO timestamp with timezone"
+        ) from error
+    if (
+        parsed_snapshot.tzinfo is None
+        or parsed_snapshot.utcoffset() is None
+    ):
+        raise IdempotencyStoreUnavailable(
+            "NETAGRO_SNAPSHOT_AT must be an ISO timestamp with timezone"
+        )
+    return (
+        normalized_target,
+        str(parsed_epoch),
+        parsed_snapshot.isoformat(),
+    )
+
+
+def configured_idempotency_identity() -> tuple[str, str, str]:
+    return normalize_idempotency_identity(
+        os.getenv("NETAGRO_TARGET_ID", ""),
+        os.getenv("NETAGRO_DATASET_EPOCH", ""),
+        os.getenv("NETAGRO_SNAPSHOT_AT", ""),
+    )
+
+
+def _open_idempotency_store(
+    path: Path | None = None,
+    *,
+    target_id: str | None = None,
+    dataset_epoch: str | UUID | None = None,
+    snapshot_at: str | None = None,
+    read_only: bool,
+) -> sqlite3.Connection:
+    if target_id is None and dataset_epoch is None and snapshot_at is None:
+        expected_identity = configured_idempotency_identity()
+    elif (
+        target_id is not None
+        and dataset_epoch is not None
+        and snapshot_at is not None
+    ):
+        expected_identity = normalize_idempotency_identity(
+            target_id,
+            dataset_epoch,
+            snapshot_at,
+        )
+    else:
+        raise IdempotencyStoreUnavailable(
+            "target_id, dataset_epoch and snapshot_at must be supplied together"
+        )
+    selected_path = path or configured_idempotency_path()
+    if not selected_path.is_file():
+        raise IdempotencyStoreUnavailable(
+            "the configured idempotency store does not exist; provision it during deployment"
+        )
+
+    mode = "ro" if read_only else "rw"
+    uri = f"{selected_path.resolve().as_uri()}?mode={mode}"
+    try:
+        connection = sqlite3.connect(uri, uri=True, timeout=10)
+    except sqlite3.Error as error:
+        raise IdempotencyStoreUnavailable(
+            "the configured idempotency store cannot be opened in "
+            f"{'read-only' if read_only else 'read/write'} mode"
+        ) from error
+
+    connection.row_factory = sqlite3.Row
+    try:
+        version_row = connection.execute("PRAGMA user_version").fetchone()
+        version = int(version_row[0]) if version_row else 0
+        if version != IDEMPOTENCY_SCHEMA_VERSION:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store schema version is not supported"
+            )
+
+        table = connection.execute(
+            "SELECT name, sql FROM sqlite_master WHERE type = 'table' AND name = ?",
+            (IDEMPOTENCY_TABLE,),
+        ).fetchone()
+        if table is None:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store is missing its required table"
+            )
+
+        columns = tuple(
+            (
+                row["name"],
+                str(row["type"]).upper(),
+                int(row["notnull"]),
+                row["dflt_value"],
+                int(row["pk"]),
+            )
+            for row in connection.execute(
+                f'PRAGMA table_info("{IDEMPOTENCY_TABLE}")'
+            ).fetchall()
+        )
+        if columns != IDEMPOTENCY_COLUMN_SPEC:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store has an unexpected schema"
+            )
+
+        primary_indexes = [
+            row
+            for row in connection.execute(
+                f'PRAGMA index_list("{IDEMPOTENCY_TABLE}")'
+            ).fetchall()
+            if int(row["unique"]) == 1 and row["origin"] == "pk"
+        ]
+        if len(primary_indexes) != 1:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store is missing its primary key index"
+            )
+        primary_columns = tuple(
+            row["name"]
+            for row in connection.execute(
+                f'PRAGMA index_info("{primary_indexes[0]["name"]}")'
+            ).fetchall()
+        )
+        if primary_columns != ("request_id",):
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store has an unexpected primary key"
+            )
+
+        normalized_sql = " ".join(str(table["sql"]).split()).upper()
+        fingerprint = hashlib.sha256(normalized_sql.encode("utf-8")).hexdigest()
+        if fingerprint != IDEMPOTENCY_SCHEMA_FINGERPRINT:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store schema fingerprint does not match"
+            )
+
+        metadata_table = connection.execute(
+            "SELECT name, sql FROM sqlite_master WHERE type = 'table' AND name = ?",
+            (IDEMPOTENCY_METADATA_TABLE,),
+        ).fetchone()
+        if metadata_table is None:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store is missing its versioned identity metadata"
+            )
+        metadata_columns = tuple(
+            (
+                row["name"],
+                str(row["type"]).upper(),
+                int(row["notnull"]),
+                row["dflt_value"],
+                int(row["pk"]),
+            )
+            for row in connection.execute(
+                f'PRAGMA table_info("{IDEMPOTENCY_METADATA_TABLE}")'
+            ).fetchall()
+        )
+        if metadata_columns != IDEMPOTENCY_METADATA_COLUMN_SPEC:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store identity metadata has an unexpected schema"
+            )
+        normalized_metadata_sql = " ".join(
+            str(metadata_table["sql"]).split()
+        ).upper()
+        metadata_fingerprint = hashlib.sha256(
+            normalized_metadata_sql.encode("utf-8")
+        ).hexdigest()
+        if metadata_fingerprint != IDEMPOTENCY_METADATA_SCHEMA_FINGERPRINT:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store identity metadata fingerprint does not match"
+            )
+        metadata_rows = connection.execute(
+            f"""
+            SELECT metadata_version, target_id, dataset_epoch, snapshot_at
+            FROM "{IDEMPOTENCY_METADATA_TABLE}"
+            """
+        ).fetchall()
+        if len(metadata_rows) != 1:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store must contain exactly one identity record"
+            )
+        metadata = metadata_rows[0]
+        if int(metadata["metadata_version"]) != IDEMPOTENCY_METADATA_VERSION:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store identity metadata version is unsupported"
+            )
+        actual_identity = normalize_idempotency_identity(
+            metadata["target_id"],
+            metadata["dataset_epoch"],
+            metadata["snapshot_at"],
+        )
+        if actual_identity != expected_identity:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store belongs to another target, dataset epoch or snapshot"
+            )
+    except IdempotencyStoreUnavailable:
+        connection.close()
+        raise
+    except sqlite3.Error as error:
+        connection.close()
+        raise IdempotencyStoreUnavailable(
+            "the idempotency store schema could not be validated"
+        ) from error
+
+    return connection
+
+
+def open_idempotency_store(
+    path: Path | None = None,
+    *,
+    target_id: str | None = None,
+    dataset_epoch: str | UUID | None = None,
+    snapshot_at: str | None = None,
+) -> sqlite3.Connection:
+    return _open_idempotency_store(
+        path,
+        target_id=target_id,
+        dataset_epoch=dataset_epoch,
+        snapshot_at=snapshot_at,
+        read_only=False,
+    )

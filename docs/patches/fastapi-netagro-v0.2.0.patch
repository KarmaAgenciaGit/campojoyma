+def build_material_write_response(
+    *,
+    operation: Literal["validate", "commit"],
+    request_id: str,
+    target_id: str,
+    dataset_epoch: str,
+    payload_hash: str,
+    canonical: Mapping[str, Any],
+    validation_errors: list[dict[str, Any]],
+    validation_warnings: list[str],
+    duplicate: dict[str, Any] | None = None,
+    created: Mapping[str, Any] | None = None,
+    readback_confirmed: bool = False,
+) -> dict[str, Any]:
+    runtime = runtime_identity()
+    if created is None:
+        albaran: dict[str, Any] | None = dict(canonical["cabecera"])
+        lineas = [dict(line) for line in canonical["lineas"]]
+        vale = None
+        vale_lineas: list[dict[str, Any]] = []
+    else:
+        albaran = dict(created["albaran"]) if created.get("albaran") else None
+        lineas = [dict(line) for line in created.get("lineas", [])]
+        vale = (

+def _exact_cent_amount_match(left: Any, right: Any) -> bool:
+    try:
+        left_decimal = Decimal(str(left))
+        right_decimal = Decimal(str(right))
+        left_cents = left_decimal.quantize(Decimal("0.01"))
+        right_cents = right_decimal.quantize(Decimal("0.01"))
+    except (ArithmeticError, TypeError, ValueError):
+        return False
+    return bool(
+        left_decimal.is_finite()
+        and right_decimal.is_finite()
+        and left_decimal == left_cents
+        and right_decimal == right_cents
+        and left_cents == right_cents
+    )

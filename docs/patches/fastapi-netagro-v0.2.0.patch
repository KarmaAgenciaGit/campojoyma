+def _idempotency_lookup(
+    request_id: str,
+    payload_hash: str,
+    target_id: str,
+    dataset_epoch: str,
+    circuit: str,
+) -> dict[str, Any] | None:
+    with closing(
+        get_idempotency_connection(
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+    ) as connection:
+        row = connection.execute(
+            "SELECT * FROM factura_requests WHERE request_id = ?",
+            (request_id,),
+        ).fetchone()
+        if row is None:
+            return None
+        _assert_idempotency_identity(
+            row,
+            request_id,
+            payload_hash,
+            target_id,
+            dataset_epoch,
+            circuit,
+        )
+        return _idempotency_state_response_or_error(
+            row,
+            request_id,
+            target_id,
+            dataset_epoch,
+        )

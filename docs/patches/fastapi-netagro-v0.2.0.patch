+def _invoice_master_reference_sql(
+    selected: str,
+    invoice_type: str,
+) -> str:
+    if invoice_type == "GE":
+        provider_table = "agricultores"
+        provider_column = "AGR_Idagricultor"
+    else:
+        provider_table = "acreedores"
+        provider_column = "ACR_Codigo"
+    return f"""
+        SELECT
+            EXISTS(
+                SELECT 1
+                FROM {selected}.facturasrecibidas
+                WHERE TRIM(FRR_tipofactura) = %(invoice_type)s
+            ) AS invoice_type_exists,
+            EXISTS(
+                SELECT 1
+                FROM {selected}.{provider_table}
+                WHERE {provider_column} = %(provider_id)s
+            ) AS provider_exists
+    """
+
+
+def _invoice_master_reference_errors(
+    row: dict[str, Any] | None,
+) -> list[dict[str, Any]]:
+    errors: list[dict[str, Any]] = []
+    if not row or int(row.get("invoice_type_exists") or 0) != 1:
+        errors.append(
+            {
+                "field": "cabecera.FRR_tipofactura",
+                "error": "invoice type does not exist in the ERP catalog",
+            }

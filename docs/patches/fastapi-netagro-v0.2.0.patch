+def missing_writer_mariadb_grants(
+    grant_statements: Iterable[str],
+    write_schemas: frozenset[str],
+    account_schemas: frozenset[str],
+) -> tuple[str, ...]:
+    """Return every minimum writer privilege absent from SHOW GRANTS."""
+
+    parsed = _parsed_scoped_privileges(grant_statements)
+    issues: set[str] = set()
+
+    def has_table_privilege(
+        privilege: str,
+        schema: str,
+        table: str,
+    ) -> bool:
+        return any(
+            selected_privilege == privilege
+            and columns is None
+            and selected_schema == schema
+            and selected_table == table
+            for (
+                selected_privilege,
+                columns,
+                selected_schema,
+                selected_table,
+            ) in parsed
+        )
+
+    def granted_update_columns(schema: str, table: str) -> frozenset[str]:
+        return frozenset(
+            column
+            for (
+                privilege,
+                columns,
+                selected_schema,
+                selected_table,
+            ) in parsed
+            if privilege == "UPDATE"
+            and columns is not None
+            and selected_schema == schema
+            and selected_table == table
+            for column in columns
+        )
+
+    for raw_schema in write_schemas:
+        schema = raw_schema.upper()
+        for table in sorted(WRITER_SELECT_TABLES):
+            if not has_table_privilege("SELECT", schema, table):
+                issues.add(f"SELECT@TABLE_SCOPE:{schema}.{table}")
+        for table in sorted(WRITER_INSERT_TABLES):
+            if not has_table_privilege("INSERT", schema, table):
+                issues.add(f"INSERT@TABLE_SCOPE:{schema}.{table}")
+        for table, required_columns in WRITER_UPDATE_COLUMNS.items():
+            missing_columns = required_columns - granted_update_columns(
+                schema,
+                table,
+            )
+            if missing_columns:
+                issues.add(
+                    "UPDATE("
+                    + ",".join(sorted(missing_columns))
+                    + f")@COLUMN_SCOPE:{schema}.{table}"
+                )
+
+    for raw_schema in account_schemas:
+        schema = raw_schema.upper()
+        for table in sorted(WRITER_ACCOUNT_SELECT_TABLES):
+            if not has_table_privilege("SELECT", schema, table):
+                issues.add(f"SELECT@ACCOUNT_SCOPE:{schema}.{table}")
+
+    return tuple(sorted(issues))

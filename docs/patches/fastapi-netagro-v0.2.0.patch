+def _assert_idempotency_identity(
+    row: sqlite3.Row,
+    request_id: str,
+    payload_hash: str,
+    target_id: str,
+    dataset_epoch: str,
+    circuit: str,
+) -> None:
+    if row["payload_hash"] != payload_hash:
+        raise erp_http_error(
+            409,
+            code="idempotency_conflict",
+            category="conflict",
+            user_message="La solicitud ya existe con datos diferentes.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+    if row["target_id"] != target_id or row["dataset_epoch"] != dataset_epoch:
+        raise erp_http_error(
+            409,
+            code="stale_environment",
+            category="environment",
+            user_message=(
+                "La validacion pertenece a otra copia o generacion del ERP. "
+                "Vuelve a validar el documento."
+            ),
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+    if row["circuit"] != circuit:
+        raise erp_http_error(
+            409,
+            code="idempotency_conflict",
+            category="conflict",
+            user_message="La solicitud pertenece a otro circuito ERP.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+
+
+def _idempotency_state_response_or_error(
+    row: sqlite3.Row,
+    request_id: str,
+    target_id: str,
+    dataset_epoch: str,
+) -> dict[str, Any]:
+    if row["status"] == "completed" and row["response_json"]:
+        return json.loads(row["response_json"])
+    state = str(row["status"])
+    if state == "validated" and row["response_json"]:
+        return json.loads(row["response_json"])
+    code = (
+        "idempotency_in_progress"
+        if state == "in_progress"
+        else "ambiguous_commit"
+    )
+    message = (
+        "La solicitud ya se esta procesando."
+        if state == "in_progress"
+        else "El resultado anterior es incierto y requiere reconciliacion."
+    )
+    raise erp_http_error(
+        409,
+        code=code,
+        category="conflict",
+        user_message=message,
+        request_id=request_id,
+        target_id=target_id,
+        dataset_epoch=dataset_epoch,
+        reconciliation_required=state == "needs_reconciliation",
+        technical_details={"status": state},
+    )
+

+def verify_api_shared_secret(provided_secret: str | None) -> None:
+    configured = os.getenv(NETAGRO_API_SHARED_SECRET_ENV, "")
+    if not shared_secret_is_operational(configured):
+        raise erp_http_error(
+            503,
+            code="api_auth_unavailable",
+            category="environment",
+            user_message="La autenticacion de la integracion ERP no esta configurada.",
+            technical_details={
+                "minimum_secret_length": NETAGRO_API_SHARED_SECRET_MIN_LENGTH,
+                "minimum_estimated_entropy_bits": (
+                    NETAGRO_API_SHARED_SECRET_MIN_ENTROPY_BITS
+                ),
+            },
+        )
+    if provided_secret is None or not secrets.compare_digest(
+        provided_secret.encode("utf-8"),
+        configured.encode("utf-8"),
+    ):
+        raise erp_http_error(
+            401,
+            code="invalid_api_key",
+            category="environment",
+            user_message="La integracion no esta autorizada para acceder al ERP.",
+        )
+

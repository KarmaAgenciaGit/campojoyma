+def load_accounting_supporting_rows(
+    cursor: Any,
+    *,
+    factura_id: int,
+    management_schema: str,
+    lock_source: bool,
+) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
+    lock_clause = " FOR UPDATE" if lock_source else ""
+    cursor.execute(
+        f"""
+        SELECT
+            FRC_id,
+            FRC_Importe,
+            FRC_Cuenta,
+            FRC_IdActividad,
+            FRC_Idseccion,
+            FRC_Iddepartamento,
+            FRC_Idsubdepartamento
+        FROM {management_schema}.facturasrecibidas_ctb
+        WHERE FRC_idfacturarecibida = %s
+        ORDER BY FRC_id
+        {lock_clause}
+        """,
+        (factura_id,),
+    )
+    ctb_rows = [dict(row) for row in cursor.fetchall()]
+
+    linked_punteos: list[dict[str, Any]] = []
+    for source, (table, id_column, link_column, _) in PUNTEO_CONFIG.items():
+        if source == "albmaterial":
+            selected_columns = (
+                f"{id_column} AS source_id, "
+                "AMA_IdEmpresa AS empresa_id, "
+                "AMA_idacreedor AS proveedor_id, "
+                "AMA_importe AS importe"
+            )
+        else:
+            selected_columns = f"{id_column} AS source_id"
+        cursor.execute(
+            f"""
+            SELECT {selected_columns}
+            FROM {management_schema}.{table}
+            WHERE {link_column} = %s
+            ORDER BY {id_column}
+            {lock_clause}
+            """,
+            (factura_id,),
+        )
+        for row in cursor.fetchall():
+            linked_punteos.append({"source_table": source, **dict(row)})
+    return ctb_rows, linked_punteos
+
+
+def load_accounting_context(
+    cursor: Any,
+    *,
+    factura_id: int,
+    management_schema: str,
+    accounting_schema: str,
+    lock_source: bool,
+) -> dict[str, Any]:
+    lock_clause = " FOR UPDATE" if lock_source else ""
+    cursor.execute(
+        f"""
+        SELECT
+            f.*,
+            acr.ACR_Nombre AS proveedor_nombre,
+            acr.ACR_Nif AS proveedor_nif
+        FROM {management_schema}.facturasrecibidas f
+        LEFT JOIN {management_schema}.acreedores acr
+          ON COALESCE(f.FRR_tipofactura, '') <> 'GE'
+         AND acr.ACR_Codigo = f.FRR_idproveedor
+        WHERE f.FRR_id = %s
+        {lock_clause}
+        """,
+        (factura_id,),
+    )
+    header = cursor.fetchone()
+    if not header:
+        raise erp_http_error(
+            404,
+            code="accounting_invoice_not_found",
+            category="validation",
+            user_message="La factura no existe en la copia TEST del ERP.",
+            technical_details={"factura_id": factura_id},
+        )
+    header = dict(header)
+    provider_name = str(header.pop("proveedor_nombre", "") or "").strip()
+    provider_nif = str(header.pop("proveedor_nif", "") or "").strip()
+    company_id = positive_int(header.get("FRR_Idempresa"))
+    exercise = positive_int(header.get("FRR_ejercicio"))
+    if company_id is None or exercise is None:
+        raise erp_http_error(
+            422,
+            code="accounting_profile_unsupported",
+            category="accounting",
+            user_message="La factura no contiene empresa y ejercicio contables validos.",
+            technical_details={"factura_id": factura_id},
+        )
+    if company_id != 1:
+        raise erp_http_error(
+            422,
+            code="accounting_profile_unsupported",
+            category="accounting",
+            user_message=(
+                "La contabilizacion automatica de TEST solo esta homologada "
+                "para la empresa 1."
+            ),
+            technical_details={
+                "factura_id": factura_id,
+                "company_id": company_id,
+            },
+        )
+
+    vat_evidence: dict[str, Any] = {}
+    vat_mapping: dict[str, str] = {}
+    vat_error: AccountingWriteError | None = None
+    try:
+        vat_evidence = resolve_historical_vat_account(
+            cursor,
+            management_schema=management_schema,
+            accounting_schema=accounting_schema,
+            company_id=company_id,
+            exercise=exercise,
+        )
+        vat_mapping = {"21": str(vat_evidence["account"])}
+    except AccountingWriteError as error:
+        vat_error = error
+
+    plan = build_ot_2110_accounting_preview(
+        header,
+        provider_name,
+        vat_mapping,
+    )
+    if vat_error is not None:
+        _append_accounting_plan_error(
+            plan,
+            code=vat_error.code,
+            field="historico_iva",
+            message=str(vat_error),
+            details=vat_error.details,
+        )
+
+    ctb_rows, linked_punteos = load_accounting_supporting_rows(
+        cursor,
+        factura_id=factura_id,
+        management_schema=management_schema,
+        lock_source=lock_source,
+    )
+
+    supporting_evidence, supporting_errors = validate_accounting_supporting_rows(
+        header,
+        ctb_rows,
+        linked_punteos,
+    )
+    for error in supporting_errors:
+        _append_accounting_plan_error(
+            plan,
+            code=str(error["code"]),
+            field=str(error["field"]),
+            message=str(error["message"]),
+            details=dict(error.get("details") or {}),
+        )
+
+    planned_accounts = sorted(
+        {
+            str(line.get("account") or "").strip()
+            for line in plan.get("lines", [])
+            if str(line.get("account") or "").strip()
+        }
+    )
+    if planned_accounts:
+        placeholders = ", ".join(["%s"] * len(planned_accounts))
+        cursor.execute(
+            f"""
+            SELECT NumeroCuenta AS account
+            FROM {accounting_schema}.cuentas
+            WHERE NumeroCuenta IN ({placeholders})
+            """,
+            tuple(planned_accounts),
+        )
+        existing_accounts = {
+            str(row.get("account") or "").strip() for row in cursor.fetchall()
+        }
+        missing_accounts = sorted(set(planned_accounts) - existing_accounts)
+        if missing_accounts:
+            _append_accounting_plan_error(
+                plan,
+                code="invalid_account",
+                field="cuentas",
+                message="Una cuenta prevista no existe en la contabilidad de TEST.",
+                details={"accounts": missing_accounts},
+            )
+
+    fingerprint = accounting_invoice_fingerprint(
+        header,
+        provider_name=provider_name,
+        provider_nif=provider_nif,
+        vat_evidence=vat_evidence,
+        plan=plan,
+        supporting_evidence=supporting_evidence,
+    )
+    return {
+        "header": header,
+        "provider_name": provider_name,
+        "provider_nif": provider_nif,
+        "vat_evidence": vat_evidence,
+        "supporting_evidence": supporting_evidence,
+        "plan": plan,
+        "fingerprint": fingerprint,
+    }
+
+
+def accounting_validation_response(
+    *,
+    factura_id: int,
+    payload: FacturaRecibidaAccountingRequest,
+    payload_hash: str,
+    context: Mapping[str, Any],
+) -> dict[str, Any]:
+    plan = dict(context["plan"])
+    eligible = bool(plan.get("eligible"))
+    return {
+        "ok": eligible,
+        "contract_version": 3,
+        "operation": "validate",
+        "request_id": str(payload.request_id),
+        "target_id": payload.target_id,
+        "dataset_epoch": str(payload.dataset_epoch),
+        "factura_id": factura_id,
+        "payload_hash": payload_hash,
+        "invoice_fingerprint": str(context["fingerprint"]),
+        "profile": str(plan.get("profile") or ACCOUNTING_ALGORITHM_VERSION),
+        "eligible": eligible,
+        "validations": {"errors": list(plan.get("errors") or []), "warnings": []},
+        "entries": list(plan.get("lines") or []),
+        "accounting": {
+            "requested": True,
+            "created": False,
+            "status": "pending" if eligible else "error",
+            "technical_id": None,
+            "visible_number": None,
+            "date": str(context["header"].get("FRR_fechactb") or "") or None,
+            "concept": context["header"].get("FRR_Concepto"),
+            "balanced": bool(plan.get("balanced")),
+            "total_debit": plan.get("total_debit"),
+            "total_credit": plan.get("total_credit"),
+        },
+        "vat_evidence": dict(context.get("vat_evidence") or {}),
+        "supporting_evidence": dict(context.get("supporting_evidence") or {}),
+        "readback_confirmed": False,
+    }
+
+
+def _raise_accounting_write_error(
+    error: AccountingWriteError,
+    *,
+    request_id: str,
+    target_id: str,
+    dataset_epoch: str,
+) -> None:
+    status_code = 409 if error.code == "accounting_lock_timeout" else 503
+    raise erp_http_error(
+        status_code,
+        code=error.code,
+        category="accounting",
+        user_message=str(error),
+        request_id=request_id,
+        target_id=target_id,
+        dataset_epoch=dataset_epoch,
+        retryable=error.code == "accounting_lock_timeout",
+        technical_details=error.details,
+    ) from error
+

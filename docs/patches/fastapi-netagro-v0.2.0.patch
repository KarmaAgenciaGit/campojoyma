+def reserve_material_identifiers(
+    cursor: Any,
+    selected: str,
+    *,
+    series: str,
+    line_count: int,
+    counter_user_id: int,
+    request_id: str,
+    target_id: str,
+    dataset_epoch: str,
+    locked_counter: Callable[..., int],
+    update_counter: Callable[..., None],
+) -> MaterialDeliveryIdentifiers:
+    """Lock, drift-check and advance all five ERP counters atomically."""
+
+    specs = (
+        ("header", "albMaterial", ""),
+        ("number", "albMaterial", series),
+        ("line", "albmateriallineas", ""),
+        ("warehouse_note", "ValeEnvases", ""),
+        ("warehouse_line", "ValeEnvases_Lineas", ""),
+    )
+    current: dict[str, int] = {}
+    for key, table_name, counter_type in specs:
+        current[key] = locked_counter(
+            cursor,
+            selected,
+            table_name=table_name,
+            counter_type=counter_type,
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+
+    cursor.execute(
+        f"""
+        SELECT
+            (SELECT COALESCE(MAX(AMA_idalb), 0) FROM {selected}.albmaterial)
+                AS max_header,
+            (SELECT COALESCE(MAX(AMA_numero), 0)
+             FROM {selected}.albmaterial WHERE AMA_serie = %(series)s)
+                AS max_number,
+            (SELECT COALESCE(MAX(AML_idlinea), 0)
+             FROM {selected}.albmateriallineas)
+                AS max_line,
+            (SELECT COALESCE(MAX(VEV_idvale), 0) FROM {selected}.valeenvases)
+                AS max_warehouse_note,
+            (SELECT COALESCE(MAX(VEL_id), 0) FROM {selected}.valeenvases_lineas)
+                AS max_warehouse_line
+        """,
+        {"series": series},
+    )
+    maxima = cursor.fetchone() or {}
+    drift: dict[str, Any] = {}
+    for key in current:
+        observed = int(maxima.get(f"max_{key}") or 0)
+        if current[key] < observed:
+            drift[key] = {"counter": current[key], "observed_max": observed}
+    if drift:
+        raise MaterialDeliveryError(
+            "counter_drift",
+            "La numeracion de albaranes no coincide con los registros de TEST.",
+            details={"counters": drift},
+        )
+
+    identifiers = MaterialDeliveryIdentifiers(
+        albaran_id=current["header"] + 1,
+        numero=current["number"] + 1,
+        first_line_id=current["line"] + 1,
+        vale_id=current["warehouse_note"] + 1,
+        first_vale_line_id=current["warehouse_line"] + 1,
+    )
+    final_values = {
+        "header": identifiers.albaran_id,
+        "number": identifiers.numero,
+        "line": current["line"] + line_count,
+        "warehouse_note": identifiers.vale_id,
+        "warehouse_line": current["warehouse_line"] + line_count,
+    }
+    exhausted = {
+        key: value
+        for key, value in final_values.items()
+        if value > ERP_SIGNED_INT_MAX
+    }
+    if exhausted:
+        raise MaterialDeliveryError(
+            "counter_exhausted",
+            "Un contador del albaran ha agotado el rango entero del ERP.",
+            details={"counters": exhausted},
+        )
+    for key, table_name, counter_type in specs:
+        update_counter(
+            cursor,
+            selected,
+            table_name=table_name,
+            counter_type=counter_type,
+            value=final_values[key],
+            user_id=counter_user_id,
+        )
+    return identifiers
+
+

+def fetch_material_delivery(
+    selected: str,
+    albaran_id: int,
+    *,
+    fetch_one_fn: Callable[[str, dict[str, Any] | None], dict[str, Any] | None],
+    fetch_all_fn: Callable[[str, dict[str, Any] | None], list[dict[str, Any]]],
+) -> dict[str, Any]:
+    params = {"albaran_id": albaran_id}
+    header_columns = ", ".join(
+        sorted(ALBMATERIAL_COLUMNS - {"AMA_FirmaApp"})
+    )
+    line_columns = ", ".join(sorted(ALBMATERIAL_LINE_COLUMNS))
+    warehouse_columns = ", ".join(
+        sorted(VALE_ENVASES_COLUMNS - {"VEV_Firma", "VEV_FirmaApp"})
+    )
+    warehouse_line_columns = ", ".join(sorted(VALE_ENVASES_LINE_COLUMNS))
+    albaran = fetch_one_fn(
+        f"""
+        SELECT {header_columns}
+        FROM {selected}.albmaterial
+        WHERE AMA_idalb = %(albaran_id)s
+        """,
+        params,
+    )
+    if albaran is None:
+        return {
+            "albaran": None,
+            "lineas": [],
+            "vale_envases": None,
+            "vale_envases_lineas": [],
+        }
+    lineas = fetch_all_fn(
+        f"""
+        SELECT {line_columns}
+        FROM {selected}.albmateriallineas
+        WHERE AML_idalb = %(albaran_id)s
+        ORDER BY AML_idlinea
+        """,
+        params,
+    )
+    vale_id = int(albaran.get("AMA_idvaleenvase") or 0)
+    vale = None
+    vale_lineas: list[dict[str, Any]] = []
+    if vale_id > 0:
+        vale_params = {"vale_id": vale_id}
+        vale = fetch_one_fn(
+            f"""
+            SELECT {warehouse_columns}
+            FROM {selected}.valeenvases
+            WHERE VEV_idvale = %(vale_id)s
+            """,
+            vale_params,
+        )
+        vale_lineas = fetch_all_fn(
+            f"""
+            SELECT {warehouse_line_columns}
+            FROM {selected}.valeenvases_lineas
+            WHERE VEL_idvale = %(vale_id)s
+            ORDER BY VEL_id
+            """,
+            vale_params,
+        )
+    return {
+        "albaran": albaran,
+        "lineas": lineas,
+        "vale_envases": vale,
+        "vale_envases_lineas": vale_lineas,
+    }
+
+
+def _equivalent(expected: Any, actual: Any) -> bool:
+    if expected is None or actual is None:
+        return expected is actual
+    if isinstance(expected, (int, Decimal)) or isinstance(actual, Decimal):
+        try:
+            return _as_decimal(expected, "readback") == _as_decimal(actual, "readback")
+        except MaterialDeliveryError:
+            return False
+    return str(expected) == str(actual)
+
+
+def verify_material_delivery_readback(
+    expected: Mapping[str, Any],
+    actual: Mapping[str, Any],
+) -> None:
+    table_specs = (
+        ("albaran", "AMA_idalb"),
+        ("lineas", "AML_idlinea"),
+        ("vale_envases", "VEV_idvale"),
+        ("vale_envases_lineas", "VEL_id"),
+    )
+    mismatches: list[dict[str, Any]] = []
+    for table_key, id_column in table_specs:
+        expected_value = expected[table_key]
+        actual_value = actual[table_key]
+        expected_rows = expected_value if isinstance(expected_value, list) else [expected_value]
+        actual_rows = actual_value if isinstance(actual_value, list) else [actual_value]
+        if len(expected_rows) != len(actual_rows):
+            mismatches.append(
+                {
+                    "table": table_key,
+                    "expected_count": len(expected_rows),
+                    "actual_count": len(actual_rows),
+                }
+            )
+            continue
+        expected_by_id = {int(row[id_column]): row for row in expected_rows if row}
+        actual_by_id = {int(row[id_column]): row for row in actual_rows if row}
+        if set(expected_by_id) != set(actual_by_id):
+            mismatches.append(
+                {
+                    "table": table_key,
+                    "expected_ids": sorted(expected_by_id),
+                    "actual_ids": sorted(actual_by_id),
+                }
+            )
+            continue
+        for row_id, expected_row in expected_by_id.items():
+            actual_row = actual_by_id[row_id]
+            for column, expected_column_value in expected_row.items():
+                if column not in actual_row or not _equivalent(
+                    expected_column_value,
+                    actual_row.get(column),
+                ):
+                    mismatches.append(
+                        {
+                            "table": table_key,
+                            "id": row_id,
+                            "column": column,
+                            "expected": str(expected_column_value),
+                            "actual": str(actual_row.get(column)),
+                        }
+                    )
+    if mismatches:
+        raise MaterialDeliveryError(
+            "material_readback_mismatch",
+            "El albaran no coincide con la lectura independiente del ERP.",
+            details={"mismatches": mismatches[:25]},
+        )

+def resolve_invoice_read_source(
+    *,
+    schema: str | None,
+    target_id: str | None,
+    dataset_epoch: UUID | None,
+    api_key: str | None,
+) -> tuple[
+    str,
+    str,
+    Callable[[str, dict[str, Any] | None], dict[str, Any] | None],
+    Callable[[str, dict[str, Any] | None], list[dict[str, Any]]],
+]:
+    """Resolve either the daily reader or the authenticated persistent target.
+
+    A v3 readback must never fall through to the daily clone: that clone has a
+    different lifecycle and cannot prove the result of a commit performed on
+    the persistent writer target.
+    """
+
+    if target_id is None and dataset_epoch is None:
+        selected_name = resolve_schema(schema)
+        return (
+            selected_name,
+            quote_identifier(selected_name),
+            fetch_one,
+            fetch_all,
+        )
+    if target_id is None or dataset_epoch is None:
+        raise erp_http_error(
+            422,
+            code="invalid_read_context",
+            category="validation",
+            user_message="La lectura ERP requiere target y generacion.",
+            target_id=target_id,
+            dataset_epoch=str(dataset_epoch) if dataset_epoch else None,
+        )
+    if schema is not None:
+        raise erp_http_error(
+            400,
+            code="invalid_read_context",
+            category="validation",
+            user_message="El destino ERP de lectura esta fijado por el servidor.",
+            target_id=target_id,
+            dataset_epoch=str(dataset_epoch),
+        )
+    verify_api_shared_secret(api_key)
+    runtime = runtime_identity()
+    epoch = str(dataset_epoch)
+    if runtime["target_id"] != target_id or runtime["dataset_epoch"] != epoch:
+        raise erp_http_error(
+            409,
+            code="stale_environment",
+            category="environment",
+            user_message="La lectura pertenece a otra copia o generacion del ERP.",
+            target_id=target_id,
+            dataset_epoch=epoch,
+            technical_details={
+                "current_target_id": runtime["target_id"],
+                "current_dataset_epoch": runtime["dataset_epoch"],
+            },
+        )
+    try:
+        assert_write_target_reader_service_ready()
+        selected_name = resolve_write_schema(None)
+    except RuntimeError as error:
+        raise erp_http_error(
+            503,
+            code="writer_not_ready",
+            category="environment",
+            user_message="El entorno ERP persistente no esta preparado para lectura.",
+            target_id=target_id,
+            dataset_epoch=epoch,
+        ) from error
+    return (
+        selected_name,
+        quote_write_identifier(selected_name),
+        fetch_write_target_one,
+        fetch_write_target_all,
+    )
+
+
+def effective_write_operation(
+    payload: FacturaRecibidaCreateRequest,
+    legacy_dry_run: bool | None,
+) -> Literal["validate", "commit"]:
+    if payload.contract_version == 3:
+        if payload.dry_run is not None or legacy_dry_run is not None:
+            raise erp_http_error(
+                422,
+                code="legacy_dry_run_not_allowed",
+                category="validation",
+                user_message=(
+                    "El contrato v3 utiliza las operaciones validate y commit."
+                ),
+                request_id=str(payload.request_id) if payload.request_id else None,
+                target_id=payload.target_id,
+                dataset_epoch=(
+                    str(payload.dataset_epoch) if payload.dataset_epoch else None
+                ),
+            )
+        if payload.operation is None:
+            raise erp_http_error(
+                422,
+                code="operation_required",
+                category="validation",
+                user_message="Indica si la operacion debe validar o confirmar el alta.",
+                request_id=str(payload.request_id) if payload.request_id else None,
+                target_id=payload.target_id,
+                dataset_epoch=(
+                    str(payload.dataset_epoch) if payload.dataset_epoch else None
+                ),
+            )
+        return payload.operation
+    effective_dry_run = (
+        payload.dry_run
+        if payload.dry_run is not None
+        else (legacy_dry_run if legacy_dry_run is not None else True)
+    )
+    return "validate" if effective_dry_run else "commit"
+

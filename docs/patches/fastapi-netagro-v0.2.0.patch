+def runtime_identity() -> dict[str, Any]:
+    target_id = os.getenv(NETAGRO_TARGET_ID_ENV, "").strip() or None
+    epoch_raw = os.getenv(NETAGRO_DATASET_EPOCH_ENV, "").strip()
+    try:
+        parsed_epoch = UUID(epoch_raw) if epoch_raw else None
+        dataset_epoch = (
+            str(parsed_epoch)
+            if parsed_epoch is not None and parsed_epoch.int != 0
+            else None
+        )
+    except ValueError:
+        dataset_epoch = None
+    snapshot_raw = os.getenv(NETAGRO_SNAPSHOT_AT_ENV, "").strip()
+    snapshot_at: str | None = None
+    if target_id is not None and dataset_epoch is not None and snapshot_raw:
+        try:
+            _, _, snapshot_at = normalize_idempotency_identity(
+                target_id,
+                dataset_epoch,
+                snapshot_raw,
+            )
+        except IdempotencyStoreUnavailable:
+            snapshot_at = None
+    counter_user_id = positive_int(
+        os.getenv(NETAGRO_COUNTER_USER_ID_ENV, "").strip()
+    )
+    material_counter_user_ready = (
+        counter_user_id is not None and counter_user_id <= ERP_SIGNED_INT_MAX
+    )
+    punteo_mapping_verified = os.getenv(
+        NETAGRO_PUNTEO_MAPPING_VERIFIED_ENV,
+        "false",
+    ).strip().casefold() in {"1", "true", "yes", "on"}
+    write_schema, write_schema_allowlist = write_schema_configuration()
+    write_endpoint_ready = write_target_endpoint_configured()
+    credentials_ready = writer_credentials_configured()
+    accounting_credentials_ready = accounting_writer_credentials_configured()
+    material_credentials_ready = material_writer_credentials_configured()
+    target_reader_ready = write_target_reader_credentials_configured()
+    accounting_test_target_gaps = accounting_test_target_configuration_gaps()
+    material_test_target_gaps = material_test_target_configuration_gaps()
+    missing: list[str] = []
+    if target_id is None:
+        missing.append(NETAGRO_TARGET_ID_ENV)
+    if dataset_epoch is None:
+        missing.append(NETAGRO_DATASET_EPOCH_ENV)
+    if snapshot_at is None:
+        missing.append(NETAGRO_SNAPSHOT_AT_ENV)
+    if (
+        write_schema is None
+        or write_schema_allowlist != frozenset({write_schema})
+        or write_schema == DB_DEFAULT_SCHEMA
+    ):
+        missing.append(DB_WRITE_DEFAULT_SCHEMA_ENV)
+    if not write_endpoint_ready:
+        missing.append(DB_WRITE_ENDPOINT_GATE)
+    if not os.getenv(DB_WRITE_EXPECTED_DATADIR_ENV, "").strip():
+        missing.append(DB_WRITE_EXPECTED_DATADIR_ENV)
+    if not credentials_ready:
+        missing.append(DB_WRITE_CREDENTIALS_GATE)
+    if not target_reader_ready:
+        missing.append(DB_WRITE_READ_CREDENTIALS_GATE)
+    if counter_user_id is None:
+        missing.append(NETAGRO_COUNTER_USER_ID_ENV)
+    if not punteo_mapping_verified:
+        missing.append(NETAGRO_PUNTEO_MAPPING_VERIFIED_ENV)
+    if not ALBMATERIAL_WRITES_ENABLED:
+        missing.append(ALBMATERIAL_WRITES_ENABLED_ENV)
+    configured_secret = os.getenv(NETAGRO_API_SHARED_SECRET_ENV, "")
+    if not shared_secret_is_operational(configured_secret):
+        missing.append(NETAGRO_API_SHARED_SECRET_ENV)
+    if not DB_WRITES_ENABLED:
+        write_mode = "disabled"
+    elif missing:
+        write_mode = "blocked"
+    else:
+        write_mode = "management"
+
+    accounting_missing: list[str] = []
+    common_accounting_gates = (
+        (target_id is None, NETAGRO_TARGET_ID_ENV),
+        (dataset_epoch is None, NETAGRO_DATASET_EPOCH_ENV),
+        (snapshot_at is None, NETAGRO_SNAPSHOT_AT_ENV),
+        (
+            write_schema is None
+            or write_schema_allowlist != frozenset({write_schema})
+            or write_schema == DB_DEFAULT_SCHEMA,
+            DB_WRITE_DEFAULT_SCHEMA_ENV,
+        ),
+        (not write_endpoint_ready, DB_WRITE_ENDPOINT_GATE),
+        (not target_reader_ready, DB_WRITE_READ_CREDENTIALS_GATE),
+        (
+            not shared_secret_is_operational(configured_secret),
+            NETAGRO_API_SHARED_SECRET_ENV,
+        ),
+    )
+    accounting_missing.extend(
+        gate for is_missing, gate in common_accounting_gates if is_missing
+    )
+    for gate in accounting_test_target_gaps:
+        if gate not in accounting_missing:
+            accounting_missing.append(gate)
+    if not accounting_credentials_ready:
+        accounting_missing.append(DB_ACCOUNT_WRITE_CREDENTIALS_GATE)
+    configured_account_schema = accounting_schema_for_company(1)
+    if (
+        configured_account_schema is None
+        or configured_account_schema not in DB_ALLOWED_ACCOUNT_SCHEMAS
+    ):
+        accounting_missing.append("DB_ACCOUNT_SCHEMA_BY_COMPANY")
+    if (
+        not ACCOUNTING_MECHANISM_CONFIGURATION_VALID
+        or ACCOUNTING_MECHANISM != "sql_test"
+    ):
+        accounting_missing.append(ACCOUNTING_MECHANISM_ENV)
+    if not ACCOUNTING_WRITES_ENABLED:
+        accounting_missing.append(ACCOUNTING_WRITES_ENABLED_ENV)
+    accounting_ready = ACCOUNTING_WRITES_ENABLED and not accounting_missing
+    if not ACCOUNTING_WRITES_ENABLED:
+        accounting_write_mode = "disabled"
+    elif accounting_missing:
+        accounting_write_mode = "blocked"
+    else:
+        accounting_write_mode = "sql_test"
+
+    material_missing: list[str] = []
+    common_material_gates = (
+        (target_id is None, NETAGRO_TARGET_ID_ENV),
+        (dataset_epoch is None, NETAGRO_DATASET_EPOCH_ENV),
+        (snapshot_at is None, NETAGRO_SNAPSHOT_AT_ENV),
+        (
+            write_schema is None
+            or write_schema_allowlist != frozenset({write_schema})
+            or write_schema == DB_DEFAULT_SCHEMA,
+            DB_WRITE_DEFAULT_SCHEMA_ENV,
+        ),
+        (not write_endpoint_ready, DB_WRITE_ENDPOINT_GATE),
+        (not target_reader_ready, DB_WRITE_READ_CREDENTIALS_GATE),
+        (
+            not os.getenv(DB_WRITE_EXPECTED_DATADIR_ENV, "").strip(),
+            DB_WRITE_EXPECTED_DATADIR_ENV,
+        ),
+        (not material_counter_user_ready, NETAGRO_COUNTER_USER_ID_ENV),
+        (
+            not shared_secret_is_operational(configured_secret),
+            NETAGRO_API_SHARED_SECRET_ENV,
+        ),
+    )
+    material_missing.extend(
+        gate for is_missing, gate in common_material_gates if is_missing
+    )
+    for gate in material_test_target_gaps:
+        if gate not in material_missing:
+            material_missing.append(gate)
+    if not material_credentials_ready:
+        material_missing.append(DB_MATERIAL_WRITE_CREDENTIALS_GATE)
+    if not ALBMATERIAL_CREATE_ENABLED:
+        material_missing.append(ALBMATERIAL_CREATE_ENABLED_ENV)
+    material_ready = ALBMATERIAL_CREATE_ENABLED and not material_missing
+    if not ALBMATERIAL_CREATE_ENABLED:
+        material_write_mode = "disabled"
+    elif material_missing:
+        material_write_mode = "blocked"
+    else:
+        material_write_mode = "material"
+    return {
+        "target_id": target_id,
+        "dataset_epoch": dataset_epoch,
+        "snapshot_at": snapshot_at,
+        "write_schema": write_schema,
+        "write_endpoint_configured": write_endpoint_ready,
+        "writer_credentials_configured": credentials_ready,
+        "accounting_writer_credentials_configured": (
+            accounting_credentials_ready
+        ),
+        "material_writer_credentials_configured": material_credentials_ready,
+        "accounting_test_target_configured": not accounting_test_target_gaps,
+        "material_test_target_configured": not material_test_target_gaps,
+        "write_target_reader_credentials_configured": target_reader_ready,
+        "counter_user_id_configured": counter_user_id is not None,
+        "punteo_mapping_verified": punteo_mapping_verified,
+        "albmaterial_writes_enabled": ALBMATERIAL_WRITES_ENABLED,
+        "albmaterial_create_enabled": ALBMATERIAL_CREATE_ENABLED,
+        "write_mode": write_mode,
+        "accounting_mode": ACCOUNTING_MECHANISM,
+        "accounting_write_mode": accounting_write_mode,
+        "accounting_writes_enabled": ACCOUNTING_WRITES_ENABLED,
+        "material_write_mode": material_write_mode,
+        "ready_for_commit": DB_WRITES_ENABLED and not missing,
+        "accounting_ready_for_commit": accounting_ready,
+        "material_ready_for_commit": material_ready,
+        "missing_configuration": missing,
+        "accounting_missing_configuration": accounting_missing,
+        "material_missing_configuration": material_missing,

+def _parsed_scoped_privileges(
+    grant_statements: Iterable[str],
+) -> tuple[tuple[str, frozenset[str] | None, str, str], ...]:
+    """Return normalized data privileges with their exact schema/table scope."""
+
+    parsed: list[tuple[str, frozenset[str] | None, str, str]] = []
+    for statement in grant_statements:
+        normalized = " ".join(str(statement).upper().split())
+        if not normalized.startswith("GRANT "):
+            continue
+        grant_head, separator, grant_tail = normalized.partition(" ON ")
+        if not separator:
+            continue
+        scope, to_separator, _ = grant_tail.partition(" TO ")
+        if not to_separator:
+            continue
+        normalized_scope = scope.replace("`", "").strip()
+        if "." not in normalized_scope:
+            continue
+        schema, table = normalized_scope.split(".", 1)
+        for privilege_spec in _split_privilege_specs(
+            grant_head.removeprefix("GRANT ")
+        ):
+            privilege = _base_privilege(privilege_spec)
+            if privilege == "USAGE":
+                continue
+            parsed.append(
+                (
+                    privilege,
+                    _privilege_columns(privilege_spec),
+                    schema,
+                    table,
+                )
+            )
+    return tuple(parsed)
+
+
+def missing_read_mariadb_grants(
+    grant_statements: Iterable[str],
+    schema_select_scopes: frozenset[str],
+    table_select_scopes: frozenset[tuple[str, str]] = frozenset(),
+) -> tuple[str, ...]:
+    """Require full SELECT coverage for every exposed schema or exact table."""
+
+    parsed = _parsed_scoped_privileges(grant_statements)
+    covered_schemas = {
+        schema
+        for privilege, columns, schema, table in parsed
+        if privilege == "SELECT" and columns is None and table == "*"
+    }
+    covered_tables = {
+        (schema, table)
+        for privilege, columns, schema, table in parsed
+        if privilege == "SELECT" and columns is None and table != "*"
+    }
+    issues = {
+        f"SELECT@SCHEMA_SCOPE:{schema.upper()}.*"
+        for schema in schema_select_scopes
+        if schema.upper() not in covered_schemas
+    }
+    issues.update(
+        f"SELECT@TABLE_SCOPE:{schema.upper()}.{table.upper()}"
+        for schema, table in table_select_scopes
+        if (schema.upper(), table.upper()) not in covered_tables
+    )
+    return tuple(sorted(issues))
+

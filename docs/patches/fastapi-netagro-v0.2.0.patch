+def idempotency_payload_hash(payload: FacturaRecibidaCreateRequest) -> str:
+    serialized = json.dumps(
+        payload.model_dump(mode="json", exclude={"dry_run"}),
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+

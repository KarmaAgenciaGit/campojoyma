+@app.post(
+    "/facturasrecibidas/{factura_id}/contabilizar",
+    response_model=FacturaRecibidaAccountingResponse,
+    responses={
+        401: ERP_ERROR_RESPONSES[401],
+        409: ERP_ERROR_RESPONSES[409],
+        422: ERP_ERROR_RESPONSES[422],
+        503: ERP_ERROR_RESPONSES[503],

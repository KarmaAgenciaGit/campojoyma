+def reserve_accounting_identifiers(
+    cursor: Any,
+    *,
+    accounting_schema: str,
+    exercise: int,
+    center_id: int,
+    entry_count: int,
+) -> dict[str, int]:
+    if entry_count <= 0:
+        raise AccountingWriteError(
+            "invalid_accounting_plan",
+            "El asiento no contiene apuntes.",
+        )
+    cursor.execute(
+        f"""
+        SELECT IdAsiento
+        FROM {accounting_schema}.asientos
+        ORDER BY IdAsiento DESC
+        LIMIT 1
+        FOR UPDATE
+        """
+    )
+    last_journal = cursor.fetchone()
+    cursor.execute(
+        f"""
+        SELECT Asiento
+        FROM {accounting_schema}.asientos
+        WHERE Ejercicio = %s AND Tipo = '0' AND IdCentro = %s
+        ORDER BY Asiento DESC
+        LIMIT 1
+        FOR UPDATE
+        """,
+        (exercise, center_id),
+    )
+    last_visible = cursor.fetchone()
+    cursor.execute(
+        f"""
+        SELECT IdApunte
+        FROM {accounting_schema}.asientolineas
+        ORDER BY IdApunte DESC
+        LIMIT 1
+        FOR UPDATE
+        """
+    )
+    last_entry = cursor.fetchone()
+    if not last_journal or not last_visible or not last_entry:
+        raise AccountingWriteError(
+            "accounting_sequence_unavailable",
+            "No se puede resolver la numeracion contable de TEST.",
+        )
+    reserved = {
+        "journal_id": int(last_journal["IdAsiento"]) + 1,
+        "visible_number": int(last_visible["Asiento"]) + 1,
+        "first_entry_id": int(last_entry["IdApunte"]) + 1,
+    }
+    highest = max(
+        reserved["journal_id"],
+        reserved["visible_number"],
+        reserved["first_entry_id"] + entry_count - 1,
+    )
+    if highest >= 2_147_483_647:
+        raise AccountingWriteError(
+            "accounting_sequence_exhausted",
+            "La numeracion contable de TEST no dispone de rango seguro.",
+        )
+    return reserved
+

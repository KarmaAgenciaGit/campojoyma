+class MaterialDeliveryError(RuntimeError):
+    def __init__(
+        self,
+        code: str,
+        message: str,
+        *,
+        details: Mapping[str, Any] | None = None,
+    ) -> None:
+        super().__init__(message)
+        self.code = code
+        self.details = dict(details or {})
+
+
+@dataclass(frozen=True)
+class MaterialDeliveryIdentifiers:
+    albaran_id: int
+    numero: int
+    first_line_id: int
+    vale_id: int
+    first_vale_line_id: int
+
+
+def material_delivery_request_marker(request_id: str) -> str:
+    """Return the immutable ERP marker used to reconcile one API request."""
+
+    try:
+        normalized_request_id = str(UUID(str(request_id)))
+    except (TypeError, ValueError) as error:
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "El request_id del albaran no es un UUID valido.",
+            details={"field": "request_id"},
+        ) from error
+    return MATERIAL_DELIVERY_REQUEST_MARKER_PREFIX + normalized_request_id
+
+
+def _as_decimal(value: Any, field: str) -> Decimal:
+    try:
+        parsed = Decimal(str(value))
+    except (InvalidOperation, TypeError, ValueError) as error:
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "El albaran contiene un valor numerico no valido.",
+            details={"field": field, "value": str(value)},
+        ) from error
+    if not parsed.is_finite():
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "El albaran contiene un valor numerico no finito.",
+            details={"field": field},
+        )
+    return parsed
+
+
+def _exact_quantized(value: Any, quantum: Decimal, field: str) -> Decimal:
+    parsed = _as_decimal(value, field)
+    quantized = parsed.quantize(quantum, rounding=ROUND_HALF_UP)
+    if parsed != quantized:
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "El albaran contiene mas decimales de los admitidos.",
+            details={
+                "field": field,
+                "value": str(value),
+                "maximum_decimal_places": abs(quantum.as_tuple().exponent),
+            },
+        )
+    return quantized
+
+
+def _canonical_date(value: Any, field: str) -> str:
+    if isinstance(value, date):
+        return value.isoformat()
+    try:
+        return date.fromisoformat(str(value)).isoformat()
+    except ValueError as error:
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "La fecha del albaran no es valida.",
+            details={"field": field},
+        ) from error
+
+
+def canonicalize_material_delivery(
+    cabecera: Mapping[str, Any],
+    lineas: Sequence[Mapping[str, Any]],
+) -> dict[str, Any]:
+    """Build the deterministic v3 payload used by validation and idempotency."""
+
+    reference = str(cabecera.get("referencia") or "").strip()
+    series = str(cabecera.get("serie") or "").strip().upper()
+    observations = str(cabecera.get("observaciones") or "").strip()
+    registration = str(cabecera.get("matricula") or "").strip().upper()
+    reviewed_duplicate_ids_raw = list(
+        cabecera.get("duplicados_revisados_ids") or []
+    )
+    try:
+        reviewed_duplicate_ids = [
+            int(value) for value in reviewed_duplicate_ids_raw
+        ]
+    except (TypeError, ValueError) as error:
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "Los duplicados revisados deben ser identificadores enteros.",
+            details={"field": "cabecera.duplicados_revisados_ids"},
+        ) from error
+    if (
+        any(value <= 0 for value in reviewed_duplicate_ids)
+        or reviewed_duplicate_ids != sorted(set(reviewed_duplicate_ids))
+        or len(reviewed_duplicate_ids) > MAX_MATERIAL_DUPLICATE_MATCHES
+    ):
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "Los duplicados revisados deben ser positivos, unicos y ordenados.",
+            details={"field": "cabecera.duplicados_revisados_ids"},
+        )
+    if not reference:
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "La referencia del proveedor es obligatoria.",
+            details={"field": "cabecera.referencia"},
+        )
+    if not series:
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "La serie del albaran es obligatoria.",
+            details={"field": "cabecera.serie"},
+        )
+    if len(series) > 5:
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "La serie normalizada excede la longitud admitida por el ERP.",
+            details={"field": "cabecera.serie"},
+        )
+    if len(registration) > 20:
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "La matricula normalizada excede la longitud admitida por el ERP.",
+            details={"field": "cabecera.matricula"},
+        )
+    if not lineas:
+        raise MaterialDeliveryError(
+            "invalid_material_payload",
+            "El albaran debe contener al menos una linea.",
+            details={"field": "lineas"},
+        )
+
+    expected_total = _exact_quantized(
+        cabecera.get("importe_esperado"),
+        MONEY_QUANTUM,
+        "cabecera.importe_esperado",
+    )
+    canonical_lines: list[dict[str, Any]] = []
+    calculated_total = ZERO_MONEY
+    for position, raw_line in enumerate(lineas, start=1):
+        quantity = _exact_quantized(
+            raw_line.get("cantidad"),
+            QUANTITY_QUANTUM,
+            f"lineas.{position - 1}.cantidad",
+        )
+        price = _exact_quantized(
+            raw_line.get("precio"),
+            PRICE_QUANTUM,
+            f"lineas.{position - 1}.precio",
+        )
+        discount = _exact_quantized(
+            raw_line.get("descuento", 0),
+            DISCOUNT_QUANTUM,
+            f"lineas.{position - 1}.descuento",
+        )
+        if quantity <= 0 or price <= 0 or discount < 0 or discount >= 100:
+            raise MaterialDeliveryError(
+                "invalid_material_payload",
+                "Cantidad, precio o descuento fuera del perfil homologado.",
+                details={"line": position},
+            )
+        net_unit_price = _exact_quantized(
+            price * (Decimal("1") - discount / Decimal("100")),
+            PRICE_QUANTUM,
+            f"lineas.{position - 1}.precio_neto",
+        )
+        line_amount = (quantity * net_unit_price).quantize(
+            MONEY_QUANTUM,
+            rounding=ROUND_HALF_UP,
+        )
+        calculated_total += line_amount
+        canonical_lines.append(
+            {
+                "position": position,
+                "material_id": int(raw_line["material_id"]),
+                "marca_id": int(raw_line.get("marca_id") or 0),
+                "cantidad": str(quantity),
+                "precio": str(price),
+                "descuento": str(discount),
+                "precio_neto": str(net_unit_price),
+                "importe": str(line_amount),
+                "referencia": str(raw_line.get("referencia") or "").strip(),
+                "observaciones": str(
+                    raw_line.get("observaciones") or ""
+                ).strip(),
+            }
+        )
+    calculated_total = calculated_total.quantize(MONEY_QUANTUM)
+
+    return {
+        "cabecera": {
+            "empresa_id": int(cabecera["empresa_id"]),
+            "campana": int(cabecera["campana"]),
+            "serie": series,
+            "fecha": _canonical_date(cabecera["fecha"], "cabecera.fecha"),
+            "acreedor_id": int(cabecera["acreedor_id"]),
+            "referencia": reference,
+            "observaciones": observations,
+            "centro_id": int(cabecera["centro_id"]),
+            "punto_venta_id": int(cabecera["punto_venta_id"]),
+            "almacen_id": int(cabecera["almacen_id"]),
+            "tipo_cp": "P",
+            "matricula": registration,
+            "importe_esperado": str(expected_total),
+            "importe_calculado": str(calculated_total),
+            "duplicado_confirmado_distinto": bool(
+                cabecera.get("duplicado_confirmado_distinto", False)
+            ),
+            "duplicados_revisados_ids": reviewed_duplicate_ids,
+        },
+        "lineas": canonical_lines,
+        "algorithm": MATERIAL_DELIVERY_ALGORITHM_VERSION,
+    }
+
+
+def material_delivery_payload_hash(canonical: Mapping[str, Any]) -> str:
+    serialized = json.dumps(
+        {
+            "operation": "POST /albaranes/material",
+            "contract_version": 3,
+            "payload": canonical,
+        },
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+
+
+def validate_material_total(canonical: Mapping[str, Any]) -> list[dict[str, Any]]:
+    header = canonical["cabecera"]
+    if _as_decimal(
+        header["importe_esperado"], "cabecera.importe_esperado"
+    ) == _as_decimal(header["importe_calculado"], "cabecera.importe_calculado"):
+        return []
+    return [
+        {
+            "field": "cabecera.importe_esperado",
+            "error": "does not match the exact server-calculated line total",
+            "expected": header["importe_calculado"],
+            "received": header["importe_esperado"],
+        }
+    ]
+
+
+def _material_placeholders(material_ids: Sequence[int]) -> tuple[str, dict[str, Any]]:
+    params = {
+        f"material_id_{position}": material_id
+        for position, material_id in enumerate(material_ids)
+    }
+    return ", ".join(f"%({key})s" for key in params), params
+
+
+def _mark_placeholders(mark_ids: Sequence[int]) -> tuple[str, dict[str, Any]]:
+    params = {
+        f"mark_id_{position}": mark_id
+        for position, mark_id in enumerate(mark_ids)
+    }
+    return ", ".join(f"%({key})s" for key in params), params
+
+
+def validate_material_master_references(
+    selected: str,
+    canonical: Mapping[str, Any],
+    *,
+    fetch_one_fn: Callable[[str, dict[str, Any] | None], dict[str, Any] | None],
+    fetch_all_fn: Callable[[str, dict[str, Any] | None], list[dict[str, Any]]],
+    lock_clause: str = "",
+) -> tuple[list[dict[str, Any]], dict[str, Any]]:
+    """Validate the exact ERP masters and return data needed for row derivation."""
+
+    header = canonical["cabecera"]
+    errors: list[dict[str, Any]] = []
+    provider = fetch_one_fn(
+        f"""
+        SELECT
+            ACR_Codigo AS provider_id,
+            ACR_Nombre AS provider_name,
+            ACR_Bloqueado AS blocked,
+            ACR_InactivoRGPD AS inactive_rgpd,
+            ACR_MensajeBloqueado AS blocked_message,
+            ACR_IdDivisa AS currency_id
+        FROM {selected}.acreedores
+        WHERE ACR_Codigo = %(provider_id)s
+        {lock_clause}
+        """,
+        {"provider_id": header["acreedor_id"]},
+    )
+    if provider is None:
+        errors.append(
+            {
+                "field": "cabecera.acreedor_id",
+                "error": "provider does not exist in the ERP creditor master",
+            }
+        )
+    else:
+        if str(provider.get("blocked") or "").strip().upper() != "N":
+            errors.append(
+                {
+                    "field": "cabecera.acreedor_id",
+                    "error": "provider is blocked in the ERP creditor master",
+                    "message": str(provider.get("blocked_message") or "").strip(),
+                }
+            )
+        if str(provider.get("inactive_rgpd") or "").strip().upper() != "N":
+            errors.append(
+                {
+                    "field": "cabecera.acreedor_id",
+                    "error": "provider is inactive in the ERP creditor master",
+                }
+            )
+        try:
+            currency_id = int(provider.get("currency_id"))
+        except (TypeError, ValueError):
+            currency_id = 0
+        if currency_id != 1:
+            errors.append(
+                {
+                    "field": "cabecera.acreedor_id",
+                    "error": "provider currency is outside the homologated base currency",
+                    "currency_id": currency_id,
+                }
+            )
+
+    series = fetch_one_fn(
+        f"""
+        SELECT SER_Id AS series_id
+        FROM {selected}.series
+        WHERE SER_tipo = 'M'
+          AND SER_ejercicio = %(campaign)s
+          AND SER_IdEmpresa = %(company_id)s
+          AND SER_idcentro = %(center_id)s
+          AND SER_Idpventa = %(point_of_sale_id)s
+          AND SER_serie = %(series)s
+        {lock_clause}
+        """,
+        {
+            "campaign": header["campana"],
+            "company_id": header["empresa_id"],
+            "center_id": header["centro_id"],
+            "point_of_sale_id": header["punto_venta_id"],
+            "series": header["serie"],
+        },
+    )
+    if series is None:
+        errors.append(
+            {
+                "field": "cabecera.serie",
+                "error": (
+                    "material series does not match campaign, company, center "
+                    "and point of sale"
+                ),
+            }
+        )
+
+    warehouse = fetch_one_fn(
+        f"""
+        SELECT AEV_Idalmacen AS warehouse_id, AEV_Nombre AS warehouse_name
+        FROM {selected}.almacenenvases
+        WHERE AEV_Idalmacen = %(warehouse_id)s
+        {lock_clause}
+        """,
+        {"warehouse_id": header["almacen_id"]},
+    )
+    if warehouse is None:
+        errors.append(
+            {
+                "field": "cabecera.almacen_id",
+                "error": "warehouse does not exist in the ERP package warehouse master",
+            }
+        )
+
+    material_ids = sorted(
+        {int(line["material_id"]) for line in canonical["lineas"]}
+    )
+    placeholders, material_params = _material_placeholders(material_ids)
+    material_rows = fetch_all_fn(
+        f"""
+        SELECT
+            e.ENV_idenvase AS material_id,
+            e.ENV_nombre AS material_name,
+            e.ENV_Activo AS active,
+            e.ENV_EntradasSN AS allows_entries,
+            e.ENV_Inventariable AS stock_managed,
+            e.ENV_NoGeneraVale AS skips_warehouse_note,
+            e.ENV_retornable AS returnable,
+            e.ENV_ImpuestoPlastico AS plastic_tax,
+            e.ENV_stockmarca AS stock_by_mark,
+            e.ENV_IdUnidadMedidaCompra AS purchase_unit_id,
+            e.ENV_FactorConversion AS conversion_factor,
+            CASE WHEN u.UME_id IS NULL THEN 0 ELSE 1 END AS purchase_unit_exists
+        FROM {selected}.envases e
+        LEFT JOIN {selected}.umedida u
+          ON u.UME_id = e.ENV_IdUnidadMedidaCompra
+        WHERE e.ENV_idenvase IN ({placeholders})
+        {lock_clause}
+        """,
+        material_params,
+    )
+    materials = {
+        int(row["material_id"]): row
+        for row in material_rows
+        if row.get("material_id") is not None
+    }
+    for material_id in material_ids:
+        material = materials.get(material_id)
+        field = next(
+            (
+                f"lineas.{position}.material_id"
+                for position, line in enumerate(canonical["lineas"])
+                if int(line["material_id"]) == material_id
+            ),
+            "lineas.material_id",
+        )
+        if material is None:
+            errors.append(
+                {"field": field, "error": "material does not exist in ERP"}
+            )
+            continue
+        invalid_flags: list[str] = []
+        required_yes = (
+            ("active", "ENV_Activo"),
+            ("allows_entries", "ENV_EntradasSN"),
+            ("stock_managed", "ENV_Inventariable"),
+        )
+        for key, label in required_yes:
+            if str(material.get(key) or "").strip().upper() != "S":
+                invalid_flags.append(label)
+        if str(material.get("skips_warehouse_note") or "").strip().upper() != "N":
+            invalid_flags.append("ENV_NoGeneraVale")
+        if str(material.get("returnable") or "N").strip().upper() not in {"", "N"}:
+            invalid_flags.append("ENV_retornable")
+        if str(material.get("plastic_tax") or "").strip().upper() != "N":
+            invalid_flags.append("ENV_ImpuestoPlastico")
+        if int(material.get("purchase_unit_exists") or 0) != 1:
+            invalid_flags.append("ENV_IdUnidadMedidaCompra")
+        factor = _as_decimal(
+            material.get("conversion_factor"),
+            f"material.{material_id}.conversion_factor",
+        )
+        if factor <= 0:
+            invalid_flags.append("ENV_FactorConversion")
+        if invalid_flags:
+            errors.append(
+                {
+                    "field": field,
+                    "error": "material is outside the homologated receipt profile",
+                    "invalid_master_fields": sorted(set(invalid_flags)),
+                }
+            )
+
+    requested_marks = sorted(
+        {
+            int(line["marca_id"])
+            for line in canonical["lineas"]
+            if int(line["marca_id"]) > 0
+        }
+    )
+    found_marks: set[int] = set()
+    if requested_marks:
+        mark_placeholders, mark_params = _mark_placeholders(requested_marks)
+        mark_rows = fetch_all_fn(
+            f"""
+            SELECT MAR_idmarca AS mark_id
+            FROM {selected}.marcas
+            WHERE MAR_idmarca IN ({mark_placeholders})
+            {lock_clause}
+            """,
+            mark_params,
+        )
+        found_marks = {
+            int(row["mark_id"])
+            for row in mark_rows
+            if row.get("mark_id") is not None
+        }
+    for position, line in enumerate(canonical["lineas"]):
+        material = materials.get(int(line["material_id"]))
+        mark_id = int(line["marca_id"])
+        stock_by_mark = (
+            str(material.get("stock_by_mark") or "").strip().upper()
+            if material
+            else ""
+        )
+        if mark_id and mark_id not in found_marks:
+            errors.append(
+                {
+                    "field": f"lineas.{position}.marca_id",
+                    "error": "mark does not exist in ERP",
+                }
+            )
+        elif stock_by_mark == "S" and mark_id == 0:
+            errors.append(
+                {
+                    "field": f"lineas.{position}.marca_id",
+                    "error": "mark is required because the material keeps stock by mark",
+                }
+            )
+        elif stock_by_mark != "S" and mark_id != 0:
+            errors.append(
+                {
+                    "field": f"lineas.{position}.marca_id",
+                    "error": "mark is not allowed for a material without stock by mark",
+                }
+            )
+
+    return errors, {
+        "provider": provider,
+        "series": series,
+        "warehouse": warehouse,
+        "materials": materials,
+        "marks": sorted(found_marks),
+    }
+

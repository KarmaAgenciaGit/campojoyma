+def _locked_counter(
+    cursor: Any,
+    selected: str,
+    *,
+    table_name: str,
+    counter_type: str,
+    request_id: str,
+    target_id: str,
+    dataset_epoch: str,
+) -> int:
+    cursor.execute(
+        f"""
+        SELECT CON_UltimoNumero
+        FROM {selected}.contadores
+        WHERE CON_NombreTabla = %(table_name)s
+          AND CON_TipoContador = %(counter_type)s
+        FOR UPDATE
+        """,
+        {"table_name": table_name, "counter_type": counter_type},
+    )
+    row = cursor.fetchone()
+    if row is None:
+        raise erp_http_error(
+            409,
+            code="counter_missing",
+            category="environment",
+            user_message="Netagro no tiene inicializado uno de los contadores necesarios.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+            technical_details={
+                "counter": {"table": table_name, "type": counter_type}
+            },
+        )
+    try:
+        value = int(row["CON_UltimoNumero"])
+    except (KeyError, TypeError, ValueError) as error:
+        raise erp_http_error(
+            409,
+            code="counter_drift",
+            category="environment",
+            user_message="El contador de Netagro no contiene un valor valido.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        ) from error
+    if value < 0:
+        raise erp_http_error(
+            409,
+            code="counter_drift",
+            category="environment",
+            user_message="El contador de Netagro contiene un valor invalido.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+    return value
+
+
+def _update_locked_counter(
+    cursor: Any,
+    selected: str,
+    *,
+    table_name: str,
+    counter_type: str,
+    value: int,
+    user_id: int,
+) -> None:
+    cursor.execute(
+        f"""
+        UPDATE {selected}.contadores
+        SET CON_UltimoNumero = %(value)s,
+            CON_IdUsuario = %(user_id)s
+        WHERE CON_NombreTabla = %(table_name)s
+          AND CON_TipoContador = %(counter_type)s
+        """,
+        {
+            "value": value,
+            "user_id": user_id,
+            "table_name": table_name,
+            "counter_type": counter_type,
+        },
+    )
+    if cursor.rowcount != 1:
+        raise RuntimeError("counter update did not affect exactly one row")
+
+
+def writer_audit_timestamp(cursor: Any) -> tuple[str, str]:
+    """Read one ERP-server timestamp for every row in the transaction."""
+
+    cursor.execute(
+        """
+        SELECT
+            DATE_FORMAT(CURRENT_DATE(), '%Y-%m-%d') AS audit_date,
+            DATE_FORMAT(CURRENT_TIME(), '%H:%i:%s') AS audit_time
+        """
+    )
+    row = cursor.fetchone() or {}
+    audit_date = str(row.get("audit_date") or "")
+    audit_time = str(row.get("audit_time") or "")
+    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", audit_date):
+        raise RuntimeError("ERP server returned an invalid audit date")
+    if not re.fullmatch(r"\d{2}:\d{2}:\d{2}", audit_time):
+        raise RuntimeError("ERP server returned an invalid audit time")
+    return audit_date, audit_time
+

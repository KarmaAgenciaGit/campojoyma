+def shared_secret_is_operational(value: str) -> bool:
+    if len(value) < NETAGRO_API_SHARED_SECRET_MIN_LENGTH:
+        return False
+    canonical = re.sub(r"[^a-z0-9]", "", value.casefold())
+    placeholder_markers = (
+        "changeme",
+        "replaceme",
+        "placeholder",
+        "example",
+        "yoursecret",
+    )
+    if any(marker in canonical for marker in placeholder_markers):
+        return False
+    frequencies = {character: value.count(character) for character in set(value)}
+    entropy_per_character = -sum(
+        (count / len(value)) * math.log2(count / len(value))
+        for count in frequencies.values()
+    )
+    return (
+        entropy_per_character * len(value)
+        >= NETAGRO_API_SHARED_SECRET_MIN_ENTROPY_BITS
+    )

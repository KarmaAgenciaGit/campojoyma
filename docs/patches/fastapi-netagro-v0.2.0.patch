+def factura_recibida_identity_joins_sql(selected: str) -> str:
+    """Resolve the FRR provider against the master used by its ERP circuit.
+
+    Netagro reuses the numeric FRR_idproveedor domain in two independent
+    masters. GE invoices are purchases from agricultores; every other observed
+    FRR type belongs to the acreedores circuit. The joins are mutually
+    exclusive so an equal numeric id in both masters can never leak the wrong
+    identity into the response.
+    """
+
+    return f"""
+        LEFT JOIN {selected}.agricultores ag
+            ON f.FRR_tipofactura = 'GE'
+           AND ag.AGR_Idagricultor = f.FRR_idproveedor
+        LEFT JOIN {selected}.acreedores a
+            ON COALESCE(f.FRR_tipofactura, '') <> 'GE'
+           AND a.ACR_Codigo = f.FRR_idproveedor
+    """
 
 

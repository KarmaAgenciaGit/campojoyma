diff --git app/idempotency_store.py app/idempotency_store.py
new file mode 100644
index 0000000..fa9d36c
--- /dev/null
+++ app/idempotency_store.py
@@ -0,0 +1,165 @@
+from __future__ import annotations
+
+import hashlib
+import os
+import sqlite3
+from pathlib import Path
+from typing import Any
+
+
+IDEMPOTENCY_ENV_VAR = "FACTURAS_IDEMPOTENCY_DB"
+IDEMPOTENCY_SCHEMA_VERSION = 1
+IDEMPOTENCY_TABLE = "factura_requests"
+IDEMPOTENCY_COLUMN_SPEC = (
+    ("request_id", "TEXT", 0, None, 1),
+    ("payload_hash", "TEXT", 1, None, 0),
+    ("status", "TEXT", 1, None, 0),
+    ("response_json", "TEXT", 0, None, 0),
+    ("error_text", "TEXT", 0, None, 0),
+    ("created_at", "TEXT", 1, None, 0),
+    ("updated_at", "TEXT", 1, None, 0),
+)
+IDEMPOTENCY_SCHEMA_FINGERPRINT = (
+    "f31e595b464ee28d238d7bc9f36a43eebe681e65cfb7964b381a839ca9b63c23"
+)
+
+
+class IdempotencyStoreUnavailable(RuntimeError):
+    """The preprovisioned idempotency store is missing or incompatible."""
+
+
+def configured_idempotency_path() -> Path:
+    raw_path = os.getenv(IDEMPOTENCY_ENV_VAR, "").strip()
+    if not raw_path:
+        raise IdempotencyStoreUnavailable(
+            f"{IDEMPOTENCY_ENV_VAR} is required when ERP writes are enabled"
+        )
+    path = Path(raw_path).expanduser()
+    if not path.is_absolute():
+        raise IdempotencyStoreUnavailable(
+            f"{IDEMPOTENCY_ENV_VAR} must contain an absolute path"
+        )
+    return path
+
+
+def open_idempotency_store(path: Path | None = None) -> sqlite3.Connection:
+    selected_path = path or configured_idempotency_path()
+    if not selected_path.is_file():
+        raise IdempotencyStoreUnavailable(
+            "the configured idempotency store does not exist; provision it during deployment"
+        )
+
+    uri = f"{selected_path.resolve().as_uri()}?mode=rw"
+    try:
+        connection = sqlite3.connect(uri, uri=True, timeout=10)
+    except sqlite3.Error as error:
+        raise IdempotencyStoreUnavailable(
+            "the configured idempotency store cannot be opened in read/write mode"
+        ) from error
+
+    connection.row_factory = sqlite3.Row
+    try:
+        version_row = connection.execute("PRAGMA user_version").fetchone()
+        version = int(version_row[0]) if version_row else 0
+        if version != IDEMPOTENCY_SCHEMA_VERSION:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store schema version is not supported"
+            )
+
+        table = connection.execute(
+            "SELECT name, sql FROM sqlite_master WHERE type = 'table' AND name = ?",
+            (IDEMPOTENCY_TABLE,),
+        ).fetchone()
+        if table is None:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store is missing its required table"
+            )
+
+        columns = tuple(
+            (
+                row["name"],
+                str(row["type"]).upper(),
+                int(row["notnull"]),
+                row["dflt_value"],
+                int(row["pk"]),
+            )
+            for row in connection.execute(
+                f'PRAGMA table_info("{IDEMPOTENCY_TABLE}")'
+            ).fetchall()
+        )
+        if columns != IDEMPOTENCY_COLUMN_SPEC:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store has an unexpected schema"
+            )
+
+        primary_indexes = [
+            row
+            for row in connection.execute(
+                f'PRAGMA index_list("{IDEMPOTENCY_TABLE}")'
+            ).fetchall()
+            if int(row["unique"]) == 1 and row["origin"] == "pk"
+        ]
+        if len(primary_indexes) != 1:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store is missing its primary key index"
+            )
+        primary_columns = tuple(
+            row["name"]
+            for row in connection.execute(
+                f'PRAGMA index_info("{primary_indexes[0]["name"]}")'
+            ).fetchall()
+        )
+        if primary_columns != ("request_id",):
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store has an unexpected primary key"
+            )
+
+        normalized_sql = " ".join(str(table["sql"]).split()).upper()
+        fingerprint = hashlib.sha256(normalized_sql.encode("utf-8")).hexdigest()
+        if fingerprint != IDEMPOTENCY_SCHEMA_FINGERPRINT:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store schema fingerprint does not match"
+            )
+    except IdempotencyStoreUnavailable:
+        connection.close()
+        raise
+    except sqlite3.Error as error:
+        connection.close()
+        raise IdempotencyStoreUnavailable(
+            "the idempotency store schema could not be validated"
+        ) from error
+
+    return connection
+
+
+def assert_idempotency_store_ready(path: Path | None = None) -> None:
+    connection: sqlite3.Connection | None = None
+    try:
+        connection = open_idempotency_store(path)
+        connection.execute("BEGIN IMMEDIATE")
+        connection.rollback()
+    except IdempotencyStoreUnavailable:
+        raise
+    except sqlite3.Error as error:
+        raise IdempotencyStoreUnavailable(
+            "the idempotency store is not writable"
+        ) from error
+    finally:
+        if connection is not None:
+            connection.close()
+
+
+def idempotency_store_status() -> dict[str, Any]:
+    try:
+        assert_idempotency_store_ready()
+    except IdempotencyStoreUnavailable as error:
+        return {
+            "ready": False,
+            "schema_version": None,
+            "error": str(error),
+        }
+    return {
+        "ready": True,
+        "schema_version": IDEMPOTENCY_SCHEMA_VERSION,
+        "error": None,
+    }

+
+def open_idempotency_store_read_only(
+    path: Path | None = None,
+    *,
+    target_id: str | None = None,
+    dataset_epoch: str | UUID | None = None,
+    snapshot_at: str | None = None,
+) -> sqlite3.Connection:
+    """Open and validate an existing v2 store without write capability."""
+
+    return _open_idempotency_store(
+        path,
+        target_id=target_id,
+        dataset_epoch=dataset_epoch,
+        snapshot_at=snapshot_at,
+        read_only=True,
+    )
+
+
+def assert_idempotency_store_quiescent(

+                    str(punteo.importe_factura)
+                    if punteo.importe_factura is not None
+                    else None
+                ),
+            },
+        )
+        source_count = int(actual.get("source_count") or 0) if actual else 0
+        linked_count = int(actual.get("linked_count") or 0) if actual else 0
+        amount_match_count = (
+            int(actual.get("amount_match_count") or 0) if actual else 0
+        )
+        if (
+            actual is None
+            or source_count == 0
+            or linked_count != source_count
+            or amount_match_count != source_count
+        ):

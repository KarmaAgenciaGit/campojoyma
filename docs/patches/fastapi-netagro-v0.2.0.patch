+def reserve_factura_counters(
+    cursor: Any,
+    selected: str,
+    *,
+    empresa_id: int,
+    ejercicio: int,
+    ctb_count: int,
+    counter_user_id: int,
+    request_id: str,
+    target_id: str,
+    dataset_epoch: str,
+) -> tuple[int, int, int | None]:
+    exercise_counter = (COUNTER_GLOBAL_INVOICE[0], f"{empresa_id}_{ejercicio}")
+    global_value = _locked_counter(
+        cursor,
+        selected,
+        table_name=COUNTER_GLOBAL_INVOICE[0],
+        counter_type=COUNTER_GLOBAL_INVOICE[1],
+        request_id=request_id,
+        target_id=target_id,
+        dataset_epoch=dataset_epoch,
+    )
+    number_value = _locked_counter(
+        cursor,
+        selected,
+        table_name=exercise_counter[0],
+        counter_type=exercise_counter[1],
+        request_id=request_id,
+        target_id=target_id,
+        dataset_epoch=dataset_epoch,
+    )
+    ctb_value: int | None = None
+    if ctb_count:
+        ctb_value = _locked_counter(
+            cursor,
+            selected,
+            table_name=COUNTER_CTB[0],
+            counter_type=COUNTER_CTB[1],
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        )
+
+    cursor.execute(
+        f"""
+        SELECT
+            COALESCE(MAX(FRR_id), 0) AS max_frr_id,
+            COALESCE(MAX(
+                CASE
+                    WHEN FRR_Idempresa = %(empresa_id)s
+                     AND FRR_ejercicio = %(ejercicio)s
+                    THEN FRR_numero
+                    ELSE NULL
+                END
+            ), 0) AS max_frr_numero
+        FROM {selected}.facturasrecibidas
+        """,
+        {"empresa_id": empresa_id, "ejercicio": ejercicio},
+    )
+    maxima = cursor.fetchone() or {}
+    max_frr_id = int(maxima.get("max_frr_id") or 0)
+    max_frr_numero = int(maxima.get("max_frr_numero") or 0)
+    drift: dict[str, Any] = {}
+    if global_value < max_frr_id:
+        drift["facturasrecibidas"] = {
+            "counter": global_value,
+            "observed_max": max_frr_id,
+        }
+    if number_value < max_frr_numero:
+        drift[exercise_counter[1]] = {
+            "counter": number_value,
+            "observed_max": max_frr_numero,
+        }
+    if ctb_count and ctb_value is not None:
+        cursor.execute(
+            f"""
+            SELECT COALESCE(MAX(FRC_id), 0) AS max_frc_id
+            FROM {selected}.facturasrecibidas_ctb
+            """
+        )
+        max_frc_id = int((cursor.fetchone() or {}).get("max_frc_id") or 0)
+        if ctb_value < max_frc_id:
+            drift["FacturasRecibidas_Ctb"] = {
+                "counter": ctb_value,
+                "observed_max": max_frc_id,
+            }
+    if drift:
+        raise erp_http_error(
+            409,
+            code="counter_drift",
+            category="environment",
+            user_message=(
+                "La numeracion de Netagro no es coherente con los registros actuales."
+            ),
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+            technical_details={"counters": drift},
+        )
+
+    generated_frr_id = global_value + 1
+    generated_numero = number_value + 1
+    first_frc_id = ctb_value + 1 if ctb_value is not None else None
+    _update_locked_counter(
+        cursor,
+        selected,
+        table_name=COUNTER_GLOBAL_INVOICE[0],
+        counter_type=COUNTER_GLOBAL_INVOICE[1],
+        value=generated_frr_id,
+        user_id=counter_user_id,
+    )
+    _update_locked_counter(
+        cursor,
+        selected,
+        table_name=exercise_counter[0],
+        counter_type=exercise_counter[1],
+        value=generated_numero,
+        user_id=counter_user_id,
+    )
+    if ctb_count and ctb_value is not None:
+        _update_locked_counter(
+            cursor,
+            selected,
+            table_name=COUNTER_CTB[0],
+            counter_type=COUNTER_CTB[1],
+            value=ctb_value + ctb_count,
+            user_id=counter_user_id,
+        )
+    return generated_frr_id, generated_numero, first_frc_id
+

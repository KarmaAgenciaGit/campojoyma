+def resolve_host_addresses(host: str) -> frozenset[str]:
+    """Resolve a host to canonical IPs; an empty set means fail closed."""
+
+    try:
+        records = socket.getaddrinfo(
+            host,
+            None,
+            type=socket.SOCK_STREAM,
+            proto=socket.IPPROTO_TCP,
+        )
+    except (OSError, UnicodeError):
+        return frozenset()
+    addresses: set[str] = set()
+    for record in records:
+        raw_address = str(record[4][0]).split("%", 1)[0]
+        try:
+            parsed_address = ipaddress.ip_address(raw_address)
+        except ValueError:
+            continue
+        if parsed_address.is_loopback:
+            addresses.add("loopback")
+        elif (
+            isinstance(parsed_address, ipaddress.IPv6Address)
+            and parsed_address.ipv4_mapped is not None
+        ):
+            addresses.add(parsed_address.ipv4_mapped.compressed)
+        else:
+            addresses.add(parsed_address.compressed)
+    return frozenset(addresses)
+

+def validate_punteos_payload(
+    selected: str,
+    punteos: list[PunteoSeleccionado],
+) -> tuple[list[dict[str, Any]], list[str]]:
+    errors: list[dict[str, Any]] = []
+    warnings: list[str] = []
+    seen_sources: set[tuple[str, int]] = set()
+    for index, punteo in enumerate(punteos):
+        source_key = (punteo.source_table, punteo.source_id)
+        if source_key in seen_sources:
+            errors.append(
+                {
+                    "field": f"punteos[{index}].source_id",
+                    "error": (
+                        "duplicate punteo in request: "
+                        f"{punteo.source_table}:{punteo.source_id}"
+                    ),
+                }
+            )
+            continue
+        seen_sources.add(source_key)
+        table_name, id_column, link_column, _ = PUNTEO_CONFIG[punteo.source_table]
+        source_amount_column = "AMA_importe" if punteo.source_table == "albmaterial" else "NULL"
+        row = fetch_one(
+            f"""
+            SELECT
+                {id_column} AS source_id,
+                {link_column} AS linked_invoice,
+                {source_amount_column} AS source_amount
+            FROM {selected}.{table_name}
+            WHERE {id_column} = %(source_id)s
+            """,
+            {"source_id": punteo.source_id},
+        )
+        if not row:
+            errors.append(
+                {
+                    "field": f"punteos[{index}].source_id",
+                    "error": f"punteo not found: {punteo.source_table}:{punteo.source_id}",
+                }
+            )
+            continue
+        linked_invoice = positive_int(row.get("linked_invoice"))
+        if linked_invoice is not None:
+            errors.append(
+                {
+                    "field": f"punteos[{index}].source_id",
+                    "error": (
+                        f"punteo already linked to invoice {linked_invoice}: "
+                        f"{punteo.source_table}:{punteo.source_id}"
+                    ),
+                }
+            )
+        if punteo.source_table == "albmaterial":
+            if punteo.importe_factura is not None:
+                source_amount = Decimal(str(row.get("source_amount") or 0))
+                requested_amount = Decimal(punteo.importe_factura)
+                if (
+                    not source_amount.is_finite()
+                    or not requested_amount.is_finite()
+                    or abs(requested_amount - source_amount) > Decimal("0.01")
+                ):
+                    errors.append(
+                        {
+                            "field": f"punteos[{index}].importe_factura",
+                            "error": (
+                                "albmaterial only accepts its full AMA_importe; "
+                                "partial or different allocation is not supported"
+                            ),
+                        }
+                    )
+            if not ALBMATERIAL_WRITES_ENABLED:
+                errors.append(
+                    {
+                        "field": f"punteos[{index}].source_table",
+                        "error": (
+                            "albmaterial write is disabled until the test API writer "
+                            "receives explicit SELECT and UPDATE grants"
+                        ),
+                    }
+                )
+    return errors, warnings
+

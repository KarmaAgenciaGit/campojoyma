+            "TotalFactura": _decimal(header["FRR_totalfac"]),
+            "Re1": ZERO,
+            "CuotaRe1": ZERO,
+            "Re2": ZERO,
+            "CuotaRe2": ZERO,
+            "Re3": ZERO,
+            "CuotaRe3": ZERO,
+            "Re4": ZERO,
+            "CuotaRe4": ZERO,
+            "idTipoIvaSoportado": 2110,
+            "EditarDatosSujeto": "",
+            "SerieDocumento": "",
+            "TipoIdentificacion": "",
+            "CodigoPais": "",
+            "FechaHora_AEAT": str(identifiers.get("audit_stamp") or ""),
+            "Descripcion_AEAT": concept,
+            "Ignorar_AEAT": "",
+            "FechaHoraSubida_AEAT": "",
+            "FechaDevengo": header["FRR_fechafactura"],
+            "CSV": "",
+            "PeriodoSii": "",
+            "Pendiente_AEAT": "",
+            "FechaHoraInversionSubida_AEAT": "",
+            "CuotaNoDeducible": ZERO,
+            "ContadorRegIva": 0,
+            "Base5": ZERO,
+            "Iva5": ZERO,
+            "Cuota5": ZERO,
+            "Re5": ZERO,
+            "CuotaRe5": ZERO,
+        }
+        for field, expected in expected_tax.items():
+            actual = tax.get(field)
+            if isinstance(expected, Decimal):
+                if _decimal(actual) != expected:
+                    issues.append(f"tax.{field}")
+            elif field == "FechaFac":
+                actual_text = str(actual)
+                expected_text = str(expected)
+                if actual_text not in {
+                    expected_text,
+                    f"{expected_text} 00:00:00",
+                }:
+                    issues.append(f"tax.{field}")
+            elif str(actual) != str(expected):
+                issues.append(f"tax.{field}")
+    if issues:
+        raise AccountingWriteError(
+            "accounting_readback_mismatch",
+            "El asiento se ha revertido porque su comprobacion no coincide.",
+            details={"issues": issues},
+        )
+    return {
+        "journal": dict(journal or {}),
+        "entries": [dict(row) for row in entries],
+        "tax": dict(tax or {}),
+        "balanced": True,
+    }

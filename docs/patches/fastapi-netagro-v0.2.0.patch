+def _nullable_decimal(value: Any) -> Decimal | None:
+    if value is None or value == "":
+        return None
+    return Decimal(str(value))
+
+
+def active_iva_signature(
+    row: dict[str, Any],
+) -> tuple[Decimal, ...] | None:
+    """Return the exact set of tax rates used by non-zero tax slots.
+
+    Repeated rates are intentionally collapsed: a regime depends on which tax
+    rates participate in the invoice, not on how many independent bases happen
+    to use the same rate. Inactive ERP slots never influence the signature.
+    """
+
+    active_rates: set[Decimal] = set()
+    for position in range(1, 6):
+        try:
+            base = _nullable_decimal(row.get(f"base{position}")) or Decimal("0")
+            quota = _nullable_decimal(row.get(f"cuota{position}")) or Decimal("0")
+        except (ArithmeticError, ValueError):
+            return None
+        if not base.is_finite() or not quota.is_finite():
+            return None
+        is_active = (
+            abs(base) >= REGIMEN_SUGGESTION_ACTIVE_AMOUNT_THRESHOLD
+            or abs(quota) >= REGIMEN_SUGGESTION_ACTIVE_AMOUNT_THRESHOLD
+        )
+        if not is_active:
+            continue
+        try:
+            percentage = _nullable_decimal(row.get(f"iva{position}"))
+        except (ArithmeticError, ValueError):
+            return None
+        if (
+            percentage is None
+            or not percentage.is_finite()
+            or percentage < 0
+            or percentage > 100
+        ):
+            return None
+        active_rates.add(percentage)
+    return tuple(sorted(active_rates))
+
+
+def build_regimen_suggestion(
+    *,
+    empresa_id: int,
+    proveedor_id: int,
+    proveedor_tipo: Literal["acreedor", "agricultor"],
+    requested_signature: tuple[Decimal, ...] | None,
+    historical_rows: list[dict[str, Any]],
+) -> RegimenSuggestionResponse:
+    circuit: Literal["GE", "no_GE"] = (
+        "GE" if proveedor_tipo == "agricultor" else "no_GE"
+    )
+    criteria = RegimenSuggestionCriteria(
+        min_historicos=REGIMEN_SUGGESTION_MIN_HISTORY,
+        min_confianza=REGIMEN_SUGGESTION_MIN_CONFIDENCE,
+        requiere_ganador_unico=True,
+        circuito_erp=circuit,
+        firma="tipos_iva_activos_ordenados_sin_duplicados",
+    )
+    filters = RegimenSuggestionFilters(
+        empresa_id=empresa_id,
+        proveedor_id=proveedor_id,
+        proveedor_tipo=proveedor_tipo,
+    )
+    if requested_signature is None:
+        return RegimenSuggestionResponse(
+            filtros=filters,
+            firma_iva=[],
+            total_historicos_evaluados=0,
+            total_historicos_coincidentes=0,
+            estado="firma_iva_invalida",
+            criterio=criteria,
+        )
+    if not requested_signature:
+        return RegimenSuggestionResponse(
+            filtros=filters,
+            firma_iva=[],
+            total_historicos_evaluados=0,
+            total_historicos_coincidentes=0,
+            estado="sin_firma_iva_activa",
+            criterio=criteria,
+        )
+
+    counts: dict[int, int] = {}
+    evaluated = 0
+    for row in historical_rows:
+        regimen_id = int(row.get("regimen_id") or 0)
+        if regimen_id <= 0:
+            continue
+        evaluated += 1
+        historical_signature = active_iva_signature(row)
+        if (
+            historical_signature is None
+            or historical_signature != requested_signature
+        ):
+            continue
+        counts[regimen_id] = counts.get(regimen_id, 0) + 1
+
+    total = sum(counts.values())
+    ranked = sorted(counts.items(), key=lambda item: (-item[1], item[0]))
+    count_models = [
+        RegimenSuggestionCount(
+            regimen_id=regimen_id,
+            usos=uses,
+            confianza=round(uses / total, 6),
+        )
+        for regimen_id, uses in ranked
+    ]
+    common = {
+        "filtros": filters,
+        "firma_iva": list(requested_signature),
+        "total_historicos_evaluados": evaluated,
+        "total_historicos_coincidentes": total,
+        "criterio": criteria,
+        "recuentos": count_models,
+    }
+    if total < REGIMEN_SUGGESTION_MIN_HISTORY:
+        return RegimenSuggestionResponse(
+            **common,
+            estado="sin_historial_suficiente",
+        )
+
+    top_regimen, top_uses = ranked[0]
+    has_unique_winner = len(ranked) == 1 or top_uses > ranked[1][1]
+    if not has_unique_winner:
+        return RegimenSuggestionResponse(
+            **common,
+            estado="ganador_no_unico",
+        )
+
+    raw_confidence = top_uses / total
+    confidence = round(raw_confidence, 6)
+    if raw_confidence < REGIMEN_SUGGESTION_MIN_CONFIDENCE:
+        return RegimenSuggestionResponse(
+            **common,
+            estado="confianza_insuficiente",
+        )
+
+    return RegimenSuggestionResponse(
+        **common,
+        estado="sugerido",
+        sugerencia=RegimenSuggestionValue(
+            regimen_id=top_regimen,
+            usos=top_uses,
+            confianza=confidence,
+            criterio="historico_mismo_proveedor_empresa_circuito_y_firma_iva",
+        ),
+    )
+
+
+def build_regimen_iva_profiles(
+    regimen_id: int,
+    aggregate_rows: list[dict[str, Any]],
+    *,
+    proveedor_id: int | None = None,
+    tipo_factura: str | None = None,
+) -> RegimenIvaProfilesResponse:
+    """Rank exact five-rate templates without deriving bases or quotas.
+
+    MariaDB reads base and quota values only to aggregate whether each stored
+    slot was active. Those amounts are never returned as a suggested value and
+    never used to rewrite the five stored percentages.
+    """
+
+    profiles_by_template: dict[
+        tuple[Decimal | None, ...],
+        dict[str, Any],
+    ] = {}
+    total = 0
+    for row in aggregate_rows:
+        percentages = tuple(
+            _nullable_decimal(row.get(f"iva{position}"))
+            for position in range(1, 6)
+        )
+        uses = int(row.get("usos") or 0)
+        if uses <= 0:
+            continue
+        aggregate = profiles_by_template.setdefault(
+            percentages,
+            {"usos": 0, "usos_activos": [0, 0, 0, 0, 0]},
+        )
+        aggregate["usos"] += uses
+        total += uses
+        for index in range(5):
+            position = index + 1
+            aggregate["usos_activos"][index] += int(
+                row.get(f"usos_activos{position}") or 0
+            )
+
+    ranked_templates = sorted(
+        profiles_by_template.items(),
+        key=lambda item: (
+            -int(item[1]["usos"]),
+            tuple(
+                (percentage is None, percentage or Decimal("0"))
+                for percentage in item[0]
+            ),
+        ),
+    )
+    profiles: list[RegimenIvaProfile] = []
+    for percentages, aggregate in ranked_templates:
+        uses = int(aggregate["usos"])
+        profiles.append(
+            RegimenIvaProfile(
+                porcentajes=list(percentages),
+                usos=uses,
+                confianza=round(uses / total, 6),
+                tramos=[
+                    RegimenIvaProfileTramo(
+                        posicion=index + 1,
+                        porcentaje=percentages[index],
+                        usos_activos=int(active_uses),
+                        confianza_activa=round(int(active_uses) / uses, 6),
+                    )
+                    for index, active_uses in enumerate(aggregate["usos_activos"])
+                ],
+            )
+        )
+
+    suggested: RegimenIvaSuggestedTemplate | None = None
+    state: Literal["sin_historial", "dominante", "ambiguo"]
+    ambiguous = False
+    if not profiles:
+        state = "sin_historial"
+    else:
+        top = profiles[0]
+        has_unique_leader = len(profiles) == 1 or top.usos > profiles[1].usos
+        is_dominant = (
+            has_unique_leader
+            and top.confianza >= REGIMEN_IVA_PROFILE_DOMINANCE_MIN_CONFIDENCE
+        )
+        if is_dominant:
+            state = "dominante"
+            suggested = RegimenIvaSuggestedTemplate(
+                porcentajes=top.porcentajes,
+                usos=top.usos,
+                confianza=top.confianza,
+                criterio="perfil_historico_dominante",
+            )
+        else:
+            state = "ambiguo"
+            ambiguous = True
+
+    return RegimenIvaProfilesResponse(
+        regimen_id=regimen_id,
+        filtros=RegimenIvaProfileFilters(
+            proveedor_id=proveedor_id,
+            tipo_factura=tipo_factura,
+        ),
+        total_facturas=total,
+        estado=state,
+        ambiguo=ambiguous,
+        criterio_dominancia=RegimenIvaDominanceCriteria(
+            min_confianza=REGIMEN_IVA_PROFILE_DOMINANCE_MIN_CONFIDENCE,
+            requiere_lider_unico=True,
+        ),
+        perfiles=profiles,
+        plantilla_sugerida=suggested,
+    )
+
+
+def expense_account_history_union_sql(
+    selected: str,
+    *,
+    proveedor_tipo: Literal["acreedor", "agricultor"],
+    include_fecha_desde: bool,
+    include_fecha_hasta: bool,
+) -> str:
+    """Unpivot the four real FRR expense slots using only static SQL fragments."""
+
+    circuit_clause = (
+        "f.FRR_tipofactura = 'GE'"
+        if proveedor_tipo == "agricultor"
+        else "COALESCE(TRIM(f.FRR_tipofactura), '') <> 'GE'"
+    )
+    date_clauses: list[str] = []
+    if include_fecha_desde:
+        date_clauses.append("f.FRR_fechafactura >= %(fecha_desde)s")
+    if include_fecha_hasta:
+        date_clauses.append("f.FRR_fechafactura <= %(fecha_hasta)s")
+    common_clauses = [
+        "f.FRR_Idempresa = %(empresa_id)s",
+        "f.FRR_idproveedor = %(proveedor_id)s",
+        circuit_clause,
+        *date_clauses,
+    ]
+
+    branches: list[str] = []
+    for position in range(1, 5):
+        account_field = f"f.FRR_ctagasto{position}"
+        amount_field = f"f.FRR_igasto{position}"
+        active_clauses = [
+            *common_clauses,
+            f"NULLIF(TRIM({account_field}), '') IS NOT NULL",
+            (
+                f"ABS(COALESCE({amount_field}, 0)) "
+                ">= %(importe_activo_minimo)s"
+            ),
+        ]
+        branches.append(
+            f"""
+            SELECT
+                f.FRR_id AS factura_id,
+                f.FRR_fechafactura AS fecha_factura,
+                TRIM({account_field}) AS cuenta,
+                {amount_field} AS importe
+            FROM {selected}.facturasrecibidas f
+            WHERE {" AND ".join(active_clauses)}
+            """.strip()
+        )
+    return "\nUNION ALL\n".join(branches)
+
+
+def build_cuentas_gasto_historicas_response(
+    *,
+    empresa_id: int,
+    proveedor_id: int,
+    proveedor_tipo: Literal["acreedor", "agricultor"],
+    fecha_desde: date | None,
+    fecha_hasta: date | None,
+    total_facturas_con_gasto: int,
+    aggregate_rows: list[dict[str, Any]],
+) -> CuentasGastoHistoricasResponse:
+    items: list[CuentaGastoHistoricaItem] = []
+    if total_facturas_con_gasto > 0:
+        for row in aggregate_rows:
+            account = str(row.get("cuenta") or "").strip()
+            uses = int(row.get("usos_facturas") or 0)
+            line_uses = int(row.get("usos_lineas") or 0)
+            if not account or uses <= 0 or line_uses <= 0:
+                continue
+            description = str(row.get("descripcion") or "").strip() or None
+            blocked = str(row.get("bloqueo_facturas") or "").strip() or None
+            items.append(
+                CuentaGastoHistoricaItem(
+                    cuenta=account,
+                    descripcion=description,
+                    usos_facturas=uses,
+                    usos_lineas=line_uses,
+                    porcentaje_facturas=round(
+                        uses / total_facturas_con_gasto,
+                        6,
+                    ),
+                    importe_neto_total=Decimal(
+                        str(row.get("importe_neto_total") or 0)
+                    ),
+                    importe_absoluto_total=Decimal(
+                        str(row.get("importe_absoluto_total") or 0)
+                    ),
+                    primera_fecha_uso=row.get("primera_fecha_uso"),
+                    ultima_fecha_uso=row.get("ultima_fecha_uso"),
+                    existe_en_catalogo=(
+                        int(row.get("existe_en_catalogo") or 0) == 1
+                    ),
+                    bloqueo_facturas=blocked,
+                )
+            )
+    return CuentasGastoHistoricasResponse(
+        filtros=CuentaGastoHistoricaFilters(
+            empresa_id=empresa_id,
+            proveedor_id=proveedor_id,
+            proveedor_tipo=proveedor_tipo,
+            fecha_desde=fecha_desde,
+            fecha_hasta=fecha_hasta,
+        ),
+        total_facturas_con_gasto=total_facturas_con_gasto,
+        items=items,
+    )
+
+
+def build_cuentas_iva_historicas_response(
+    *,
+    empresa_id: int,
+    ejercicio: int,
+    regimen_id: int,
+    tipo_factura: str,
+    porcentaje: Decimal,
+    proveedor_id: int | None,
+    aggregate_rows: list[dict[str, Any]],
+) -> CuentasIvaHistoricasResponse:
+    """Resolve a VAT account only when exact historical evidence dominates."""
+
+    criterio = CuentaIvaHistoricaCriterio(
+        min_facturas=VAT_ACCOUNT_HISTORY_MIN_INVOICES,
+        min_confianza=VAT_ACCOUNT_HISTORY_MIN_CONFIDENCE,
+        requiere_lider_unico=True,
+        origen="asientos_reales_enlazados_FR",
+        coincidencia_importe="apunte_472_unico_coincide_con_cuota_iva",
+    )
+    filtros = CuentaIvaHistoricaFilters(
+        empresa_id=empresa_id,
+        ejercicio=ejercicio,
+        regimen_id=regimen_id,
+        tipo_factura=tipo_factura,
+        porcentaje=porcentaje,
+        proveedor_id=proveedor_id,
+    )
+    ranked_rows: list[tuple[str, str | None, int]] = []
+    for row in aggregate_rows:
+        account = str(row.get("cuenta") or "").strip()
+        uses = int(row.get("usos_facturas") or 0)
+        if not account or uses <= 0:
+            continue
+        description = str(row.get("descripcion") or "").strip() or None
+        ranked_rows.append((account, description, uses))
+    ranked_rows.sort(key=lambda item: (-item[2], item[0]))
+
+    total = sum(row[2] for row in ranked_rows)
+    alternativas = (
+        [
+            CuentaIvaHistoricaAlternativa(
+                cuenta=account,
+                descripcion=description,
+                usos_facturas=uses,
+                confianza=round(uses / total, 6),
+            )
+            for account, description, uses in ranked_rows
+        ]
+        if total > 0
+        else []
+    )
+    common = {
+        "filtros": filtros,
+        "total_facturas": total,
+        "alternativas": alternativas,
+        "criterio": criterio,
+    }
+    if not alternativas:
+        return CuentasIvaHistoricasResponse(
+            **common,
+            estado="sin_historial",
+            usos_facturas=0,
+        )
+
+    top = alternativas[0]
+    has_unique_leader = (
+        len(alternativas) == 1
+        or top.usos_facturas > alternativas[1].usos_facturas
+    )
+    has_enough_history = total >= VAT_ACCOUNT_HISTORY_MIN_INVOICES
+    has_enough_confidence = (
+        top.usos_facturas / total >= VAT_ACCOUNT_HISTORY_MIN_CONFIDENCE
+    )
+    if not (
+        has_unique_leader
+        and has_enough_history
+        and has_enough_confidence
+    ):
+        return CuentasIvaHistoricasResponse(
+            **common,
+            estado="ambiguo",
+            usos_facturas=0,
+        )
+
+    return CuentasIvaHistoricasResponse(
+        **common,
+        estado="resuelta",
+        cuenta=top.cuenta,
+        descripcion=top.descripcion,
+        usos_facturas=top.usos_facturas,
+        confianza=top.confianza,
+    )

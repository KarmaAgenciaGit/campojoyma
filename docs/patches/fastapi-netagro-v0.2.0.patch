+    else:
+        raise IdempotencyStoreUnavailable(
+            "target_id, dataset_epoch and snapshot_at must be supplied together"
+        )
+
+    connection = open_idempotency_store_read_only(
+        path,
+        target_id=identity[0],
+        dataset_epoch=identity[1],
+        snapshot_at=identity[2],
+    )
+    try:
+        integrity = connection.execute("PRAGMA integrity_check").fetchone()
+        if integrity is None or str(integrity[0]).lower() != "ok":
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store failed its integrity check"
+            )
+        foreign_identity_count = int(
+            connection.execute(
+                """
+                SELECT COUNT(*)
+                FROM factura_requests
+                WHERE target_id <> ? OR dataset_epoch <> ?
+                """,
+                (identity[0], identity[1]),
+            ).fetchone()[0]
+        )
+        if foreign_identity_count:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store contains requests from another target or dataset epoch"
+            )
+        status_rows = connection.execute(
+            """
+            SELECT status, COUNT(*) AS request_count
+            FROM factura_requests
+            GROUP BY status
+            ORDER BY status
+            """
+        ).fetchall()
+        status_counts = {
+            str(row["status"]): int(row["request_count"])
+            for row in status_rows
+        }
+        unresolved_count = sum(
+            status_counts.get(status, 0)
+            for status in ("in_progress", "needs_reconciliation")
+        )
+        if unresolved_count:
+            raise IdempotencyStoreUnavailable(
+                "the idempotency store contains unresolved requests "
+                f"(in_progress={status_counts.get('in_progress', 0)}, "
+                "needs_reconciliation="
+                f"{status_counts.get('needs_reconciliation', 0)})"
+            )
+        return {
+            "ready": True,
+            "quiescent": True,
+            "schema_version": IDEMPOTENCY_SCHEMA_VERSION,
+            "target_id": identity[0],
+            "dataset_epoch": identity[1],
+            "snapshot_at": identity[2],
+            "request_count": sum(status_counts.values()),
+            "status_counts": status_counts,
+            "unresolved_count": 0,
+        }
+    except IdempotencyStoreUnavailable:
+        raise
+    except sqlite3.Error as error:
+        raise IdempotencyStoreUnavailable(
+            "the idempotency store quiescence check failed"
+        ) from error
+    finally:
+        connection.close()
+
+
+def assert_idempotency_store_ready(
+    path: Path | None = None,
+    *,
+    target_id: str | None = None,
+    dataset_epoch: str | UUID | None = None,
+    snapshot_at: str | None = None,
+) -> None:
+    connection: sqlite3.Connection | None = None
+    try:
+        connection = open_idempotency_store(
+            path,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+            snapshot_at=snapshot_at,
+        )
+        connection.execute("BEGIN IMMEDIATE")
+        connection.rollback()
+    except IdempotencyStoreUnavailable:
+        raise
+    except sqlite3.Error as error:
+        raise IdempotencyStoreUnavailable(
+            "the idempotency store is not writable"
+        ) from error
+    finally:
+        if connection is not None:
+            connection.close()
+
+
+def idempotency_store_status() -> dict[str, Any]:
+    try:
+        assert_idempotency_store_ready()
+    except IdempotencyStoreUnavailable as error:
+        return {
+            "ready": False,
+            "schema_version": None,
+            "error": str(error),
+        }
+    return {
+        "ready": True,
+        "schema_version": IDEMPOTENCY_SCHEMA_VERSION,
+        "error": None,
+    }
+
+
+def transition_stale_in_progress(
+    path: Path,
+    *,
+    target_id: str,
+    dataset_epoch: str | UUID,
+    snapshot_at: str,
+    minimum_age_seconds: int,
+    now: datetime | None = None,
+) -> list[dict[str, Any]]:
+    """Move orphaned commit claims into explicit reconciliation.
+
+    This is an administrative transition only. It never returns a request to
+    ``validated`` and never changes its target, epoch, circuit or payload hash.
+    """
+
+    if minimum_age_seconds < 600:
+        raise ValueError("minimum_age_seconds must be at least 600")
+    selected_now = now or datetime.now(timezone.utc)
+    if selected_now.tzinfo is None or selected_now.utcoffset() is None:
+        raise ValueError("now must be timezone-aware")
+    selected_now = selected_now.astimezone(timezone.utc)
+    cutoff = selected_now - timedelta(seconds=minimum_age_seconds)
+    identity = normalize_idempotency_identity(
+        target_id,
+        dataset_epoch,
+        snapshot_at,
+    )
+
+    connection = open_idempotency_store(
+        path,
+        target_id=identity[0],
+        dataset_epoch=identity[1],
+        snapshot_at=identity[2],
+    )
+    transitioned: list[dict[str, Any]] = []
+    try:
+        connection.execute("BEGIN IMMEDIATE")
+        rows = connection.execute(
+            """
+            SELECT *
+            FROM factura_requests
+            WHERE status = 'in_progress'
+              AND target_id = ?
+              AND dataset_epoch = ?
+            ORDER BY updated_at, request_id
+            """,
+            (identity[0], identity[1]),
+        ).fetchall()
+        for row in rows:
+            try:
+                updated_at = datetime.fromisoformat(str(row["updated_at"]))
+            except ValueError as error:
+                raise IdempotencyStoreUnavailable(
+                    "an in-progress request has an invalid updated_at timestamp"
+                ) from error
+            if updated_at.tzinfo is None or updated_at.utcoffset() is None:
+                raise IdempotencyStoreUnavailable(
+                    "an in-progress request has a timezone-naive updated_at timestamp"
+                )
+            if updated_at.astimezone(timezone.utc) > cutoff:
+                continue
+            previous_error = str(row["error_text"] or "").strip()
+            audit_error = (
+                "watchdog: orphaned in_progress moved to needs_reconciliation; "
+                f"observed_at={selected_now.isoformat()}; "
+                f"minimum_age_seconds={minimum_age_seconds}"
+            )
+            if previous_error:
+                audit_error += f"; previous_error={previous_error[:500]}"
+            cursor = connection.execute(
+                """
+                UPDATE factura_requests
+                SET status = 'needs_reconciliation',
+                    error_text = ?,
+                    updated_at = ?
+                WHERE request_id = ?
+                  AND payload_hash = ?
+                  AND target_id = ?
+                  AND dataset_epoch = ?
+                  AND circuit = ?
+                  AND phase = 'commit'
+                  AND status = 'in_progress'
+                  AND updated_at = ?
+                """,
+                (
+                    audit_error[:1000],
+                    selected_now.isoformat(),
+                    row["request_id"],
+                    row["payload_hash"],
+                    row["target_id"],
+                    row["dataset_epoch"],
+                    row["circuit"],
+                    row["updated_at"],
+                ),
+            )
+            if cursor.rowcount != 1:
+                raise sqlite3.IntegrityError(
+                    "watchdog could not transition exactly one stale request"
+                )
+            transitioned.append(
+                {
+                    "request_id": row["request_id"],
+                    "payload_hash": row["payload_hash"],
+                    "target_id": row["target_id"],
+                    "dataset_epoch": row["dataset_epoch"],
+                    "circuit": row["circuit"],
+                    "phase": row["phase"],
+                    "previous_status": row["status"],
+                    "status": "needs_reconciliation",
+                    "previous_updated_at": row["updated_at"],
+                    "updated_at": selected_now.isoformat(),
+                    "error_text": audit_error[:1000],
+                }
+            )
+        connection.commit()
+        return transitioned
+    except Exception:
+        connection.rollback()
+        raise
+    finally:
+        connection.close()

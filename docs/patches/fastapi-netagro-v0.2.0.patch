+                value=amount,
+                maximum=Decimal("9999999999.99"),
+            )
+            if error:
+                errors.append(error)
+        for dimension_field in V3_CTB_DIMENSION_FIELDS:
+            if row.get(dimension_field) not in (None, ""):
+                error = _strict_integer_error(
+                    field=f"ctb[{index}].{dimension_field}",
+                    value=row[dimension_field],
+                    minimum=1,
+                    maximum=2_147_483_647,
+                )
+                if error:
+                    errors.append(error)
+    return errors
+

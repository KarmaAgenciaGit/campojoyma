+def readback_factura_write(
+    *,
+    selected: str,
+    generated_frr_id: int,
+    generated_numero: int,
+    cabecera: dict[str, Any],
+    ctb_rows: list[dict[str, Any]],
+    punteos: list[PunteoSeleccionado],
+    request_id: str,
+) -> tuple[dict[str, Any], list[dict[str, Any]], list[dict[str, Any]]]:
+    """Read a committed write back through the read-only account or fail closed."""
+
+    created_factura = fetch_one(
+        f"SELECT * FROM {selected}.facturasrecibidas WHERE FRR_id = %(factura_id)s",
+        {"factura_id": generated_frr_id},
+    )
+    created_ctb = fetch_all(
+        f"""
+        SELECT *
+        FROM {selected}.facturasrecibidas_ctb
+        WHERE FRC_idfacturarecibida = %(factura_id)s
+        ORDER BY FRC_id
+        """,
+        {"factura_id": generated_frr_id},
+    )
+
+    issues: list[str] = []
+    expected_factura = {
+        **cabecera,
+        "FRR_id": generated_frr_id,
+        "FRR_numero": generated_numero,
+    }
+    if created_factura is None:
+        issues.append("factura_missing")
+    elif not _readback_row_contains(created_factura, expected_factura):
+        issues.append("factura_payload_mismatch")
+
+    if len(created_ctb) != len(ctb_rows):
+        issues.append("ctb_count_mismatch")
+    else:
+        for index, (actual, expected) in enumerate(zip(created_ctb, ctb_rows)):
+            if not _readback_row_contains(actual, expected):
+                issues.append(f"ctb_payload_mismatch:{index}")
+
+    readback_punteos: list[dict[str, Any]] = []
+    for punteo in punteos:
+        table_name, id_column, link_column, amount_column = PUNTEO_CONFIG[
+            punteo.source_table
+        ]
+        amount_matches = (
+            f"COALESCE(SUM(CASE WHEN {amount_column} = %(importe_factura)s "
+            "THEN 1 ELSE 0 END), 0)"
+            if amount_column is not None and punteo.importe_factura is not None
+            else "COUNT(*)"
+        )
+        actual = fetch_one(
+            f"""
+            SELECT
+                COUNT(*) AS source_count,
+                COALESCE(SUM(CASE WHEN {link_column} = %(factura_id)s
+                    THEN 1 ELSE 0 END), 0) AS linked_count,
+                {amount_matches} AS amount_match_count
+            FROM {selected}.{table_name}
+            WHERE {id_column} = %(source_id)s

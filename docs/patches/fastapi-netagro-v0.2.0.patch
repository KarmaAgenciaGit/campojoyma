+def ge_allocated_invoice_amount_sql(selected: str) -> str:
+    """Allocate the invoice base across linked GE receipts with exact cent totals.
+
+    Every row except the highest AEH_id receives its independently rounded
+    proportional amount. The final row absorbs the deterministic rounding
+    residue, so the sum is exactly the received invoice base.
+    """
+
+    proportional_amount = """
+        h.AEH_baseimponible
+        * allocation.importe_factura_total
+        / allocation.importe_origen_total
+    """
+    return f"""
+        CASE
+            WHEN ABS(allocation.importe_origen_total) > 0.005 THEN
+                CASE
+                    WHEN h.AEH_id = allocation.residue_source_id THEN
+                        ROUND(
+                            allocation.importe_factura_total
+                            - COALESCE(
+                                (
+                                    SELECT SUM(
+                                        ROUND(
+                                            h3.AEH_baseimponible
+                                            * allocation.importe_factura_total
+                                            / allocation.importe_origen_total,
+                                            2
+                                        )
+                                    )
+                                    FROM {selected}.albentrada_his h3
+                                    WHERE h3.AEH_idfacturafirme = h.AEH_idfacturafirme
+                                      AND h3.AEH_id <> allocation.residue_source_id
+                                ),
+                                0
+                            ),
+                            2
+                        )
+                    ELSE ROUND({proportional_amount}, 2)
+                END
+            ELSE h.AEH_baseimponible
+        END
+    """
+
+
+def factura_recibida_punteos_union_sql(selected: str) -> str:
+    """Read linked punteos, including the read-only GE history circuit.
+
+    The existing union is intentionally left unchanged because it is also used
+    by the selectable/write path. albentrada_his is historical evidence: it can
+    be displayed for an already linked invoice but must not become selectable
+    or writable without an explicit Netagro contract.
+    """
+
+    legacy_union = punteos_union_sql(selected)
+    ge_allocated_amount = ge_allocated_invoice_amount_sql(selected)
+    return f"""
+        SELECT
+            p.*,
+            NULL AS agricultor_id,
+            NULL AS agricultor_nombre,
+            NULL AS agricultor_nif,
+            CASE
+                WHEN p.acreedor_id IS NULL THEN NULL
+                ELSE 'acreedor'
+            END AS proveedor_tipo,
+            p.acreedor_id AS proveedor_id,
+            p.acreedor_nombre AS proveedor_nombre,
+            NULL AS proveedor_nif,
+            p.empresa AS empresa_id,
+            p.Importe AS importe_origen,
+            CASE
+                WHEN p.source_table IN ('albsalida_gastos', 'facturas_gastos')
+                    THEN p.`Importe P`
+                ELSE p.Importe
+            END AS importe_factura,
+            CASE
+                WHEN p.source_table IN ('albsalida_gastos', 'facturas_gastos')
+                    THEN 'importe_asignado_factura'
+                ELSE 'importe_origen'
+            END AS importe_metodo
+        FROM ({legacy_union}) p
+        WHERE p.factura_recibida_id = %(factura_id)s
+
+        UNION ALL
+
+        SELECT
+            CONCAT('AEH:', h.AEH_id) AS id_interno_estable,
+            'albentrada_his' AS source_table,
+            h.AEH_id AS source_id,
+            h.AEH_idfacturafirme AS factura_recibida_id,
+            'GE' AS Origen,
+            e.AEN_serie AS Serie,
+            e.AEN_albaran AS Albaran,
+            e.AEN_referencia AS Ref,
+            e.AEN_fecha AS Fecha,
+            CAST(0 AS DECIMAL(12,2)) AS `Importe P`,
+            {ge_allocated_amount} AS Importe,
+            'S' AS S,
+            'S' AS Ver,
+            h.AEH_idempresa AS empresa,
+            NULL AS acreedor_id,
+            NULL AS acreedor_nombre,
+            NULL AS gasto_id,
+            NULL AS gasto_nombre,
+            NULL AS cuenta_gasto,
+            h.AEH_idalbaran AS albaran_id,
+            (
+                SELECT COUNT(*)
+                FROM {selected}.albentrada_hislineas hl
+                WHERE hl.AHL_idalbhis = h.AEH_id
+            ) AS line_count,
+            h.AEH_idproveedor AS agricultor_id,
+            ag.AGR_Nombre AS agricultor_nombre,
+            ag.AGR_Nif AS agricultor_nif,
+            'agricultor' AS proveedor_tipo,
+            h.AEH_idproveedor AS proveedor_id,
+            ag.AGR_Nombre AS proveedor_nombre,
+            ag.AGR_Nif AS proveedor_nif,
+            h.AEH_idempresa AS empresa_id,
+            h.AEH_baseimponible AS importe_origen,
+            {ge_allocated_amount} AS importe_factura,
+            CASE
+                WHEN ABS(allocation.importe_origen_total) > 0.005
+                    THEN 'prorrateo_base_factura'
+                ELSE 'base_historica'
+            END AS importe_metodo
+        FROM {selected}.albentrada_his h
+        LEFT JOIN {selected}.albentrada e
+            ON e.AEN_idalbaran = h.AEH_idalbaran
+        LEFT JOIN {selected}.agricultores ag
+            ON ag.AGR_Idagricultor = h.AEH_idproveedor
+        JOIN (
+            SELECT
+                h2.AEH_idfacturafirme AS factura_recibida_id,
+                SUM(h2.AEH_baseimponible) AS importe_origen_total,
+                MAX(h2.AEH_id) AS residue_source_id,
+                MAX(
+                    COALESCE(f2.FRR_base1, 0)
+                    + COALESCE(f2.FRR_base2, 0)
+                    + COALESCE(f2.FRR_base3, 0)
+                    + COALESCE(f2.FRR_base4, 0)
+                    + COALESCE(f2.FRR_base5, 0)
+                ) AS importe_factura_total
+            FROM {selected}.albentrada_his h2
+            JOIN {selected}.facturasrecibidas f2
+                ON f2.FRR_id = h2.AEH_idfacturafirme
+            WHERE h2.AEH_idfacturafirme = %(factura_id)s
+            GROUP BY h2.AEH_idfacturafirme
+        ) allocation
+            ON allocation.factura_recibida_id = h.AEH_idfacturafirme
+        WHERE h.AEH_idfacturafirme = %(factura_id)s
+    """
+
+
+def attach_punteo_lines(
+    selected: str,
+    punteos: list[dict[str, Any]],
+    *,
+    fetch_all_fn: Callable[
+        [str, dict[str, Any] | None],
+        list[dict[str, Any]],
+    ]
+    | None = None,
+) -> list[dict[str, Any]]:
+    # Resolve the module global at call time so tests and operational wrappers
+    # can inject the correct reader without a definition-time function capture.
+    if fetch_all_fn is None:
+        fetch_all_fn = fetch_all
+    material_ids = sorted(
+        {
+            value
+            for item in punteos
+            if item.get("source_table") == "albmaterial"
+            if (value := positive_int(item.get("source_id"))) is not None
+        }
+    )
+    genero_history_ids = sorted(
+        {
+            value
+            for item in punteos
+            if item.get("source_table") == "albentrada_his"
+            if (value := positive_int(item.get("source_id"))) is not None
+        }
+    )
+    for item in punteos:
+        item["lines"] = []
+
+    material_grouped: dict[int, list[dict[str, Any]]] = {}
+    if material_ids:
+        params = {
+            f"material_id_{index}": value
+            for index, value in enumerate(material_ids)
+        }
+        placeholders = ", ".join(f"%({key})s" for key in params)
+        line_rows = fetch_all_fn(
+            f"""
+            SELECT
+                l.AML_idlinea AS line_id,
+                l.AML_idalb AS source_id,
+                l.AML_idmaterial AS article_id,
+                COALESCE(
+                    NULLIF(e.ENV_nombre, ''),
+                    NULLIF(l.AML_Observaciones, ''),
+                    CONCAT('Material ', l.AML_idmaterial)
+                ) AS description,
+                NULLIF(l.AML_referencia, '') AS reference,
+                l.AML_cantidad AS quantity,
+                l.AML_precio AS unit_price,
+                l.AML_preciocompra AS purchase_price,
+                l.AML_descuento AS discount_pct,
+                l.AML_ImportePlastico AS plastic_amount,
+                ROUND(
+                    (l.AML_cantidad * l.AML_precio)
+                    * (1 - l.AML_descuento / 100)
+                    + l.AML_ImportePlastico,
+                    2
+                ) AS amount,
+                NULLIF(l.AML_Observaciones, '') AS observations,
+                l.AML_umedida AS unit_id
+            FROM {selected}.albmateriallineas l
+            LEFT JOIN {selected}.envases e
+                ON e.ENV_idenvase = l.AML_idmaterial
+            WHERE l.AML_idalb IN ({placeholders})
+            ORDER BY l.AML_idalb, l.AML_idlinea
+            """,
+            params,
+        )
+        for row in line_rows:
+            source_id = positive_int(row.pop("source_id", None))
+            if source_id is None:
+                continue
+            bucket = material_grouped.setdefault(source_id, [])
+            row["position"] = len(bucket) + 1
+            bucket.append(row)
+
+    genero_grouped: dict[int, list[dict[str, Any]]] = {}
+    if genero_history_ids:
+        params = {
+            f"genero_history_id_{index}": value
+            for index, value in enumerate(genero_history_ids)
+        }
+        placeholders = ", ".join(f"%({key})s" for key in params)
+        line_rows = fetch_all_fn(
+            f"""
+            SELECT
+                l.AHL_id AS line_id,
+                l.AHL_idalbhis AS source_id,
+                l.AHL_idgenero AS article_id,
+                COALESCE(
+                    NULLIF(g.GEN_NombreGenero, ''),
+                    CONCAT('Genero ', l.AHL_idgenero)
+                ) AS description,
+                CASE
+                    WHEN l.AHL_muestreo = 0 THEN NULL
+                    ELSE CAST(l.AHL_muestreo AS CHAR)
+                END AS reference,
+                l.AHL_kilos AS quantity,
+                l.AHL_precio AS unit_price,
+                NULL AS purchase_price,
+                NULL AS discount_pct,
+                NULL AS plastic_amount,
+                l.AHL_importegenero AS amount,
+                NULL AS observations,
+                l.AHL_tipoprecio AS unit_id,
+                l.AHL_idenvase AS package_id,
+                NULLIF(env.ENV_nombre, '') AS package_name,
+                l.AHL_idcategoria AS category_id,
+                NULLIF(cat.CAE_categoria, '') AS category_name,
+                l.AHL_idtipocultivo AS crop_type_id,
+                NULLIF(TRIM(tcu.TCU_Abreviatura), '') AS crop_type_abbreviation,
+                NULLIF(tcu.TCU_Nombre, '') AS crop_type_name,
+                l.AHL_muestreo AS lot_id,
+                l.AHL_idlineaentrada AS entry_line_id,
+                l.AHL_palets AS pallets,
+                l.AHL_bultos AS packages,
+                l.AHL_piezas AS pieces,
+                l.AHL_kilosAg AS farmer_quantity
+            FROM {selected}.albentrada_hislineas l
+            LEFT JOIN {selected}.generos g
+                ON g.GEN_IdGenero = l.AHL_idgenero
+            LEFT JOIN {selected}.envases env
+                ON env.ENV_idenvase = l.AHL_idenvase
+            LEFT JOIN {selected}.categoriasentrada cat
+                ON cat.CAE_id = l.AHL_idcategoria
+            LEFT JOIN {selected}.tipocultivo tcu
+                ON tcu.TCU_Id = l.AHL_idtipocultivo
+            WHERE l.AHL_idalbhis IN ({placeholders})
+            ORDER BY l.AHL_idalbhis, l.AHL_id
+            """,
+            params,
+        )
+        for row in line_rows:
+            source_id = positive_int(row.pop("source_id", None))
+            if source_id is None:
+                continue
+            bucket = genero_grouped.setdefault(source_id, [])
+            row["position"] = len(bucket) + 1
+            bucket.append(row)
+
+    for item in punteos:
+        source_id = positive_int(item.get("source_id"))
+        if item.get("source_table") == "albmaterial" and source_id is not None:
+            item["lines"] = material_grouped.get(source_id, [])
+            item["line_count"] = len(item["lines"])
+        elif (
+            item.get("source_table") == "albentrada_his"
+            and source_id is not None
+        ):
+            item["lines"] = genero_grouped.get(source_id, [])
+            item["line_count"] = len(item["lines"])
+    return punteos
+
+
+def attach_material_lines(

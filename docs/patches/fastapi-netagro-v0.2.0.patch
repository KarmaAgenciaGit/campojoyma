+def accounting_idempotency_validation_response(
+    request_id: str,
+    payload_hash: str,
+    target_id: str,
+    dataset_epoch: str,
+    circuit: str,
+) -> dict[str, Any]:
+    try:
+        with closing(
+            get_idempotency_connection(
+                request_id=request_id,
+                target_id=target_id,
+                dataset_epoch=dataset_epoch,
+            )
+        ) as connection:
+            row = connection.execute(
+                "SELECT * FROM factura_requests WHERE request_id = ?",
+                (request_id,),
+            ).fetchone()
+            if row is None:
+                raise erp_http_error(
+                    409,
+                    code="validation_required",
+                    category="conflict",
+                    user_message="Valida la contabilizacion antes de confirmarla.",
+                    request_id=request_id,
+                    target_id=target_id,
+                    dataset_epoch=dataset_epoch,
+                )
+            _assert_idempotency_identity(
+                row,
+                request_id,
+                payload_hash,
+                target_id,
+                dataset_epoch,
+                circuit,
+            )
+            if row["status"] in {"validated", "completed"} and row["response_json"]:
+                return json.loads(row["response_json"])
+            return _idempotency_state_response_or_error(
+                row,
+                request_id,
+                target_id,
+                dataset_epoch,
+            )
+    except HTTPException:
+        raise
+    except (sqlite3.Error, json.JSONDecodeError) as error:
+        raise erp_http_error(
+            503,
+            code="idempotency_store_unavailable",
+            category="environment",
+            user_message="No se pudo comprobar la validacion contable.",
+            request_id=request_id,
+            target_id=target_id,
+            dataset_epoch=dataset_epoch,
+        ) from error
+

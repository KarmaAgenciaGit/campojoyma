+def accounting_invoice_fingerprint(
+    header: Mapping[str, Any],
+    *,
+    provider_name: str,
+    provider_nif: str,
+    vat_evidence: Mapping[str, Any],
+    plan: Mapping[str, Any],
+    supporting_evidence: Mapping[str, Any] | None = None,
+) -> str:
+    serialized = json.dumps(
+        {
+            "algorithm": ACCOUNTING_ALGORITHM_VERSION,
+            "header": {
+                field: header.get(field) for field in ACCOUNTING_FINGERPRINT_FIELDS
+            },
+            "provider": {"name": provider_name, "nif": provider_nif},
+            "vat_evidence": dict(vat_evidence),
+            "plan": dict(plan),
+            "supporting_evidence": dict(supporting_evidence or {}),
+        },
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+        default=str,
+    )
+    return hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+

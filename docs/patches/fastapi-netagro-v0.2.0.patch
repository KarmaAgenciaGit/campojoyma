+def _readback_value_matches(expected: Any, actual: Any) -> bool:
+    if expected is None or actual is None:
+        return expected is actual
+    if isinstance(expected, bool) or isinstance(actual, bool):
+        return expected == actual
+    numeric_types = (int, float, Decimal)
+    if isinstance(expected, numeric_types) or isinstance(actual, numeric_types):
+        try:
+            return Decimal(str(expected)) == Decimal(str(actual))
+        except (ArithmeticError, ValueError):
+            return False
+    return str(expected) == str(actual)
+
+
+def _readback_row_contains(
+    actual: dict[str, Any],
+    expected: dict[str, Any],
+) -> bool:
+    return all(
+        field in actual and _readback_value_matches(value, actual[field])
+        for field, value in expected.items()
+        if value is not None
+    )
+

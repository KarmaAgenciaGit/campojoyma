new file mode 100644
index 0000000..806cd36 100644
--- /dev/null
+++ app/accounting_preview.py
@@ -0,0 +1,601 @@
+from __future__ import annotations
+
+import re
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+from typing import Any, Mapping
+
+
+PROFILE = "ot_acreedor_2110_single_21_ctb_material"
+ZERO = Decimal("0")
+MONEY_QUANTUM = Decimal("0.01")
+EXPECTED_REGIME = 2110
+EXPECTED_VAT_RATE = Decimal("21")
+MAX_ACCOUNT_LENGTH = 11
+MAX_CONCEPT_LENGTH = 200
+
+
+def _error(code: str, field: str, message: str) -> dict[str, str]:
+    return {"code": code, "field": field, "message": message}
+
+
+def _decimal_value(
+    value: Any,
+    *,
+    field: str,
+    errors: list[dict[str, str]],
+) -> Decimal:
+    if value is None or value == "":
+        return ZERO
+    if isinstance(value, bool):
+        errors.append(
+            _error(
+                "invalid_decimal",
+                field,
+                "El valor debe ser un numero decimal finito.",
+            )
+        )
+        return ZERO
+    try:
+        parsed = Decimal(str(value).strip())
+    except (InvalidOperation, TypeError, ValueError):
+        errors.append(
+            _error(
+                "invalid_decimal",
+                field,
+                "El valor debe ser un numero decimal finito.",
+            )
+        )
+        return ZERO
+    if not parsed.is_finite():
+        errors.append(
+            _error(
+                "invalid_decimal",
+                field,
+                "El valor debe ser un numero decimal finito.",
+            )
+        )
+        return ZERO
+    return parsed
+
+
+def _positive_integer(value: Any) -> int | None:
+    if value is None or value == "" or isinstance(value, bool):
+        return None
+    try:
+        parsed = Decimal(str(value).strip())
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+    if not parsed.is_finite() or parsed <= 0 or parsed != parsed.to_integral_value():
+        return None
+    return int(parsed)
+
+
+def _raw_has_value(value: Any) -> bool:
+    if value is None or value is False:
+        return False
+    text = str(value).strip()
+    return bool(text and text != "0")
+
+
+def _account_value(
+    value: Any,
+    *,
+    field: str,
+    errors: list[dict[str, str]],
+    required: bool,
+) -> str | None:
+    if value is None or value == "":
+        if required:
+            errors.append(
+                _error(
+                    "missing_account",
+                    field,
+                    "La cuenta contable es obligatoria para este perfil.",
+                )
+            )
+        return None
+    if isinstance(value, bool):
+        normalized = ""
+    else:
+        normalized = str(value).strip()
+    if (
+        not normalized
+        or not re.fullmatch(rf"\d{{1,{MAX_ACCOUNT_LENGTH}}}", normalized)
+        or set(normalized) == {"0"}
+    ):
+        errors.append(
+            _error(
+                "invalid_account",
+                field,
+                "La cuenta debe contener entre 1 y 11 digitos y no puede ser cero.",
+            )
+        )
+        return None
+    return normalized
+
+
+def _resolved_vat_account(
+    historical_vat_accounts: Mapping[Any, Any] | Any,
+    errors: list[dict[str, str]],
+) -> str | None:
+    if not isinstance(historical_vat_accounts, Mapping):
+        errors.append(
+            _error(
+                "invalid_historical_vat_mapping",
+                "historical_vat_accounts",
+                "El mapa historico de cuentas de IVA no es valido.",
+            )
+        )
+        return None
+
+    matching_accounts: set[str] = set()
+    invalid_matching_account = False
+    for raw_rate, raw_account in historical_vat_accounts.items():
+        if isinstance(raw_rate, bool):
+            continue
+        try:
+            rate = Decimal(str(raw_rate).strip())
+        except (InvalidOperation, TypeError, ValueError):
+            continue
+        if not rate.is_finite() or rate != EXPECTED_VAT_RATE:
+            continue
+        candidate_errors: list[dict[str, str]] = []
+        account = _account_value(
+            raw_account,
+            field="historical_vat_accounts.21",
+            errors=candidate_errors,
+            required=True,
+        )
+        if account is None:
+            invalid_matching_account = True
+        else:
+            matching_accounts.add(account)
+
+    if invalid_matching_account:
+        errors.append(
+            _error(
+                "invalid_historical_vat_account",
+                "historical_vat_accounts.21",
+                "La cuenta historica resuelta para el IVA del 21 % no es valida.",
+            )
+        )
+    if not matching_accounts:
+        if not invalid_matching_account:
+            errors.append(
+                _error(
+                    "missing_historical_vat_account",
+                    "historical_vat_accounts.21",
+                    "No hay una cuenta historica resuelta para el IVA del 21 %.",
+                )
+            )
+        return None
+    if len(matching_accounts) != 1:
+        errors.append(
+            _error(
+                "ambiguous_historical_vat_account",
+                "historical_vat_accounts.21",
+                "El historico devuelve mas de una cuenta para el IVA del 21 %.",
+            )
+        )
+        return None
+    return next(iter(matching_accounts))
+
+
+def _cartera_fields_with_value(cabecera: Mapping[str, Any]) -> list[str]:
+    active: list[str] = []
+    flag = str(cabecera.get("FRR_GeneraCartera") or "").strip().upper()
+    if flag not in {"", "N", "0"}:
+        active.append("FRR_GeneraCartera")
+
+    if _raw_has_value(cabecera.get("FRR_CtaCartera")):
+        active.append("FRR_CtaCartera")
+    if _positive_integer(cabecera.get("FRR_idpago")) is not None:
+        active.append("FRR_idpago")
+    return active
+
+
+def _empty_preview(errors: list[dict[str, str]]) -> dict[str, Any]:
+    return {
+        "profile": PROFILE,
+        "eligible": False,
+        "errors": errors,
+        "lines": [],
+        "total_debit": None,
+        "total_credit": None,
+        "balanced": False,
+    }
+
+
+def build_ot_2110_accounting_preview(
+    cabecera: Mapping[str, Any],
+    proveedor_nombre: str,
+    historical_vat_accounts: Mapping[Any, Any],
+) -> dict[str, Any]:
+    """Build a pure accounting preview for the first homologated TEST profile.
+
+    The function has no database, environment or filesystem dependencies.  It
+    accepts an already-normalized invoice header and a VAT-account mapping that
+    was resolved by the caller.  Unsupported or inconsistent input is returned
+    as eligibility errors; no technical IDs are generated.
+    """
+
+    errors: list[dict[str, str]] = []
+    if not isinstance(cabecera, Mapping):
+        return _empty_preview(
+            [
+                _error(
+                    "invalid_header",
+                    "cabecera",
+                    "La cabecera normalizada no es valida.",
+                )
+            ]
+        )
+
+    invoice_type = str(cabecera.get("FRR_tipofactura") or "").strip().upper()
+    if invoice_type != "OT":
+        errors.append(
+            _error(
+                "unsupported_invoice_type",
+                "FRR_tipofactura",
+                "El primer perfil contable solo admite facturas OT de acreedor.",
+            )
+        )
+
+    if _positive_integer(cabecera.get("FRR_idregimen")) != EXPECTED_REGIME:
+        errors.append(
+            _error(
+                "unsupported_vat_regime",
+                "FRR_idregimen",
+                "El primer perfil contable solo admite el regimen 2110.",
+            )
+        )
+
+    requested_flag = str(cabecera.get("FRR_Contabilizar") or "").strip().upper()
+    if requested_flag not in {"", "N"} or _raw_has_value(
+        cabecera.get("FRR_IdAsientoNet")
+    ):
+        errors.append(
+            _error(
+                "already_accounted_or_requested",
+                "FRR_Contabilizar",
+                "La factura ya contiene una solicitud o referencia contable.",
+            )
+        )
+
+    provider_account = _account_value(
+        cabecera.get("FRR_idcuenta"),
+        field="FRR_idcuenta",
+        errors=errors,
+        required=True,
+    )
+
+    if isinstance(proveedor_nombre, bool):
+        normalized_provider_name = ""
+    else:
+        normalized_provider_name = str(proveedor_nombre or "").strip()
+    header_concept = str(cabecera.get("FRR_Concepto") or "").strip()
+    concept = header_concept or (
+        f"FRA. {normalized_provider_name}" if normalized_provider_name else ""
+    )
+    if not normalized_provider_name:
+        errors.append(
+            _error(
+                "missing_provider_name",
+                "proveedor_nombre",
+                "El nombre del proveedor es obligatorio.",
+            )
+        )
+    elif len(concept) > MAX_CONCEPT_LENGTH:
+        errors.append(
+            _error(
+                "concept_too_long",
+                "proveedor_nombre",
+                "El concepto contable supera los 200 caracteres.",
+            )
+        )
+
+    document = str(cabecera.get("FRR_numerofactura") or "").strip()
+    if not document:
+        errors.append(
+            _error(
+                "missing_invoice_document",
+                "FRR_numerofactura",
+                "El numero de factura es obligatorio para el documento contable.",
+            )
+        )
+
+    vat_slots: list[dict[str, Any]] = []
+    for position in range(1, 6):
+        base = _decimal_value(
+            cabecera.get(f"FRR_base{position}"),
+            field=f"FRR_base{position}",
+            errors=errors,
+        )
+        rate = _decimal_value(
+            cabecera.get(f"FRR_iva{position}"),
+            field=f"FRR_iva{position}",
+            errors=errors,
+        )
+        amount = _decimal_value(
+            cabecera.get(f"FRR_cuota{position}"),
+            field=f"FRR_cuota{position}",
+            errors=errors,
+        )
+        if base != ZERO or amount != ZERO:
+            vat_slots.append(
+                {
+                    "position": position,
+                    "base": base,
+                    "rate": rate,
+                    "amount": amount,
+                }
+            )
+
+    active_vat: dict[str, Any] | None = None
+    if len(vat_slots) != 1:
+        errors.append(
+            _error(
+                "unsupported_vat_slot_count",
+                "desglose_iva",
+                "El primer perfil contable exige exactamente un tramo de IVA activo.",
+            )
+        )
+    else:
+        active_vat = vat_slots[0]
+        if active_vat["position"] != 1:
+            errors.append(
+                _error(
+                    "unsupported_vat_slot_position",
+                    "desglose_iva",
+                    "El primer perfil contable exige el tramo activo en la posicion 1.",
+                )
+            )
+        if active_vat["base"] <= ZERO or active_vat["amount"] <= ZERO:
+            errors.append(
+                _error(
+                    "unsupported_non_positive_vat",
+                    f"FRR_base{active_vat['position']}",
+                    "La base y la cuota de IVA deben ser positivas.",
+                )
+            )
+        if active_vat["rate"] != EXPECTED_VAT_RATE:
+            errors.append(
+                _error(
+                    "unsupported_vat_rate",
+                    f"FRR_iva{active_vat['position']}",
+                    "El primer perfil contable solo admite IVA del 21 %.",
+                )
+            )
+        expected_quota = (
+            active_vat["base"] * EXPECTED_VAT_RATE / Decimal("100")
+        ).quantize(MONEY_QUANTUM, rounding=ROUND_HALF_UP)
+        if active_vat["amount"].quantize(MONEY_QUANTUM) != expected_quota:
+            errors.append(
+                _error(
+                    "vat_amount_mismatch",
+                    f"FRR_cuota{active_vat['position']}",
+                    "La cuota no coincide con el 21 % de la base redondeado a centimos.",
+                )
+            )
+
+    expense_slots: list[dict[str, Any]] = []
+    for position in range(1, 5):
+        raw_account = cabecera.get(f"FRR_ctagasto{position}")
+        amount = _decimal_value(
+            cabecera.get(f"FRR_igasto{position}"),
+            field=f"FRR_igasto{position}",
+            errors=errors,
+        )
+        if _raw_has_value(raw_account) or amount != ZERO:
+            account = _account_value(
+                raw_account,
+                field=f"FRR_ctagasto{position}",
+                errors=errors,
+                required=True,
+            )
+            expense_slots.append(
+                {"position": position, "account": account, "amount": amount}
+            )
+
+    active_expense: dict[str, Any] | None = None
+    if len(expense_slots) != 1:
+        errors.append(
+            _error(
+                "unsupported_expense_count",
+                "desglose_gastos",
+                "El primer perfil contable exige exactamente un gasto.",
+            )
+        )
+    else:
+        active_expense = expense_slots[0]
+        if active_expense["amount"] <= ZERO:
+            errors.append(
+                _error(
+                    "unsupported_non_positive_expense",
+                    f"FRR_igasto{active_expense['position']}",
+                    "El importe del gasto debe ser positivo.",
+                )
+            )
+
+    retention_values = {
+        field: _decimal_value(cabecera.get(field), field=field, errors=errors)
+        for field in ("FRR_baseret", "FRR_ret", "FRR_cuotaret")
+    }
+    if any(value != ZERO for value in retention_values.values()) or _raw_has_value(
+        cabecera.get("FRR_ClaveIRPF")
+    ):
+        errors.append(
+            _error(
+                "unsupported_retention",
+                "retencion",
+                "El primer perfil contable no admite retenciones.",
+            )
+        )
+
+    non_deductible = _decimal_value(
+        cabecera.get("FRR_CuotaNoDeducible"),
+        field="FRR_CuotaNoDeducible",
+        errors=errors,
+    )
+    if non_deductible != ZERO:
+        errors.append(
+            _error(
+                "unsupported_non_deductible_vat",
+                "FRR_CuotaNoDeducible",
+                "El primer perfil contable no admite cuota no deducible.",
+            )
+        )
+
+    suplido = _decimal_value(
+        cabecera.get("FRR_ImpSuplido"),
+        field="FRR_ImpSuplido",
+        errors=errors,
+    )
+    if suplido != ZERO or _raw_has_value(cabecera.get("FRR_CtaSuplido")):
+        errors.append(
+            _error(
+                "unsupported_suplido",
+                "FRR_ImpSuplido",
+                "El primer perfil contable no admite suplidos.",
+            )
+        )
+
+    cartera_fields = _cartera_fields_with_value(cabecera)
+    if cartera_fields:
+        errors.append(
+            _error(
+                "unsupported_cartera",
+                "cartera",
+                "El primer perfil contable no admite cartera ni vencimientos: "
+                + ", ".join(cartera_fields),
+            )
+        )
+
+    total = _decimal_value(
+        cabecera.get("FRR_totalfac"),
+        field="FRR_totalfac",
+        errors=errors,
+    )
+    if total <= ZERO:
+        errors.append(
+            _error(
+                "unsupported_non_positive_total",
+                "FRR_totalfac",
+                "El total de la factura debe ser positivo.",
+            )
+        )
+
+    vat_account = _resolved_vat_account(historical_vat_accounts, errors)
+
+    if active_vat is not None and active_expense is not None:
+        if active_expense["amount"].quantize(MONEY_QUANTUM) != active_vat[
+            "base"
+        ].quantize(MONEY_QUANTUM):
+            errors.append(
+                _error(
+                    "expense_base_mismatch",
+                    f"FRR_igasto{active_expense['position']}",
+                    "El gasto debe coincidir con la base del unico tramo de IVA.",
+                )
+            )
+        expected_total = (active_vat["base"] + active_vat["amount"]).quantize(
+            MONEY_QUANTUM
+        )
+        if total.quantize(MONEY_QUANTUM) != expected_total:
+            errors.append(
+                _error(
+                    "invoice_total_mismatch",
+                    "FRR_totalfac",
+                    "El total debe coincidir con la suma de base y cuota.",
+                )
+            )
+
+    resolved_accounts = [
+        account
+        for account in (
+            provider_account,
+            active_expense.get("account") if active_expense else None,
+            vat_account,
+        )
+        if account is not None
+    ]
+    if len(resolved_accounts) != len(set(resolved_accounts)):
+        errors.append(
+            _error(
+                "account_role_collision",
+                "cuentas",
+                "Proveedor, gasto e IVA deben usar cuentas contables distintas.",
+            )
+        )
+
+    if errors:
+        return _empty_preview(errors)
+
+    if (
+        active_vat is None
+        or active_expense is None
+        or provider_account is None
+        or active_expense["account"] is None
+        or vat_account is None
+    ):
+        return _empty_preview(
+            [
+                _error(
+                    "incomplete_accounting_plan",
+                    "cabecera",
+                    "No se ha podido formar el asiento esperado de manera completa.",
+                )
+            ]
+        )
+
+    expense_amount = active_expense["amount"].quantize(MONEY_QUANTUM)
+    vat_amount = active_vat["amount"].quantize(MONEY_QUANTUM)
+    invoice_total = total.quantize(MONEY_QUANTUM)
+    lines = [
+        {
+            "role": "supplier",
+            "account": provider_account,
+            "concept": concept,
+            "document": document,
+            "debit": ZERO.quantize(MONEY_QUANTUM),
+            "credit": invoice_total,
+        },
+        {
+            "role": "expense",
+            "account": active_expense["account"],
+            "concept": concept,
+            "document": document,
+            "debit": expense_amount,
+            "credit": ZERO.quantize(MONEY_QUANTUM),
+        },
+        {
+            "role": "supported_vat",
+            "account": vat_account,
+            "concept": concept,
+            "document": document,
+            "debit": vat_amount,
+            "credit": ZERO.quantize(MONEY_QUANTUM),
+        },
+    ]
+    total_debit = sum((line["debit"] for line in lines), ZERO).quantize(MONEY_QUANTUM)
+    total_credit = sum((line["credit"] for line in lines), ZERO).quantize(MONEY_QUANTUM)
+    if total_debit != total_credit:
+        return _empty_preview(
+            [
+                _error(
+                    "unbalanced_accounting_plan",
+                    "lineas",
+                    "La previsualizacion contable no cuadra.",
+                )
+            ]
+        )
+
+    return {
+        "profile": PROFILE,
+        "eligible": True,
+        "errors": [],
+        "lines": lines,
+        "total_debit": total_debit,
+        "total_credit": total_credit,
+        "balanced": True,
+    }
diff --git app/accounting_writer.py app/accounting_writer.py

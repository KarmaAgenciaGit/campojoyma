+            )
+        _assert_idempotency_identity(
+            row,
+            request_id,
+            payload_hash,
+            target_id,
+            dataset_epoch,
+            circuit,
+        )
+        if row["status"] == "completed" and row["response_json"]:
+            return json.loads(row["response_json"])
+        if row["status"] != "validated":
+            return _idempotency_state_response_or_error(
+                row,
+                request_id,
+                target_id,
+                dataset_epoch,
+            )
+        cursor = connection.execute(
+            """
+            UPDATE factura_requests
+            SET phase = 'commit', status = 'in_progress', error_text = NULL, updated_at = ?
+            WHERE request_id = ? AND payload_hash = ? AND status = 'validated'
+            """,
+            (now, request_id, payload_hash),
+        )
+        if cursor.rowcount != 1:
+            raise sqlite3.IntegrityError(
+                "idempotency claim did not update exactly one validated request"
+            )
+        connection.commit()
+    return None

+def parse_account_schema_by_company(
+    raw_mapping: str,
+    allowed_account_schemas: set[str],
+) -> dict[int, str]:
+    """Parse an explicit company-to-ledger allowlist and reject ambiguity."""
+
+    mapping: dict[int, str] = {}
+    for raw_entry in raw_mapping.split(","):
+        entry = raw_entry.strip()
+        if not entry:
+            continue
+        raw_company_id, separator, raw_schema = entry.partition(":")
+        schema = raw_schema.strip()
+        try:
+            company_id = int(raw_company_id.strip())
+        except ValueError as error:
+            raise RuntimeError(
+                f"invalid company id in DB_ACCOUNT_SCHEMA_BY_COMPANY: {entry}"
+            ) from error
+        if (
+            not separator
+            or company_id <= 0
+            or not schema
+            or schema not in allowed_account_schemas
+        ):
+            raise RuntimeError(
+                f"invalid DB_ACCOUNT_SCHEMA_BY_COMPANY entry: {entry}"
+            )
+        if company_id in mapping:
+            raise RuntimeError(
+                "duplicate company id in DB_ACCOUNT_SCHEMA_BY_COMPANY: "
+                f"{company_id}"
+            )
+        mapping[company_id] = schema
+    return mapping
+

+def build_write_response(
+    *,
+    contract_version: int,
+    request_id: str | None,
+    dry_run: bool,
+    factura: dict[str, Any] | None,
+    ctb: list[dict[str, Any]],
+    punteos: list[dict[str, Any]],
+    validation_errors: list[dict[str, Any]],
+    validation_warnings: list[str],
+    duplicate: dict[str, Any] | None = None,
+    readback_confirmed: bool = False,
+    punteos_requested: list[dict[str, Any]] | None = None,
+) -> dict[str, Any]:
+    header = factura or {}
+    accounting, accounting_warnings = accounting_state_from_header(header)
+    warnings = list(dict.fromkeys([*validation_warnings, *accounting_warnings]))
+    frr_id = positive_int(header.get("FRR_id"))
+    frr_numero = positive_int(header.get("FRR_numero"))
+    technical_id = positive_int(header.get("FRR_IdAsientoNet"))
+    legacy_technical_id = technical_id or 0
+    ok = not validation_errors and (dry_run or readback_confirmed)
+    return {
+        "ok": ok,
+        "contract_version": contract_version,
+        "request_id": request_id,
+        "dry_run": dry_run,
+        "would_create": not validation_errors,
+        "factura": factura,
+        "ctb": ctb,
+        "punteos": punteos,
+        "validations": {"errors": validation_errors, "warnings": warnings},
+        "accounting": accounting,
+        "duplicate": duplicate,
+        "readback_confirmed": readback_confirmed,
+        # Compatibilidad temporal con el contrato historico.
+        "FRR_id": frr_id,
+        "FRR_numero": frr_numero,
+        "FRR_IdAsientoNet": legacy_technical_id,
+        "ids_punteos_enlazados": punteos,
+        "punteos_requested": punteos_requested or [],
+        "validation_errors": validation_errors,
+        "erp_errors": [],
+    }

+def _collect_account_references(
+    cabecera: dict[str, Any],
+    ctb_rows: list[dict[str, Any]],
+) -> tuple[list[dict[str, Any]], dict[str, list[str]]]:
+    errors: list[dict[str, Any]] = []
+    requested: dict[str, list[str]] = {}
+
+    for position in range(1, 5):
+        account_field = f"FRR_ctagasto{position}"
+        amount_field = f"FRR_igasto{position}"
+        raw_account = cabecera.get(account_field)
+        raw_amount = cabecera.get(amount_field)
+        account = str(raw_account).strip() if raw_account not in (None, "") else ""
+        has_amount = _has_effective_amount(raw_amount)
+        if bool(account) != has_amount:
+            errors.append(
+                {
+                    "field": f"cabecera.{account_field if has_amount else amount_field}",
+                    "error": "expense account and amount must be provided together",
+                }
+            )
+        if account:
+            requested.setdefault(account, []).append(f"cabecera.{account_field}")
+
+    for account_field in ("FRR_idcuenta", "FRR_CtaCartera"):
+        raw_account = cabecera.get(account_field)
+        account = str(raw_account).strip() if raw_account not in (None, "") else ""
+        if account:
+            requested.setdefault(account, []).append(f"cabecera.{account_field}")
+
+    raw_supplement_account = cabecera.get("FRR_CtaSuplido")
+    raw_supplement_amount = cabecera.get("FRR_ImpSuplido")
+    supplement_account = (
+        str(raw_supplement_account).strip()
+        if raw_supplement_account not in (None, "")
+        else ""
+    )
+    has_supplement_amount = _has_effective_amount(raw_supplement_amount)
+    if bool(supplement_account) != has_supplement_amount:
+        errors.append(
+            {
+                "field": (
+                    "cabecera.FRR_CtaSuplido"
+                    if has_supplement_amount
+                    else "cabecera.FRR_ImpSuplido"
+                ),
+                "error": "supplement account and amount must be provided together",
+            }
+        )
+    if supplement_account:
+        requested.setdefault(supplement_account, []).append(
+            "cabecera.FRR_CtaSuplido"
+        )
+
+    for index, row in enumerate(ctb_rows):
+        raw_account = row.get("FRC_Cuenta")
+        raw_amount = row.get("FRC_Importe")
+        account = str(raw_account).strip() if raw_account not in (None, "") else ""
+        has_amount = raw_amount not in (None, "")
+        if bool(account) != has_amount:
+            errors.append(
+                {
+                    "field": (
+                        f"ctb[{index}].FRC_Cuenta"
+                        if has_amount
+                        else f"ctb[{index}].FRC_Importe"
+                    ),
+                    "error": "CTB account and amount must be provided together",
+                }
+            )
+        if account:
+            requested.setdefault(account, []).append(f"ctb[{index}].FRC_Cuenta")
+    return errors, requested
+
+
+def _account_reference_context(
+    cabecera: dict[str, Any],
+    ctb_rows: list[dict[str, Any]],
+) -> tuple[list[dict[str, Any]], dict[str, list[str]], str | None, str | None]:
+    errors, requested = _collect_account_references(cabecera, ctb_rows)
+
+    if not requested:
+        return errors, requested, None, None
+    account_schema_name = accounting_schema_for_company(cabecera.get("FRR_Idempresa"))
+    if account_schema_name is None:
+        errors.append(
+            {
+                "field": "cabecera.FRR_Idempresa",
+                "error": "company has no allowlisted accounting schema",
+            }
+        )
+        return errors, requested, None, None
+    selected_account_schema = quote_any_identifier(
+        account_schema_name,
+        DB_ALLOWED_ACCOUNT_SCHEMAS,
+        "account schema",
+    )
+    return errors, requested, account_schema_name, selected_account_schema
+
+
+def _missing_account_errors(
+    requested: dict[str, list[str]],
+    found: set[str],
+    account_schema_name: str,
+) -> list[dict[str, Any]]:
+    errors: list[dict[str, Any]] = []
+    for account, fields in requested.items():
+        if account not in found:
+            for field in fields:
+                errors.append(
+                    {
+                        "field": field,
+                        "error": (
+                            f"account does not exist in {account_schema_name}: {account}"
+                        ),
+                    }
+                )
+    return errors
+
+
+def validate_account_references(
+    cabecera: dict[str, Any],
+    ctb_rows: list[dict[str, Any]],
+    *,
+    fetch_all_fn: Callable[
+        [str, dict[str, Any] | None],
+        list[dict[str, Any]],
+    ] | None = None,
+) -> list[dict[str, Any]]:
+    (
+        errors,
+        requested,
+        account_schema_name,
+        selected_account_schema,
+    ) = _account_reference_context(cabecera, ctb_rows)
+    if not requested or account_schema_name is None or selected_account_schema is None:
+        return errors
+    params = {f"account_{index}": account for index, account in enumerate(requested)}
+    placeholders = ", ".join(f"%({key})s" for key in params)
+    selected_fetch_all = fetch_all_fn or fetch_all
+    rows = selected_fetch_all(
+        f"""
+        SELECT NumeroCuenta AS account
+        FROM {selected_account_schema}.cuentas
+        WHERE NumeroCuenta IN ({placeholders})
+        """,
+        params,
+    )
+    found = {str(row.get("account") or "").strip() for row in rows}
+    errors.extend(_missing_account_errors(requested, found, account_schema_name))
+    return errors
+
+
+def validate_account_references_in_transaction(
+    cursor: Any,
+    cabecera: dict[str, Any],
+    ctb_rows: list[dict[str, Any]],
+) -> list[dict[str, Any]]:
+    (
+        errors,
+        requested,
+        account_schema_name,
+        selected_account_schema,
+    ) = _account_reference_context(cabecera, ctb_rows)
+    if not requested or account_schema_name is None or selected_account_schema is None:
+        return errors
+    params = {f"account_{index}": account for index, account in enumerate(requested)}
+    placeholders = ", ".join(f"%({key})s" for key in params)
+    cursor.execute(
+        f"""
+        SELECT NumeroCuenta AS account
+        FROM {selected_account_schema}.cuentas
+        WHERE NumeroCuenta IN ({placeholders})
+        LOCK IN SHARE MODE
+        """,
+        params,
+    )
+    found = {
+        str(row.get("account") or "").strip()
+        for row in cursor.fetchall()
+    }
+    errors.extend(_missing_account_errors(requested, found, account_schema_name))
+    return errors
+
